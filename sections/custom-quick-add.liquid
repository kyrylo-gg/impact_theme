<style>
  #shopify-section-{{ section.id }} {
    position: fixed;
    bottom: 6px;
    z-index: 50;
    transition: opacity .3s ease, visibility .3s ease;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 10px;
    overflow: visible;
  }

  .custom-quick-add {
    background: #ffffff;
    border-radius: 10px;
    padding: 10px;
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    max-width: 610px;
    margin: auto;
    overflow: visible;
  }

  .custom-quick-add.show {
    display: flex;
  }

  .custom-quick-add.hidden {
    display: none !important;
  }

  .countdown-timer {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-direction: row;
  }

  #shopify-section-{{ section.id }} ts-timer.countdown-timer.timer-desktop {
    display: flex !important;
    overflow: visible !important;
  }

  .countdown-timer.timer-desktop {
    background: transparent !important;
    padding: 0;
    flex-shrink: 0;
    margin-top: 0;
  }

  .timer-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .time-value {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--countdown-background, linear-gradient(180deg, #313131 0%, #1C1C1C 100%));
    color: var(--countdown-color, #fff);
    font-size: 18px;
    font-weight: 600;
    border-radius: 5px;
    width: 33px;
    min-width: 33px;
    min-height: 33px;
    max-height: 33px;
    text-align: center;
    box-sizing: border-box;
  }

  .time-label {
    font-size: 13px;
    color:  var(--labels-color, #000);
    font-weight: 500;
  }

  .colon {
    font-size: 20px;
    font-weight: 700;
    margin: 0 2px;
  }

  .custom-quick-add-block {
    height: 60px;
    border-radius: 10px;
    display: flex;
    flex-direction: row;
    gap: 10px;
    justify-content: space-between;
    padding: 12px 18px;
    min-width: 376px;
  }

  .custom-quick-add-sublime {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .custom-quick-add-sublime-icon {
    width: 16px;
  }

  .custom-quick-add-sublime-text {
    font-weight: 600;
    font-size: 13px;
    line-height: 100%;
    color: #000000;
  }

  .price,
  .price-list,
  .custom-quick-add-main .price-list {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .price-item--regular {
    opacity: 0.5;
    text-decoration: line-through;
    font-size: 18px;
  }

  .price-item--sale {
    color: var(--block-text-color, #fff) !important;
    font-size: 22px;
    font-weight: 700;
  }

  .custom-quick-add-button {
    width: 81px;
    min-width: 81px;
    height: 30px;
    border-radius: 100px;
    padding-top: 4px;
    padding-right: 2px;
    padding-bottom: 4px;
    padding-left: 2px;
    gap: 10px;
    font-weight: 700;
    font-size: 13px;
    line-height: 100%;
    letter-spacing: 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    max-width: 90px;
  }

  .custom-quick-add-main {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 166px;
  }
  .full-width {
    width: 100%;
  }
  .timer-mobile {
    display: none;
  }
  .sublime-mobile {
    display: none;
  }
  .custom-quick-add-main .price-list .money,
  .custom-quick-add-main .price-list .text-subdued,
  .custom-quick-add-main .price-list .text-on-sale {
    color: #000000 !important;
    font-weight: 500;
    font-size: 13px;
    line-height: 100%;
  }

  .custom-quick-add-main .price-list .money {
    font-size: 15px;
  }

  .custom-quick-add-main .price, .price-list, .custom-quick-add-main .price-list {
    width: 100%;
  }
  .custom-quick-add-main .price-list .text-subdued {
    opacity: 0.7;
  }

  .removed {
    display: none;
  }

  .custom-quick-add-main .price-list {
    display: flex;
    flex-direction: row-reverse;
    color: var(--block-text-color, white) !important;
    min-width: 88px;
    justify-content: flex-end;
  }

  .custom-quick-add-sublime.sublime-desktop {
    max-width: 150px;
  }

  @media (max-width: 768px) {
    /* Секция — на всю ширину, прижата к низу без зазора */
    #shopify-section-{{ section.id }} {
      bottom: 0;
      left: 0;
      transform: none;
      width: 100%;
      border-radius: 10px 10px 0px 0px;
      max-width: 100%;
    }

    /* Контейнер — белый фон, flex column, правильные скругления */
    .custom-quick-add {
      display: flex !important;
      flex-direction: column;
      gap: 6px;
      background: #ffffff !important;
      padding: 10px 20px 14px;
      border-radius: 10px 10px 0px 0px;
    }

    /* Розовый блок — flex row, одна строка */
    .custom-quick-add-block {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      min-width: 0;
      width: 100%;
      height: 60px;
      border-radius: 10px;
      justify-content: space-between;
    }

    /* С таймером: три колонки — таймер | цена по центру | кнопка */
    .custom-quick-add-block--with-timer {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      justify-content: stretch;
      column-gap: 8px;
    }

    .custom-quick-add-block--with-timer .custom-quick-add-main {
      display: contents;
      flex: unset;
      min-width: 0;
    }

    .custom-quick-add-block--with-timer .custom-quick-add-main__price {
      justify-self: center;
      text-align: center;
      min-width: 0;
      max-width: 100%;
    }

    .custom-quick-add-block--with-timer .custom-quick-add-main .price,
    .custom-quick-add-block--with-timer .custom-quick-add-main .price-list {
      justify-content: center;
      flex-direction: row;
      width: auto;
      max-width: 100%;
    }

    .custom-quick-add-block--with-timer .custom-quick-add-button {
      justify-self: end;
    }

    .custom-quick-add-block--with-timer ts-timer.countdown-timer.timer-desktop {
      justify-self: start;
    }

    /* Таймер — слева в розовом блоке */
    .timer-desktop {
      display: flex !important;
      margin-top: 0;
      padding: 0;
      background: transparent !important;
      flex-shrink: 0;
      gap: 2px;
    }

    #shopify-section-{{ section.id }} ts-timer.countdown-timer.timer-desktop {
      display: flex !important;
      overflow: visible !important;
    }

    /* timer-mobile скрыт — используем только timer-desktop */
    .timer-mobile,
    .custom-quick-add-block .timer-mobile {
      display: none !important;
    }

    /* Ячейки таймера на мобильном */
    .time-value {
      font-size: 13px;
      width: 26px;
      min-width: 26px;
      min-height: 26px;
      max-height: 26px;
      border-radius: 5px;
      padding: 0 3px;
      color: var(--mobile-countdown-color, #fff);
      background: var(--mobile-countdown-background, linear-gradient(180deg, #313131 0%, #1C1C1C 100%));
    }

    .time-label {
      font-size: 9px;
      color: #000000;
    }

    .timer-desktop .time-label {
      color: #000000;
    }

    .timer-desktop .time-value {
      background: linear-gradient(180deg, #313131 0%, #1C1C1C 100%) !important;
      color: #fff !important;
    }

    .colon {
      font-size: 13px;
      padding-bottom: 12px;
      margin: 0 1px;
    }

    /* Цена и кнопка */
    .custom-quick-add-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      min-width: 0;
      flex: 1;
    }

    .custom-quick-add-main .price-list .money,
    .custom-quick-add-main .price-list .text-subdued,
    .custom-quick-add-main .price-list .text-on-sale {
      color: #000000 !important;
      font-weight: 500;
      font-size: 13px;
      line-height: 1.2;
    }

    .custom-quick-add-main .price-list .money {
      font-size: 13px;
    }

    .custom-quick-add-main .price-list {
      min-width: 0;
      gap: 4px;
    }

    /* Тема задаёт .price-list { align-items: baseline } — на мобильном это поднимает compare-at выше sale */
    #shopify-section-{{ section.id }} .custom-quick-add-main .price-list {
      align-items: center;
      flex-wrap: nowrap;
    }

    #shopify-section-{{ section.id }} .custom-quick-add-main .price-list sale-price,
    #shopify-section-{{ section.id }} .custom-quick-add-main .price-list compare-at-price {
      display: inline-flex;
      align-items: center;
      line-height: 1.2;
      margin: 0;
      vertical-align: middle;
    }

    #shopify-section-{{ section.id }} .custom-quick-add-main .price-list sale-price {
      position: relative;
      top: 2px;
    }

    #shopify-section-{{ section.id }} .custom-quick-add-main .price-list compare-at-price {
      position: relative;
      top: 1px;
    }

    .custom-quick-add-button {
      flex-shrink: 0;
      width: auto;
      height: auto;
      min-width: 70px;
      text-align: center;
      font-weight: 700;
      padding: 8px 16px;
    }

    .custom-quick-add-button:hover {
      opacity: 0.95;
    }

    /* Sublime — под розовым блоком, по центру */
    .sublime-mobile {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 0;
    }

    .custom-quick-add-sublime.sublime-mobile {
      margin-top: 0;
      color: black;
    }

    .sublime-mobile .custom-quick-add-sublime-text {
      color: black;
    }

    .custom-quick-add-sublime-icon {
      filter: invert(100%);
      width: 12px;
    }

    /* Десктопный sublime скрыт на мобильном */
    .sublime-desktop,
    .custom-quick-add-block .sublime-desktop {
      display: none;
    }
  }

  /* Очень маленькие экраны: 320–374px — уменьшаем чтобы влезло в одну строку */
  @media (max-width: 374px) {
    .custom-quick-add {
      padding: 8px 12px 10px;
      gap: 4px;
    }

    .custom-quick-add-block {
      gap: 4px;
      padding: 8px;
    }

    .time-value {
      width: 22px;
      min-width: 22px;
      min-height: 22px;
      max-height: 22px;
      font-size: 11px;
      padding: 0 2px;
    }

    .time-label {
      font-size: 8px;
    }

    .colon {
      font-size: 11px;
      padding-bottom: 10px;
      margin: 0;
    }

    .countdown-timer.timer-desktop {
      gap: 1px;
    }

    .custom-quick-add-button {
      font-size: 11px;
      min-width: 58px;
      padding: 4px 6px;
    }

    .custom-quick-add-main .price-list .money {
      font-size: 11px;
    }

    .custom-quick-add-main .price-list .text-subdued {
      font-size: 10px;
    }

    .custom-quick-add-main__savings {
      font-size: 8px;
      color: #000000 !important;
    }
  }
  .inverse {
    filter: invert(100%);
  }
</style>
<style>
  #shopify-section-{{ section.id }} {
      --countdown-background: {{ section.settings.countdown_background }};
      --countdown-color: {{ section.settings.countdown_color }};
      --labels-color: {{ section.settings.labels_color }};
      --block-text-color: {{ section.settings.block_text_color | default: '#ffffff' }};
      --sublime-text-color: {{ section.settings.sublime_text_color | default: '#ffffff' }};
  }
  @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} {
          --mobile-countdown-background: {{ section.settings.mobile_countdown_background }};
          --mobile-countdown-color: {{ section.settings.mobile_countdown_color }};
          --mobile-labels-color: {{ section.settings.mobile_labels_color }};
      }
  }

  .custom-quick-add-main__savings {
    display: flex;
    width: fit-content;
    padding: 2px 5px 1px;
    border: 1px solid {{ section.settings.background_button }};
    border-radius: 100px;
    font-weight: 700;
    font-size: 9px;
    line-height: 140%;
    color: #000000;
    margin: 3px auto 0;
  }

  @media (max-width: 768px) {
    .custom-quick-add-main__savings {
      color: #000000;
    }
  }
</style>

{% if section.settings.timer_enabled %}
  {% liquid
    assign timer_type = section.settings.timer_type
    assign timer_target = section.settings.cancel_date
    assign timer_action = section.settings.cancel_action

    if timer_type == 'cancel_time'
      assign timer_minutes = section.settings.cancel_minutes
      assign timer_hours = section.settings.cancel_time | times: 60
      assign timer_days = section.settings.cancel_days | times: 1440
      assign timer_minutes_total = timer_minutes | plus: timer_hours | plus: timer_days
      assign timer_target = timer_minutes_total | times: 60 | plus: section.settings.cancel_seconds
    endif
  %}
{% endif %}

{%- liquid
  assign is_hips_complete_system_anchor_template = false
  if template.name == 'product' and template.suffix == 'hips_a_ceo'
    assign is_hips_complete_system_anchor_template = true
  elsif template.name == 'product' and template.suffix == 'hips_a'
    assign is_hips_complete_system_anchor_template = true
  elsif template.name == 'product' and template.suffix == 'hips_b'
    assign is_hips_complete_system_anchor_template = true
  elsif template.name == 'product' and template.suffix == 'hips_c'
    assign is_hips_complete_system_anchor_template = true
  endif

  assign sticky_cta_href = section.settings.button_link
  if is_hips_complete_system_anchor_template
    assign sticky_cta_href = '#complete-system'
  endif
-%}

<div id="quick-add-sticky-{{ section.id }}" class="custom-quick-add">

  <div
    class="custom-quick-add-block{% if section.settings.timer_enabled %} custom-quick-add-block--with-timer{% endif %}"
    style="background:{{ section.settings.block_background }}"
  >
    {% if section.settings.timer_enabled %}
      <ts-timer
        data-timer="{{ timer_type }}"
        data-target="{{ timer_target }}"
        {% if timer_type == 'cancel_time' %}data-target-unit="seconds"{% endif %}
        data-action="{{ timer_action }}"
        data-section="{{ section.id }}"
        class="countdown-timer timer-desktop"
      >
        {% assign labels = 'Days,Hours,Mins,Secs' | split: ',' %}
        <div class="timer-block flex items-center">
          <span class="time-value" data-cell="days">00</span>
          <span class="time-label">{{ labels[0] }}</span>
        </div>
        <span class="colon">:</span>
        <div class="timer-block flex items-center">
          <span class="time-value" data-cell="hours">00</span>
          <span class="time-label">{{ labels[1] }}</span>
        </div>
        <span class="colon">:</span>
        <div class="timer-block flex items-center">
          <span class="time-value" data-cell="minutes">00</span>
          <span class="time-label">{{ labels[2] }}</span>
        </div>
        <span class="colon">:</span>
        <div class="timer-block flex items-center">
          <span class="time-value" data-cell="seconds">00</span>
          <span class="time-label">{{ labels[3] }}</span>
        </div>
      </ts-timer>
    {% endif %}

    {% if section.settings.sublime_text != blank and section.settings.timer_enabled %}
      <div class="custom-quick-add-sublime sublime-desktop">
        <img
          src="https://cdn.shopify.com/s/files/1/0276/5658/5290/files/Vector_1.svg?v=1764268945"
          width="10"
          height="12"
          class="custom-quick-add-sublime-icon hidden"
        >
        <span class="custom-quick-add-sublime-text">
          {{ section.settings.sublime_text }}
        </span>
      </div>
    {% endif %}

    {% unless section.settings.timer_enabled %}
      {% if section.settings.sublime_text != blank %}
        <div class="custom-quick-add-sublime sublime-desktop inverse">
          <img
            src="https://cdn.shopify.com/s/files/1/0276/5658/5290/files/Vector_1.svg?v=1764268945"
            width="10"
            height="12"
            class="custom-quick-add-sublime-icon hidden"
          >
          <span class="custom-quick-add-sublime-text">
            {{ section.settings.sublime_text }}
          </span>
        </div>
      {% endif %}
    {% endunless %}

    <div class="custom-quick-add-main {% if section.settings.timer_enabled == false %} full-width {% endif %}">
      <div class="custom-quick-add-main__price">
        {% assign current_variant = section.settings.product.selected_or_first_available_variant %}
        {%- render 'price-list',
          product: section.settings.product,
          variant: current_variant
        -%}

        {% if current_variant.compare_at_price > current_variant.price %}
          {% assign discount =
            current_variant.compare_at_price
            | minus: current_variant.price
            | times: 100
            | divided_by: current_variant.compare_at_price
          %}
          <p class="custom-quick-add-main__savings">{{ discount }}% OFF</p>
        {% endif %}
      </div>
      <a
        href="{{ sticky_cta_href }}"
        class="custom-quick-add-button"
        style="background:{{ section.settings.background_button }}; color:{{ section.settings.text_color_button }}"
      >
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>

  {% if section.settings.sublime_text != blank %}
    <div class="custom-quick-add-sublime sublime-mobile">
      <img
        src="https://cdn.shopify.com/s/files/1/0276/5658/5290/files/Vector_1.svg?v=1764268945"
        width="10"
        height="12"
        class="custom-quick-add-sublime-icon hidden"
      >
      <span class="custom-quick-add-sublime-text">
        {{ section.settings.sublime_text }}
      </span>
    </div>
  {% endif %}

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const original = document.getElementById('quick-add-original');
    const sticky = document.getElementById('quick-add-sticky-{{ section.id }}');
    const buyButtons = document.querySelector('.buy-buttons');
    const bundleBuilder = document.getElementById('nass-bundle-builder');
    const twerkOfferBlock = document.getElementById('nass-twerk-offer-block');
    const searchParams = new URLSearchParams(window.location.search);
    const isBodyTransformationPage = document.body.classList.contains('product--body_transformation');
    const isTwerkEssentialPage = document.body.classList.contains('product--twerk_essential');

    if (sticky) {
      sticky.classList.add('show');
    }

    if (searchParams.get("utm_source") && searchParams.get("utm_source") == "facebook") {
      sticky.classList.add("show");
    }

    if (!sticky) return;

    function updateStickyVisibility() {
      const hideOriginal = original && isElementInViewport(original, 0.1);
      const hideBuyButtons = !isBodyTransformationPage && buyButtons && isElementInViewport(buyButtons, 0.15);
      const hideBundleBuilder = bundleBuilder && isElementInViewport(bundleBuilder, 0.1);
      const hideTwerkOfferBlock = isTwerkEssentialPage && twerkOfferBlock && isElementInViewport(twerkOfferBlock, 0.1);
      const hide = hideOriginal || hideBuyButtons || hideBundleBuilder || hideTwerkOfferBlock;
      if (hide) {
        sticky.classList.add('hidden');
      } else {
        sticky.classList.remove('hidden');
      }
    }

    function isElementInViewport(el, threshold = 0) {
      const rect = el.getBoundingClientRect();
      const height = window.innerHeight || document.documentElement.clientHeight;
      return rect.top < height * (1 - threshold) && rect.bottom > height * threshold;
    }

    document.addEventListener('scroll', updateStickyVisibility, { passive: true });
    window.addEventListener('resize', updateStickyVisibility);
    updateStickyVisibility();
  });
</script>

{% schema %}
{
  "name": "TS Sticky Add",
  "tag": "section",
  "class": "section-custom-quick-add",
  "limit": 1,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product for prices"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "color",
      "id": "background_button",
      "label": "Button background",
      "default": "#FAFF00"
    },
    {
      "type": "color",
      "id": "text_color_button",
      "label": "Button text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Block text color"
    },
    {
      "type": "color",
      "id": "block_background",
      "label": "Block background color",
      "default": "#1a1a1a"
    },
    {
      "type": "richtext",
      "id": "sublime_text",
      "label": "Sublime text",
      "default": "<p>7-day money-back guarantee</p>"
    },
    {
      "type": "color",
      "id": "sublime_text_color",
      "label": "Sublime text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Timer logic - settings"
    },
    {
      "type": "checkbox",
      "id": "timer_enabled",
      "label": "Show timer",
      "default": true
    },
    {
      "type": "select",
      "id": "timer_type",
      "label": "Timer type",
      "options": [
        {
          "label": "Until date end",
          "value": "cancel_date"
        },
        {
          "label": "Until time end",
          "value": "cancel_time"
        },
        {
          "label": "Until day end (daily)",
          "value": "daily"
        }
      ],
      "default": "daily"
    },
    {
      "type": "text",
      "id": "cancel_date",
      "label": "Cancel date for countdown",
      "info": "Use next time format: dd-mm-yyyy hh:mm",
      "placeholder": "dd-mm-yyyy hh:mm",
      "default": "01-01-2026 12:00"
    },
    {
      "type": "range",
      "id": "cancel_days",
      "label": "Cancel time for countdown (days)",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 0
    },
    {
      "type": "range",
      "id": "cancel_time",
      "label": "Cancel time for countdown (hours)",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "h",
      "default": 0
    },
