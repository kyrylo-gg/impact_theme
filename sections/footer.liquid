{%- assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first -%}

{%- if section.blocks.size > 3 -%}
<style>
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if newsletter_block != blank -%}
        --footer-block-list-gap: var(--spacing-10);
      {%- endif -%}

      --footer-block-list-justify-content: space-between;
    }
  }
</style>
{%- endif -%}

 {% if template contains 'page.ty-booty'
        or template contains 'page.ty-twerk'
        or template contains 'page.ty-weight-loss' %}
  <style>
    .footer {
      background: #F0F0F0 !important;
      background-color: #F0F0F0 !important;
      border-radius: 30px 30px 0 0;
      padding-top: 110px;
    }
    .footer-logo {
      position: absolute;
      top: 32px;
      left: 32px;
    }
    .footer__aside-top, .footer__aside-bottom {
      justify-content: flex-end;
    }
    .footer__aside .social-media {
      display: none;
    }
    .footer__aside-bottom .footer__copyright {
      margin-right: auto;
    }
    .footer__aside-top .bold.text-sm {
      font-weight: 500;
      font-size: 18px;
      line-height: 100%;
    }
    @media screen and (max-width: 1000px) {
      .footer-logo {
        position: absolute;
        top: 20px;
        left: 20px;
      }
      .footer__aside-top, .footer__aside-bottom {
        justify-content: flex-start;
      }
    }
  </style>
{% endif %}

<div class="footer">
  {% if template contains 'page.ty-booty'
      or template contains 'page.ty-twerk'
      or template contains 'page.ty-weight-loss' %}
      <div class="footer-logo">
