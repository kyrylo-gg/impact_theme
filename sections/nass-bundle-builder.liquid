{%- comment -%}
  Nass Bundle Builder — Step 3 of N.
  Landing Card + Wizard + Products JSON API (no token), product selection, 60% off, add-to-cart.
{%- endcomment -%}

{% liquid
  assign show_section = section.settings.enable_section
%}

{%- if show_section -%}
<section
  id="shopify-section-{{ section.id }}"
  class="nass-bundle-builder"
  {{ section.shopify_attributes }}
>
  <div class="bb-section" id="nass-bundle-builder">
    <div class="bb-container">
      {%- comment -%} Heading block {%- endcomment -%}
      <div class="bb-heading">
        <span class="bb-badge-pill">Save up to 82%</span>
        <h2 class="bb-title">BUILD YOUR <span class="bb-title-accent">PERFECT BUNDLE!</span></h2>
        {% if section.settings.bb_description != blank %}
          <p class="bb-description">{{ section.settings.bb_description }}</p>
        {% endif %}
      </div>

      {%- comment -%} Landing Card {%- endcomment -%}
      <div class="bb-card">
        <div class="bb-card-top">
          <div class="bb-preview-images">
            {%- if section.settings.image_1 != blank -%}
              <div class="bb-preview-img">
                <img
                  class="bb-preview-img-el"
                  src="{{ section.settings.image_1 | image_url: width: 256 }}"
                  alt="{{ section.settings.image_1.alt | default: 'Bundle preview 1' | escape }}"
                  width="128"
                  height="128"
                  loading="lazy"
                >
              </div>
            {%- else -%}
              <div class="bb-preview-img">{{ 'image' | placeholder_svg_tag: 'bb-preview-img-el' }}</div>
            {%- endif -%}

            {%- if section.settings.image_2 != blank -%}
              <div class="bb-preview-img bb-preview-img--offset">
                <img
                  class="bb-preview-img-el"
                  src="{{ section.settings.image_2 | image_url: width: 256 }}"
                  alt="{{ section.settings.image_2.alt | default: 'Bundle preview 2' | escape }}"
                  width="128"
                  height="128"
                  loading="lazy"
                >
              </div>
            {%- else -%}
              <div class="bb-preview-img bb-preview-img--offset">{{ 'image' | placeholder_svg_tag: 'bb-preview-img-el' }}</div>
            {%- endif -%}

            {%- if section.settings.image_3 != blank -%}
              <div class="bb-preview-img">
                <img
                  class="bb-preview-img-el"
                  src="{{ section.settings.image_3 | image_url: width: 256 }}"
                  alt="{{ section.settings.image_3.alt | default: 'Bundle preview 3' | escape }}"
                  width="128"
                  height="128"
                  loading="lazy"
                >
              </div>
            {%- else -%}
              <div class="bb-preview-img">{{ 'image' | placeholder_svg_tag: 'bb-preview-img-el' }}</div>
            {%- endif -%}
          </div>

          <h3 class="bb-card-title">CUSTOM BUNDLE BUILDER</h3>
          <p class="bb-card-subtitle">Programs + Shorts + Leggings + Tops</p>

          {% if section.settings.bb_promo_banner_text != blank %}
            <div class="bb-promo-banner">
              {{ section.settings.bb_promo_banner_text }}
            </div>
          {% endif %}

          <div class="bb-cta-block">
            <span class="bb-shipping-badge">
              <svg class="bb-trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              Free shipping over $140
            </span>
            <button
            type="button"
            class="bb-cta"
            data-bb-cta
            aria-label="Start Building Your Bundle"
          >
            Start Building Your Bundle
          </button>
            {%- assign one_click_product = section.settings.one_click_product | default: section.settings.program_pack_product -%}
            {%- if section.settings.show_one_click_alternative and one_click_product != blank -%}
              {%- assign one_click_variant = one_click_product.selected_or_first_available_variant -%}
              {%- if one_click_variant -%}
                <div class="bb-cta-one-click">
                  <p class="bb-cta-one-click__text">OR {{ section.settings.one_click_label | default: 'Only Twerk program' }} for {{ one_click_variant.price | money }}</p>
                  <div class="bb-cta-one-click__row">
                    {%- if one_click_product.featured_image != blank -%}
                      <div class="bb-cta-one-click__thumb">
                        <img
                          src="{{ one_click_product.featured_image | image_url: width: 96 }}"
                          alt="{{ one_click_product.title | escape }}"
                          width="48"
                          height="48"
                          loading="lazy"
                        >
                      </div>
                    {%- endif -%}
                    <button type="button" class="bb-cta-one-click__btn" data-bb-one-click data-variant-id="{{ one_click_variant.id }}" aria-label="One-Click Purchase">
                      <span class="bb-cta-one-click__btn-text">One-Click Purchase</span>
                    </button>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="bb-trust-badges">
            <span class="bb-trust-item">
              <svg class="bb-trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Secure Checkout
            </span>
            <span class="bb-trust-item">
              <svg class="bb-trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              30-Day Guarantee
            </span>
            <span class="bb-trust-item">
              <svg class="bb-trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              Fast Shipping
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Wizard overlay {%- endcomment -%}
  <div
    id="bundle-builder-wizard-{{ section.id }}"
    class="bb-wizard-overlay bb-wizard-overlay--hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Bundle Builder"
    aria-hidden="true"
  >
    <div class="bb-wizard-backdrop" data-bb-close aria-label="Close"></div>
    <div class="bb-wizard-panel">
      <header class="bb-wizard-header" data-bb-wizard-header>
        <div class="bb-wizard-header-main">
          <div class="bb-wizard-progress" data-bb-progress>
            <div class="bb-wizard-progress-bar" data-bb-progress-bar role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax="6" aria-label="Step 1 of 6"></div>
            <p class="bb-wizard-progress-text" data-bb-step-text>Step 1 of 6</p>
          </div>
          <h3 class="bb-wizard-title" data-bb-wizard-title>Select programs</h3>
        </div>
        <button type="button" class="bb-wizard-close" data-bb-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </header>

      <div class="bb-wizard-discount" data-bb-wizard-discount>
        <span class="bb-wizard-discount-text">{{ section.settings.discount_promo_text | default: 'Get 60% off all clothing with 4 Programs Bundle!' | escape }}</span>
      </div>

      <div class="bb-wizard-content" data-bb-wizard-content>
        <p class="bb-wizard-placeholder" data-bb-wizard-placeholder>Step 1 of 6 — programs</p>
      </div>

      <footer class="bb-wizard-footer" data-bb-wizard-footer>
        <div class="bb-wizard-footer-total" data-bb-footer-total>
          <div class="bb-wizard-footer-total-left">
            <button type="button" class="bb-wizard-footer-expand" data-bb-footer-expand aria-label="Show details">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
            </button>
            <span class="bb-wizard-footer-total-label">Total</span>
          </div>
          <div class="bb-wizard-summary-compact bb-wizard-footer-total-right" data-bb-footer-compact></div>
        </div>
        <div class="bb-wizard-footer-buttons">
          <button type="button" class="bb-wizard-btn bb-wizard-btn--back" data-bb-back disabled>Back</button>
          <button type="button" class="bb-wizard-btn bb-wizard-btn--next" data-bb-next>Next</button>
        </div>
      </footer>
    </div>
    <div class="bb-exit-modal" data-bb-exit-modal role="dialog" aria-modal="true" aria-labelledby="bb-exit-modal-title">
      <div class="bb-exit-modal-backdrop"></div>
      <div class="bb-exit-modal-panel">
        <h3 id="bb-exit-modal-title" class="bb-exit-modal-title">Are you sure?</h3>
        <p class="bb-exit-modal-text">You will lose your cart progress. Confirm exit?</p>
        <div class="bb-exit-modal-buttons">
          <button type="button" class="bb-wizard-btn bb-wizard-btn--back" data-bb-exit-stay>Stay</button>
          <button type="button" class="bb-wizard-btn bb-wizard-btn--next" data-bb-exit-confirm>Exit</button>
        </div>
      </div>
    </div>

    {%- comment -%} Variant selection modal — per design guide & Figma {%- endcomment -%}
    <div class="bb-variant-modal bb-variant-modal--hidden" data-bb-variant-modal role="dialog" aria-modal="true" aria-label="Select variant">
      <div class="bb-variant-modal-backdrop" data-bb-variant-modal-close></div>
      <div class="bb-variant-modal-panel">
        <div class="bb-variant-modal-img-wrap" data-bb-variant-modal-img-wrap>
          <img class="bb-variant-modal-img" data-bb-variant-modal-img src="" alt="" width="400" height="500">
          <button type="button" class="bb-variant-modal-close" data-bb-variant-modal-close aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="bb-variant-modal-body">
          <h3 class="bb-variant-modal-title" data-bb-variant-modal-title></h3>
          <div class="bb-variant-modal-pills" data-bb-variant-modal-options></div>
          <button type="button" class="bb-variant-size-chart-link" data-bb-variant-modal-size-guide style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"/></svg>
            Size chart
          </button>
          <div class="bb-variant-modal-qty">
            <button type="button" class="bb-variant-qty-btn" data-bb-variant-qty-minus aria-label="Decrease">−</button>
            <span class="bb-variant-qty-value" data-bb-variant-qty-value>1</span>
            <button type="button" class="bb-variant-qty-btn" data-bb-variant-qty-plus aria-label="Increase">+</button>
          </div>
          <button type="button" class="bb-variant-modal-add" data-bb-variant-modal-add>Add to bundle <span aria-hidden="true">+</span></button>
        </div>
      </div>
    </div>

    {%- comment -%} Image Viewer modal — enlarged product image preview {%- endcomment -%}
    <div class="bb-image-viewer-modal bb-image-viewer-modal--hidden" data-bb-image-viewer role="dialog" aria-modal="true" aria-label="View image">
      <div class="bb-image-viewer-backdrop" data-bb-image-viewer-close aria-label="Close"></div>
      <div class="bb-image-viewer-panel">
        <button type="button" class="bb-image-viewer-close" data-bb-image-viewer-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <div class="bb-image-viewer-content">
          <div class="bb-image-viewer-img-wrap">
            <img class="bb-image-viewer-img" data-bb-image-viewer-img src="" alt="" width="400" height="500" loading="eager">
          </div>
          <div class="bb-image-viewer-nav bb-image-viewer-nav--prev" data-bb-image-viewer-prev aria-label="Previous image" style="display:none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          </div>
          <div class="bb-image-viewer-nav bb-image-viewer-nav--next" data-bb-image-viewer-next aria-label="Next image" style="display:none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </div>
          <div class="bb-image-viewer-dots" data-bb-image-viewer-dots style="display:none;"></div>
          <h3 class="bb-image-viewer-title" data-bb-image-viewer-title></h3>
        </div>
      </div>
    </div>

    {%- comment -%} Size Chart modal {%- endcomment -%}
    <div class="bb-size-chart-modal bb-size-chart-modal--hidden" data-bb-size-chart-modal role="dialog" aria-modal="true" aria-label="Find Your Size">
      <div class="bb-size-chart-backdrop" data-bb-size-chart-close aria-label="Close"></div>
      <div class="bb-size-chart-panel">
        <div class="bb-size-chart-header">
          <h3 class="bb-size-chart-title">FIND YOUR SIZE</h3>
          <button type="button" class="bb-size-chart-close" data-bb-size-chart-close aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="bb-size-chart-body">
          <div class="bb-size-chart-unit-toggle">
            <div class="bb-size-chart-unit-pills">
              <button type="button" class="bb-size-chart-unit-pill bb-size-chart-unit-pill--active" data-bb-sc-unit="in">IN</button>
              <button type="button" class="bb-size-chart-unit-pill" data-bb-sc-unit="cm">CM</button>
            </div>
          </div>
          <div class="bb-size-chart-calculator">
            <div class="bb-size-chart-tips" data-bb-sc-tips></div>
            <div class="bb-size-chart-inputs bb-size-chart-inputs--waist-hip" data-bb-sc-inputs>
              <div class="bb-size-chart-input-group"><label class="bb-size-chart-input-label">WAIST</label><input type="number" class="bb-size-chart-input" data-bb-sc-field="waist" min="0" step="0.1" /></div>
              <div class="bb-size-chart-input-group"><label class="bb-size-chart-input-label">HIP</label><input type="number" class="bb-size-chart-input" data-bb-sc-field="hip" min="0" step="0.1" /></div>
              <div class="bb-size-chart-input-group bb-size-chart-input-group--chest" style="display:none;"><label class="bb-size-chart-input-label">CHEST</label><input type="number" class="bb-size-chart-input" data-bb-sc-field="chest" min="0" step="0.1" /></div>
              <span class="bb-size-chart-unit-label" data-bb-sc-unit-display>IN</span>
            </div>
            <div class="bb-size-chart-calc-action">
              <button type="button" class="bb-size-chart-calc-btn" data-bb-sc-calculate disabled>CALCULATE</button>
            </div>
            <div class="bb-size-chart-result" data-bb-sc-result style="display:none;"></div>
          </div>
          <div class="bb-size-chart-table-wrap" data-bb-sc-table-wrap>
            <h4 class="bb-size-chart-table-heading">SIZE&nbsp;&amp;&nbsp;FIT in <span data-bb-sc-table-unit>INCH</span></h4>
            <div class="bb-size-chart-table-scroll">
              <table class="bb-size-chart-table" data-bb-sc-table></table>
            </div>
          </div>
          <div class="bb-size-chart-content" data-bb-sc-content style="display:none;"></div>
          <div class="bb-size-chart-loading" data-bb-sc-loading style="display:none;">Loading size chart...</div>
          <div class="bb-size-chart-empty" data-bb-sc-empty style="display:none;">Size chart not available</div>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<script src="{{ 'nass-bundle-builder.js' | asset_url }}" defer></script>
<script>
(function() {
  function run(retries) {
    retries = retries || 0;
    if (retries > 20) return;
    var sectionId = '{{ section.id }}';
    var sectionRoot = document.getElementById('shopify-section-' + sectionId);
    if (!sectionRoot) sectionRoot = document.querySelector('.nass-bundle-builder');
    if (!sectionRoot) return;
    if (!window.NassBundleBuilder || !window.NassBundleBuilder.init) {
      setTimeout(function() { run(retries + 1); }, 50);
      return;
    }
    window.NassBundleBuilder.init(sectionRoot, {
        sectionId: sectionId,
        shopDomain: '{{ shop.permanent_domain }}',
        cartAddUrl: '{{ routes.cart_add_url | append: ".js" }}',
        routesRoot: {{ routes.root_url | json }},
        steps: [
          {%- assign step_blocks = section.blocks | where: "type", "bundle_step" -%}
          {%- for block in step_blocks -%}
          {
            id: {{ block.id | json }},
            title: {{ block.settings.title | default: "Step" | json }},
            collectionHandle: {%- if block.settings.collection -%}{{ block.settings.collection.handle | json }}{%- else -%}""{%- endif -%},
            isProgramsStep: {{ block.settings.is_programs_step | json }},
            programPackProductId: {%- if block.settings.is_programs_step and block.settings.program_pack_product -%}{{ block.settings.program_pack_product.id | json }}{%- else -%}null{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%},
          { id: "review", title: "Review your bundle", collectionHandle: "", isProgramsStep: false }
        ],
        {%- comment -%} Program pack product ID: required for mutual exclusion on step 1 (Pack vs other programs). Set in section or in the programs-step block. {%- endcomment -%}
        programPackProductId: {%- assign pp_id = '' -%}{%- if section.settings.program_pack_product -%}{%- assign pp_id = section.settings.program_pack_product.id -%}{%- endif -%}{%- for b in step_blocks -%}{%- if b.settings.is_programs_step and b.settings.program_pack_product -%}{%- assign pp_id = b.settings.program_pack_product.id -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- if pp_id != blank -%}{{ pp_id | json }}{%- else -%}null{%- endif -%},
        discountCode: {{ section.settings.discount_code | json }},
        discountPromoText: {{ section.settings.discount_promo_text | default: 'Get 60% off all clothing with 4 Programs Bundle!' | json }},
        discountAppliedText: {{ section.settings.discount_applied_text | default: '60% off all clothing applied!' | json }},
        checkoutUrl: {{ routes.root_url | append: 'checkout' | json }},
        currency: {{ cart.currency | default: shop.currency | json }},
        shopCurrency: {{ shop.currency | json }},
        storefrontApiToken: {{ section.settings.storefront_api_token | json }},
        sizeChartConfigHandle: {{ section.settings.size_chart_config_handle | default: 'size-chart-settings' | json }},
        sizeChartByProduct: {
          {%- assign first_size_chart_item = true -%}
          {%- for block in step_blocks -%}
            {%- if block.settings.collection != blank -%}
              {%- for p in block.settings.collection.products -%}
                {%- liquid
                  assign has_no_calc_tag = false
                  for tag in p.tags
                    assign tag_downcase = tag | downcase
                    if tag_downcase == 'no_calc'
                      assign has_no_calc_tag = true
                      break
                    endif
                  endfor
                  assign size_chart_handle = ''
                  assign size_chart_html = ''
                  assign sc_ref = p.metafields.info.size_chart.value | default: p.metafields.info.size_chart
                  if sc_ref != blank
                    assign size_chart_handle = sc_ref.handle | default: sc_ref
                    assign normalized_handle = size_chart_handle | replace: '/pages/', '' | replace: 'https://', '' | replace: 'http://', ''
                    assign normalized_handle = normalized_handle | split: '/' | last
                    if pages[normalized_handle] != blank
                      assign size_chart_handle = normalized_handle
                      assign size_chart_html = pages[normalized_handle].content
                    endif
                  endif
                -%}
                {%- if first_size_chart_item -%}{%- assign first_size_chart_item = false -%}{%- else -%},{%- endif -%}
                {{ p.id | json }}: { "noCalc": {{ has_no_calc_tag | json }}, "handle": {{ size_chart_handle | json }}, "html": {{ size_chart_html | json }} }
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        }
      });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { run(0); });
  } else {
    run(0);
  }
})();
</script>

{% stylesheet %}
  /* ========================================
     Bundle Builder — Landing Card only
     Scoped via .nass-bundle-builder (section class)
     Breakpoint: 768px
     ======================================== */
  .nass-bundle-builder {
    --bb-primary: var(--nass-primary, #0038FF);
    --bb-highlight: #FAFF00;
    --bb-muted: #959595;
    --bb-success: #00FF38;
    --bb-error: #FF0000;
    --bb-border: hsl(0, 0%, 90%);
    --bb-radius: 20px;
    --bb-radius-lg: 30px;
    --bb-font-display: var(--font-heading--family, 'Anybody'), system-ui, sans-serif;
    --bb-font-body: var(--font-body--family, 'Avenir Next'), 'Avenir', 'Roboto', sans-serif;
  }

  .nass-bundle-builder .bb-section {
    padding: 48px 16px;
  }

  @media (min-width: 768px) {
    .nass-bundle-builder .bb-section {
      padding: 80px 16px;
    }
  }

  .nass-bundle-builder .bb-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .nass-bundle-builder .bb-heading {
    text-align: center;
    margin-bottom: 48px;
  }

  .nass-bundle-builder .bb-badge-pill {
    display: inline-flex;
    align-items: center;
    background: var(--bb-primary);
    color: #fff;
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
    font-family: var(--bb-font-body);
  }

  .nass-bundle-builder .bb-title {
    font-family: var(--bb-font-display);
    font-weight: 900;
    font-stretch: 150%;
    letter-spacing: 0.03em;
    line-height: 100%;
    text-transform: uppercase;
    margin: 0 0 12px;
    color: var(--color-foreground, #000);
    font-size: 30px;
  }

  @media (min-width: 768px) {
    .nass-bundle-builder .bb-title {
      font-size: 48px;
    }
  }

  .nass-bundle-builder .bb-title-accent {
    color: var(--bb-primary);
  }

  .nass-bundle-builder .bb-description {
    font-family: var(--bb-font-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--bb-muted);
    max-width: 560px;
    margin: 0 auto;
  }

  .nass-bundle-builder .bb-card {
    max-width: 768px;
    margin: 0 auto;
    border-radius: var(--bb-radius-lg);
    border: 1px solid var(--bb-border);
    overflow: hidden;
