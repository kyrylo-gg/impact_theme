            </svg>
          </span>
          <span class="text-sm text-subdued">{{ 'cart.general.money_back_guarantee' | t }}</span>
        </div>
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="cart-drawer__payment-icons v-stack gap-2 align-center">
            <div class="h-stack gap-2 wrap justify-center">
              {%- for type in shop.enabled_payment_types -%}
                {{- type | payment_type_svg_tag: class: 'cart-drawer__payment-icon' -}}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</cart-drawer>

<style>
  body.cart-drawer-open .needsclick.kl-teaser-QYMpAD.kl-private-reset-css-Xuajs1 {
    display: none !important;
  }

  .cart-drawer__banner {
    margin-top: 0.5rem;
    margin-inline: calc(-1 * var(--spacing-6));
    width: calc(100% + 2 * var(--spacing-6));
    padding: 0.5rem var(--spacing-6);
    background: linear-gradient(270deg, #FFD1FC 0%, #EBD7FF 100%);
    border-radius: 0;
    text-align: center;
  }
  @media screen and (min-width: 700px) {
    .cart-drawer__banner {
      margin-inline: calc(-1 * var(--spacing-10));
      width: calc(100% + 2 * var(--spacing-10));
      padding: 0.5rem var(--spacing-10);
    }
  }
  .cart-drawer__banner-link {
    display: block;
    text-decoration: none;
    font-weight: 600;
    color: var(--text-color, #1a1a1a);
  }
  .cart-drawer__banner-link:hover {
    text-decoration: underline;
  }
  .cart-drawer__banner-text {
    font-weight: 600;
    color: var(--text-color, #1a1a1a);
  }

  .cart-drawer__total-prices {
    flex-wrap: nowrap;
  }
  .cart-drawer__compare-at-total {
    font-weight: 400;
  }
  .cart-drawer__total-second-row {
    align-items: flex-start;
  }
  .cart-drawer__you-save {
    flex-wrap: nowrap;
  }
  .cart-drawer__taxes-shipping .cart-drawer__taxes-line1,
  .cart-drawer__taxes-shipping .cart-drawer__taxes-line2 {
    margin: 0;
  }
  .cart-drawer__savings-badge {
    display: inline-block;
    background: #F5D442;
    color: #1a1a1a;
    padding: 0.25em 0.6em;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .cart-drawer__checkout-btn {
    width: 100%;
  }
  .cart-drawer__checkout-btn-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .cart-drawer__secure-footer {
    margin-block-start: var(--spacing-1);
  }
  .cart-drawer__guarantee {
    flex-wrap: wrap;
  }
  .cart-drawer__guarantee-shield {
    display: inline-flex;
    width: 20px;
    height: auto;
    flex-shrink: 0;
    line-height: 0;
  }
  .cart-drawer__guarantee-shield svg {
    width: 100%;
    height: auto;
  }
  .cart-drawer__payment-icon {
    height: 24px;
    width: auto;
  }
  @media screen and (max-width: 699px) {
    .cart-drawer__payment-icons {
      gap: 0.25rem;
    }
    .cart-drawer__payment-icons .h-stack {
      gap: 0.25rem;
    }
    .cart-drawer__payment-icon {
      height: 12px;
      width: auto;
    }
  }

</style>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cart drawer won't appear to your customers if you have set the cart type to Page in the global theme settings."
    },
    {
      "type": "paragraph",
      "content": "Free shipping bar can be configured in global cart settings."
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show cart note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "Show shipping text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "Show view cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "Show checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Product recommendations"
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Heading",
      "default": "Trending this month"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Recommendations",
      "info": "Suggest additional products to your customers. Recommendations already in the cart are automatically hidden.",
      "limit": 10
    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background"
    },
    {
      "type": "color",
      "id": "product_card_text_color",
      "label": "Product card text"
    }
  ]
}
{% endschema %}