<section class="why-stiff" id="why-stiff-{{ section.id }}">
  <div class="why-stiff__container">
    <header class="why-stiff__header">
      <p class="why-stiff__intro">{{ section.settings.intro | escape }}</p>
      <h2 class="why-stiff__heading">
        <span class="why-stiff__heading-part">{{ section.settings.heading_part1 | escape }}</span>
        <span class="why-stiff__heading-accent">{{ section.settings.heading_part2 | escape }}</span>
      </h2>
    </header>

    <div class="why-stiff__visual">
      <div class="why-stiff__cream"></div>

      <div class="why-stiff__cards">
        <article class="why-stiff__card">
          {% if section.settings.image_left != blank %}
            {{
              section.settings.image_left
              | image_url: width: 900
              | image_tag:
                class: 'why-stiff__image',
                loading: 'lazy',
                alt: section.settings.label_left
            }}
          {% endif %}
          <div class="why-stiff__card-gradient" aria-hidden="true"></div>
          <span class="why-stiff__pill">{{ section.settings.label_left | escape }}</span>
        </article>

        <article class="why-stiff__card">
          {% if section.settings.image_right != blank %}
            {{
              section.settings.image_right
              | image_url: width: 900
              | image_tag:
                class: 'why-stiff__image',
                loading: 'lazy',
                alt: section.settings.label_right
            }}
          {% endif %}
          <div class="why-stiff__card-gradient" aria-hidden="true"></div>
          <span class="why-stiff__pill">{{ section.settings.label_right | escape }}</span>
        </article>
      </div>

      <div class="why-stiff__body">
        <div class="why-stiff__body-main rte">{{ section.settings.body_main }}</div>
        <div class="why-stiff__body-bold rte">{{ section.settings.body_bold }}</div>
      </div>
    </div>

    <p class="why-stiff__footnote">{{ section.settings.footnote | escape }}</p>
  </div>
</section>

{% stylesheet %}
  .why-stiff {
    padding: 40px 16px;
  }

  .why-stiff__container {
    max-width: 1184px;
    margin: 0 auto;
  }

  .why-stiff__header {
    text-align: center;
    margin-bottom: 18px;
  }

  .why-stiff__intro {
    margin: 0;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(16px, 2.6vw, 24px);
    font-weight: 800;
    line-height: 1.2;
    color: #000;
  }

  .why-stiff__heading {
    margin: 10px 0 0;
    text-transform: uppercase;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-size: clamp(24px, 4.2vw, 40px);
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .why-stiff__heading-part,
  .why-stiff__heading-accent {
    display: block;
  }

  .why-stiff__heading-part {
    color: #000;
    font-weight: 600;
  }

  .why-stiff__heading-accent {
    color: #0038ff;
    font-weight: 900;
  }

  .why-stiff__visual {
    position: relative;
  }

  .why-stiff__cream {
    position: absolute;
    top: 35%;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(249, 234, 218, 0.5);
    border-radius: 30px;
  }

  .why-stiff__cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .why-stiff__card {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    aspect-ratio: 164 / 226;
    background: #000;
  }

  .why-stiff__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .why-stiff__card-gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0));
  }

  .why-stiff__pill {
    position: absolute;
    left: 12px;
    bottom: 12px;
    border-radius: 999px;
    background: #faff00;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(12px, 1.7vw, 18px);
    font-weight: 800;
    line-height: 1.2;
    padding: 6px 12px;
  }

  .why-stiff__body {
    position: relative;
    margin-top: 16px;
    text-align: center;
    padding: 10px 16px 20px;
  }

  .why-stiff__body-main,
  .why-stiff__body-bold {
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(16px, 2.2vw, 21px);
    line-height: 1.3;
    color: #000;
  }

  .why-stiff__body-main {
    font-weight: 500;
  }

  .why-stiff__body-bold {
    font-weight: 800;
    margin-top: 8px;
  }

  .why-stiff__body-main p,
  .why-stiff__body-bold p {
    margin: 0;
  }

  .why-stiff__footnote {
    margin: 20px 0 0;
    text-align: center;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(14px, 1.8vw, 18px);
    line-height: 1.25;
    color: #666;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .why-stiff {
      padding: 64px 32px;
    }

    .why-stiff__header {
      margin-bottom: 26px;
    }

    .why-stiff__heading-part,
    .why-stiff__heading-accent {
      display: inline;
    }

    .why-stiff__cards {
      gap: 20px;
      padding: 0 17%;
    }

    .why-stiff__card {
      aspect-ratio: 381 / 520;
    }

    .why-stiff__pill {
      left: 18px;
      bottom: 18px;
      padding: 8px 14px;
    }

    .why-stiff__body {
      max-width: 930px;
      margin: 22px auto 0;
      padding: 12px 26px 26px;
    }

    .why-stiff__footnote {
      margin-top: 30px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Stiff",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Intro line",
      "default": "Your hips are not stiff because you are inflexible"
    },
    {
      "type": "text",
      "id": "heading_part1",
      "label": "Heading first part",
      "default": "They are stiff"
    },
    {
      "type": "text",
      "id": "heading_part2",
      "label": "Heading accent part",
      "default": "because you sit"
    },
    { "type": "image_picker", "id": "image_left", "label": "Left card image" },
    {
      "type": "text",
      "id": "label_left",
      "label": "Left card label",
      "default": "Locked hips"
    },
    { "type": "image_picker", "id": "image_right", "label": "Right card image" },
    {
      "type": "text",
      "id": "label_right",
      "label": "Right card label",
      "default": "Open hips"
    },
    {
      "type": "richtext",
      "id": "body_main",
      "label": "Body main copy",
      "default": "<p>Eight hours a day in a chair compresses your hips and trains your body to stay locked. Stretching helps for a day.</p>"
    },
    {
      "type": "richtext",
      "id": "body_bold",
      "label": "Body emphasized line",
      "default": "<p>Progressive movement changes the signal permanently.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "That is exactly what this program is built to do."
    }
  ],
  "presets": [{ "name": "Why Stiff" }]
}
{% endschema %}
