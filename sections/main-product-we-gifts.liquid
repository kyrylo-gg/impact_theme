                    <path d="M10.5622 9.04497C9.59327 9.28588 8.84371 10.0396 8.60595 11.0112C8.54388 11.2647 8.69906 11.5214 8.95312 11.5835C8.99046 11.5929 9.02886 11.5972 9.06621 11.5972C9.27872 11.5972 9.47229 11.4525 9.52541 11.2358C9.6769 10.6167 10.1735 10.117 10.791 9.9639C11.044 9.90078 11.1986 9.64409 11.1355 9.39003C11.0729 9.13649 10.8157 8.98342 10.5622 9.04497Z" fill="#111952"/>
