{% comment %}
  Student Progress — Lovable spec: "See How Our Students Perform"
  Horizontal scroll of student video cards. Pure Liquid + CSS + vanilla JS.
{% endcomment %}

{% assign is_twerk_essential_template = false %}
{% if request.page_type == 'product' and template.suffix == 'twerk_essential' %}
  {% assign is_twerk_essential_template = true %}
{% endif %}

<section class="student-progress{% if is_twerk_essential_template %} student-progress--twerk-essential{% endif %}" id="student-progress-{{ section.id }}">
  <div class="student-progress__container">
    {% unless section.settings.hide_heading %}
      <div class="student-progress__header">
        <div class="student-progress__title">
          {{ section.settings.heading | default: "SEE HOW OUR" | escape }}
          <span class="student-progress__title-highlight">{{ section.settings.heading_highlight | default: "STUDENTS PERFORM" | escape }}</span>
        </div>
        <div class="student-progress__divider"></div>
      </div>
    {% endunless %}

    <div class="student-progress__scroll-wrapper">
      <div class="student-progress__row">
        {% for block in section.blocks %}
          {% if block.type == 'student_video' %}
            {% assign local_video = block.settings.video %}
            {% assign local_video_mp4 = blank %}
            {% assign local_video_webm = blank %}
            {% if local_video != blank and local_video.sources != blank %}
              {% for source in local_video.sources %}
                {% if source.mime_type == 'video/mp4' and local_video_mp4 == blank %}
                  {% assign local_video_mp4 = source.url %}
                {% endif %}
                {% if source.mime_type == 'video/webm' and local_video_webm == blank %}
                  {% assign local_video_webm = source.url %}
                {% endif %}
              {% endfor %}
              {% if local_video_mp4 == blank %}
                {% assign local_video_mp4 = local_video.sources[0].url %}
              {% endif %}
            {% endif %}

            <div
              class="student-progress__card"
              {{ block.shopify_attributes }}
              {% if is_twerk_essential_template and local_video_mp4 != blank %}data-video-mp4="{{ local_video_mp4 | escape }}"{% endif %}
              {% if is_twerk_essential_template and local_video_webm != blank %}data-video-webm="{{ local_video_webm | escape }}"{% endif %}
            >
              {% if is_twerk_essential_template %}
                <button class="student-progress__trigger" type="button" aria-label="Play student progress video">
                  <div class="student-progress__media">
                    {% if local_video != blank and local_video.preview_image != blank %}
                      <img
                        class="student-progress__image"
                        src="{{ local_video.preview_image | image_url: width: 600 }}"
                        srcset="
                          {{ local_video.preview_image | image_url: width: 240 }} 240w,
                          {{ local_video.preview_image | image_url: width: 360 }} 360w,
                          {{ local_video.preview_image | image_url: width: 480 }} 480w,
                          {{ local_video.preview_image | image_url: width: 600 }} 600w
                        "
                        sizes="(max-width: 767px) 30vw, 30vw"
                        loading="lazy"
                        width="{{ local_video.preview_image.width }}"
                        height="{{ local_video.preview_image.height }}"
                        alt="Student progress video preview"
                      >
                    {% else %}
                      <div class="student-progress__placeholder">
                        {{ 'image' | placeholder_svg_tag: 'student-progress__placeholder-svg' }}
                      </div>
                    {% endif %}
                    <span class="student-progress__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                    </span>
                  </div>
                </button>
              {% else %}
                {% if block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'student-progress__video',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      preload: 'none',
                      image_size: '800x'
                  }}
                {% else %}
                  <div class="student-progress__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'student-progress__placeholder-svg' }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% render 'pop-booty-cta-trust', section: section %}
  </div>

  {% if is_twerk_essential_template %}
    <div class="student-progress__modal" id="student-progress-modal-{{ section.id }}" aria-hidden="true">
      <button class="student-progress__modal-backdrop" type="button" aria-label="Close video modal"></button>
      <div class="student-progress__modal-dialog" role="dialog" aria-modal="true" aria-label="Student progress video" tabindex="-1">
        <button class="student-progress__modal-close" type="button" aria-label="Close" data-close>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6 6 18" />
            <path d="M6 6l12 12" />
          </svg>
        </button>
        <div class="student-progress__modal-player">
          <div class="student-progress__player-host" data-player-host></div>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% unless is_twerk_essential_template %}
  <script src="{{ 'student-progress-video-lazy.js' | asset_url }}" defer></script>
{% endunless %}
{% if is_twerk_essential_template %}
  <script>
    (function () {
      var sectionEl = document.getElementById('student-progress-{{ section.id }}');
      if (!sectionEl) return;

      var modalEl = sectionEl.querySelector('#student-progress-modal-{{ section.id }}');
      var dialogEl = modalEl && modalEl.querySelector('.student-progress__modal-dialog');
      var playerHost = modalEl && modalEl.querySelector('[data-player-host]');
      var closeBtn = modalEl && modalEl.querySelector('[data-close]');
      var backdrop = modalEl && modalEl.querySelector('.student-progress__modal-backdrop');
      if (!modalEl || !dialogEl || !playerHost || !closeBtn || !backdrop) return;

      var activeEl = null;
      var currentVideo = null;

      function clearPlayer() {
        if (currentVideo) {
          try { currentVideo.pause(); } catch (e) {}
        }
        playerHost.innerHTML = '';
        currentVideo = null;
      }

      function createVideo(mp4Url, webmUrl) {
        var video = document.createElement('video');
        video.className = 'student-progress__player';
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.muted = false;

        if (webmUrl) {
          var webmSource = document.createElement('source');
          webmSource.src = webmUrl;
          webmSource.type = 'video/webm';
          video.appendChild(webmSource);
        }
        if (mp4Url) {
          var mp4Source = document.createElement('source');
          mp4Source.src = mp4Url;
          mp4Source.type = 'video/mp4';
          video.appendChild(mp4Source);
        }
        return video;
      }

      function openModal(cardEl) {
        if (!cardEl) return;
        var mp4Url = cardEl.dataset.videoMp4;
        var webmUrl = cardEl.dataset.videoWebm;
        if (!mp4Url && !webmUrl) return;

        activeEl = document.activeElement;
        clearPlayer();

        currentVideo = createVideo(mp4Url, webmUrl);
        playerHost.appendChild(currentVideo);
        try { currentVideo.play(); } catch (e) {}

        modalEl.classList.add('is-open');
        modalEl.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        dialogEl.focus();
      }

      function closeModal() {
        modalEl.classList.remove('is-open');
        modalEl.setAttribute('aria-hidden', 'true');
        clearPlayer();
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        if (activeEl && typeof activeEl.focus === 'function') activeEl.focus();
      }

      sectionEl.addEventListener('click', function (event) {
        var trigger = event.target.closest('.student-progress__trigger');
        if (!trigger) return;
        event.preventDefault();
        openModal(trigger.closest('.student-progress__card'));
      });

      closeBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);

      document.addEventListener('keydown', function (event) {
        if (!modalEl.classList.contains('is-open')) return;
        if (event.key === 'Escape' || event.key === 'Esc') closeModal();
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .student-progress {
    --sp-primary: var(--nass-primary, hsl(224, 100%, 50%));
    --sp-background: var(--color-background, hsl(0, 0%, 100%));
    --sp-foreground: #000;
    --sp-card-bg: var(--color-card, hsl(0, 0%, 96%));
    --sp-border: hsl(0, 0%, 90%);
    --sp-font-display: var(--font-heading--family, 'Anybody'), system-ui, sans-serif;
  }

  .student-progress {
    padding: 80px 0;
    background-color: var(--sp-background);
    border-radius: 24px;
    overflow: hidden;
  }

  .student-progress__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 1;
  }

  .student-progress__header {
    text-align: center;
    margin-bottom: 64px;
  }

  @media (max-width: 767px) {
    .student-progress {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .student-progress__header {
      margin-bottom: 32px;
    }
    .student-progress__row {
      padding-bottom: 8px;
    }
  }

  .student-progress__title {
    font-family: var(--sp-font-display);
    font-weight: 900;
    font-stretch: 150%;
    letter-spacing: 0.03em;
    line-height: 100%;
    text-transform: uppercase;
    color: var(--sp-foreground);
    margin: 0;
    padding: 0 8px;
    font-size: 30px;
  }

  .student-progress__title-highlight {
    color: var(--sp-primary);
  }

  @media (min-width: 768px) {
    .student-progress__title {
      font-size: 48px;
    }
  }

  .student-progress__divider {
    width: 96px;
    height: 4px;
    background-color: var(--sp-primary);
    margin: 16px auto 0;
  }

  .student-progress__scroll-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 -16px;
    padding: 0 16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .student-progress__scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .student-progress__row {
    display: flex;
    gap: 16px;
    padding-bottom: 16px;
    width: max-content;
  }

  .student-progress__card {
    position: relative;
    background-color: var(--sp-card-bg);
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid var(--sp-border);
    width: 280px;
    flex-shrink: 0;
  }

  .student-progress__video {
    width: 100%;
    height: auto;
    border-radius: 20px;
    display: block;
  }

  .student-progress__trigger {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    display: block;
  }

  .student-progress__media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: #ececec;
  }

  .student-progress__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .student-progress__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    pointer-events: none;
  }

  .student-progress__placeholder {
    width: 100%;
    aspect-ratio: 9 / 16;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: hsl(0, 0%, 10%);
    border-radius: 20px;
  }

  .student-progress__placeholder-svg {
    width: 40%;
    height: auto;
    opacity: 0.3;
  }

  @media (min-width: 768px) {
    .student-progress__title {
      font-size: 48px;
    }

    .student-progress__card {
      width: 320px;
    }
  }

  @media (min-width: 990px) {
    .student-progress__row {
      gap: 24px;
    }

    .student-progress__card {
      width: 360px;
    }
  }

  @media (min-width: 1200px) {
    .student-progress__card {
      width: 400px;
    }
  }

  .student-progress--dark,
  [data-theme="dark"] .student-progress {
    --sp-background: hsl(0, 0%, 0%);
    --sp-foreground: hsl(0, 0%, 100%);
    --sp-card-bg: hsl(0, 0%, 6%);
    --sp-border: hsl(0, 0%, 20%);
  }

  .student-progress--twerk-essential .student-progress__scroll-wrapper {
    overflow: visible;
    margin: 0;
    padding: 0;
  }

  .student-progress--twerk-essential .student-progress__row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding-bottom: 0;
  }

  .student-progress--twerk-essential .student-progress__card {
    width: auto;
    border-radius: 8px;
    border: 0;
    background: transparent;
  }

  .student-progress--twerk-essential .student-progress__media,
  .student-progress--twerk-essential .student-progress__placeholder {
    border-radius: 8px;
  }

  @media (min-width: 768px) {
    .student-progress--twerk-essential .student-progress__media {
      aspect-ratio: auto;
      background: transparent;
    }

    .student-progress--twerk-essential .student-progress__image {
      height: auto;
      object-fit: contain;
      background: transparent;
    }
  }

  .student-progress__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .student-progress__modal.is-open {
    display: flex;
  }

  .student-progress__modal-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.45);
    cursor: pointer;
  }

  .student-progress__modal-dialog {
    position: relative;
    z-index: 1;
    width: min(420px, 92vw);
    padding: 14px;
    border-radius: 18px;
    background: transparent;
    outline: none;
  }

  .student-progress__modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .student-progress__modal-player {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: transparent;
  }

  .student-progress__player-host {
    width: 100%;
    height: 100%;
  }

  .student-progress__player {
    width: 100%;
    height: auto;
    max-height: 85vh;
    display: block;
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Student Progress",
  "class": "student-progress-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEE HOW OUR"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted word(s)",
      "default": "STUDENTS PERFORM"
    },
    {
      "type": "checkbox",
      "id": "hide_heading",
      "label": "Hide heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Pop Booty footer"
    },
    {
      "type": "checkbox",
      "id": "show_pop_booty_footer",
      "label": "Show CTA & trust badges on pop_booty",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Booty Programs"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1",
      "default": "30-Day Money-Back Guarantee"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2",
      "default": "World-Famous support"
    }
  ],
  "blocks": [
    {
      "type": "student_video",
      "name": "Student Video",
      "limit": 8,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Student Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Student Progress",
      "blocks": [
        { "type": "student_video" },
        { "type": "student_video" },
        { "type": "student_video" }
      ]
    }
  ]
}
{% endschema %}
