{% liquid
  assign cta_opens_bundle_builder = false
  if request.page_type == 'product' and template.suffix == 'pop_booty'
    assign cta_opens_bundle_builder = true
  endif
%}

<section
  class="section-booty-workouts booty-workouts"
  id="booty-workouts-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --booty-workouts-image-radius: {{ section.settings.image_radius }}px;
  "
>
  <style>
    #shopify-section-{{ section.id }} .booty-workouts__bars {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      width: 100%;
      margin-top: 14px;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .booty-workouts__bars[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .booty-workouts__bar {
      display: block;
      width: 32px;
      height: 5px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #dfdfdf;
      cursor: pointer;
      transition: width 200ms ease, background-color 200ms ease;
    }

    #shopify-section-{{ section.id }} .booty-workouts__bar--active {
      width: 48px;
      background: #333;
    }

    #shopify-section-{{ section.id }} .booty-workouts__head {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating {
      display: block;
      color: #666;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-label,
    #shopify-section-{{ section.id }} .booty-workouts__rating-score,
    #shopify-section-{{ section.id }} .booty-workouts__rating-subline {
      color: #666;
      font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
      font-size: 14px;
      line-height: 1.35;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-subline {
      display: block;
      margin-top: 4px;
    }

    #shopify-section-{{ section.id }} .booty-workouts__stars {
      color: #f5b301;
      letter-spacing: 0.06em;
      font-size: 14px;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      margin-top: 12px;
      text-align: left;
      text-transform: uppercase;
      font-family: 'Anybody', sans-serif;
      font-stretch: 150%;
      letter-spacing: 0.03em;
      line-height: 1.05;
      font-size: clamp(1.75rem, 8vw, 2.8125rem);
      font-weight: 700;
      color: #000;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line {
      display: block;
      color: #000;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line--accent {
      font-weight: 900;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line + .booty-workouts__title-line {
      margin-top: 0;
    }

    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .booty-workouts__title {
        font-size: 35px;
      }
    }
  </style>
  <div class="booty-workouts__container">
    <div class="booty-workouts__grid">
      <div class="booty-workouts__media" data-booty-workouts-gallery>
        {%- liquid
          assign gallery_slides = 0
          assign gallery_source = 'placeholder'

          for block in section.blocks
            if block.type == 'gallery_image' and block.settings.image != blank
              assign gallery_slides = gallery_slides | plus: 1
            endif
          endfor

          if gallery_slides > 0
            assign gallery_source = 'blocks'
          elsif product != blank and product.media.size > 0
            unless section.settings.gallery_use_product_media == false
              assign gallery_slides = product.media.size
              assign gallery_source = 'product'
            endunless
          endif

          if gallery_source == 'placeholder'
            if section.settings.hero_image != blank
              assign gallery_slides = 1
              assign gallery_source = 'hero'
            else
              assign gallery_slides = 1
            endif
          endif
        -%}

        <div class="booty-workouts__image-wrap">
          {% case gallery_source %}
            {% when 'blocks' %}
              {% assign first_gallery_slide = true %}
              {% for block in section.blocks %}
                {% if block.type == 'gallery_image' and block.settings.image != blank %}
                  <div
                    class="booty-workouts__slide{% if first_gallery_slide %} is-active{% endif %}"
                    data-booty-workouts-slide
                    {{ block.shopify_attributes }}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'booty-workouts__image',
                        loading: 'lazy',
                        widths: '335,582,900,1200',
                        sizes: '(min-width: 768px) 582px, 100vw',
                        alt: block.settings.alt
                    }}
                  </div>
                  {% assign first_gallery_slide = false %}
                {% endif %}
              {% endfor %}
            {% when 'product' %}
              {% for media in product.media %}
                <div
                  class="booty-workouts__slide{% if forloop.first %} is-active{% endif %}"
                  data-booty-workouts-slide
                >
                  {% if media.media_type == 'image' %}
                    {{
                      media
                      | image_url: width: 1200
                      | image_tag:
                        class: 'booty-workouts__image',
                        loading: 'lazy',
                        widths: '335,582,900,1200',
                        sizes: '(min-width: 768px) 582px, 100vw',
                        alt: media.alt
                    }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'booty-workouts__image',
                        loading: 'lazy',
                        widths: '335,582,900,1200',
                        sizes: '(min-width: 768px) 582px, 100vw',
                        alt: media.alt
                    }}
                  {% endif %}
                </div>
              {% endfor %}
            {% when 'hero' %}
              <div class="booty-workouts__slide is-active" data-booty-workouts-slide>
                {{
                  section.settings.hero_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'booty-workouts__image',
                    loading: 'lazy',
                    widths: '335,582,900,1200',
                    sizes: '(min-width: 768px) 582px, 100vw'
                }}
              </div>
            {% else %}
              <div class="booty-workouts__slide is-active" data-booty-workouts-slide>
                {{ 'product-1' | placeholder_svg_tag: 'booty-workouts__image booty-workouts__image--placeholder' }}
              </div>
          {% endcase %}
        </div>

        <div
          class="booty-workouts__bars"
          data-booty-workouts-bars
          role="tablist"
          aria-label="Product gallery"
          {% unless gallery_slides > 1 %}hidden{% endunless %}
        >
          {% if gallery_source == 'blocks' %}
            {% assign bar_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_image' and block.settings.image != blank %}
                <button
                  type="button"
                  class="booty-workouts__bar{% if bar_index == 0 %} booty-workouts__bar--active{% endif %}"
                  data-booty-workouts-bar
                  data-slide-index="{{ bar_index }}"
                  role="tab"
                  aria-selected="{% if bar_index == 0 %}true{% else %}false{% endif %}"
                  aria-label="Slide {{ bar_index | plus: 1 }}"
                ></button>
                {% assign bar_index = bar_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% elsif gallery_source == 'product' %}
            {% for media in product.media %}
              <button
                type="button"
                class="booty-workouts__bar{% if forloop.first %} booty-workouts__bar--active{% endif %}"
                data-booty-workouts-bar
                data-slide-index="{{ forloop.index0 }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Slide {{ forloop.index }}"
              ></button>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <div class="booty-workouts__details">
        <div class="booty-workouts__head">
          {% if section.settings.rating_value != blank %}
            {%- liquid
              assign rating_score = section.settings.rating_value
              assign rating_subline = ''
              if section.settings.rating_value contains ' by '
                assign rating_split = section.settings.rating_value | split: ' by '
                assign rating_score = rating_split[0] | strip
                assign rating_subline = 'by ' | append: rating_split[1] | strip
              endif
            -%}
            <div class="booty-workouts__rating">
              <div class="booty-workouts__rating-row">
                {% if section.settings.rating_label != blank %}
                  <span class="booty-workouts__rating-label">{{ section.settings.rating_label | escape }}</span>
                {% endif %}
                <span class="booty-workouts__stars" aria-hidden="true">★★★★★</span>
                <span class="booty-workouts__rating-score">{{ rating_score | escape }}</span>
              </div>
              {% if rating_subline != blank %}
                <span class="booty-workouts__rating-subline">{{ rating_subline | escape }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.title_part_1 != blank or section.settings.title_part_2 != blank or section.settings.title_part_3 != blank %}
            <div class="booty-workouts__title">
              {% if section.settings.title_part_1 != blank %}
                <span class="booty-workouts__title-line">{{ section.settings.title_part_1 | escape }}</span>
              {% endif %}
              {% if section.settings.title_part_2 != blank %}
                <span class="booty-workouts__title-line">{{ section.settings.title_part_2 | escape }}</span>
              {% endif %}
              {% if section.settings.title_part_3 != blank %}
                <span class="booty-workouts__title-line booty-workouts__title-line--accent">{{ section.settings.title_part_3 | escape }}</span>
              {% endif %}
            </div>
          {% elsif section.settings.title != blank %}
            <div class="booty-workouts__title booty-workouts__title--legacy rte">{{ section.settings.title }}</div>
          {% endif %}
        </div>

        <div class="booty-workouts__body">
          {% if section.settings.starting_price != blank %}
            <p class="booty-workouts__starting-price">{{ section.settings.starting_price | escape }}</p>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="booty-workouts__description rte">{{ section.settings.description }}</div>
          {% endif %}

          {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
          {% if benefit_blocks.size > 0 %}
            <ul class="booty-workouts__benefits" role="list">
              {% for block in benefit_blocks %}
                <li class="booty-workouts__benefit" {{ block.shopify_attributes }}>
                  {{ block.settings.label | escape }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% assign tier_blocks = section.blocks | where: 'type', 'tier' %}
          {% if tier_blocks.size > 0 %}
            <div class="booty-workouts__tiers" data-booty-workouts-tiers>
              {% for block in tier_blocks %}
                {% assign tier_selected = false %}
                {% if block.settings.preselected %}
                  {% assign tier_selected = true %}
                {% elsif forloop.first %}
                  {% assign tier_selected = true %}
                {% endif %}
                <label
                  class="booty-workouts__tier{% if tier_selected %} is-selected{% endif %}{% if block.settings.ribbon != blank %} booty-workouts__tier--has-ribbon{% endif %}"
                  data-booty-workouts-tier
                  {{ block.shopify_attributes }}
                >
                  <input
                    type="radio"
                    name="booty-workouts-tier-{{ section.id }}"
                    class="booty-workouts__tier-input visually-hidden"
                    {% if tier_selected %}checked{% endif %}
                  >
                  {% if block.settings.ribbon != blank %}
                    <span class="booty-workouts__tier-ribbon">{{ block.settings.ribbon | escape }}</span>
                  {% endif %}
                  <span class="booty-workouts__tier-surface">
                    <span class="booty-workouts__tier-main">
                    {% if block.settings.thumb != blank %}
                      <span class="booty-workouts__tier-thumb">
                        {{
                          block.settings.thumb
                          | image_url: width: 480
                          | image_tag:
                            loading: 'lazy',
                            alt: block.settings.title,
                            width: block.settings.thumb.width,
                            height: block.settings.thumb.height
                        }}
                      </span>
                    {% endif %}
                    <span class="booty-workouts__tier-copy">
                      <span class="booty-workouts__tier-title">{{ block.settings.title | escape }}</span>
                    </span>
                    <span class="booty-workouts__tier-pricing">
                      {% if block.settings.old_price != blank or block.settings.price != blank %}
                        <span class="booty-workouts__tier-prices">
                          {% if block.settings.old_price != blank %}
                            <span class="booty-workouts__tier-old">{{ block.settings.old_price | escape }}</span>
                          {% endif %}
                          {% if block.settings.price != blank %}
                            <span class="booty-workouts__tier-price">{{ block.settings.price | escape }}</span>
                          {% endif %}
                        </span>
                      {% endif %}
                      {% if block.settings.discount != blank %}
                        <span class="booty-workouts__tier-discount">{{ block.settings.discount | escape }}</span>
                      {% endif %}
                    </span>
                    </span>
                  </span>
                </label>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.cta_label != blank %}
            <a
              class="booty-workouts__cta"
              href="{% if cta_opens_bundle_builder %}#nass-bundle-builder{% else %}{{ section.settings.cta_url | default: '#' }}{% endif %}"
              {% if cta_opens_bundle_builder %}data-booty-workouts-bundle-cta{% endif %}
            >
              <span>{{ section.settings.cta_label | escape }}</span>
              <span class="booty-workouts__cta-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </a>
          {% endif %}

          <div class="booty-workouts__trust">
            {% if section.settings.trust_guarantee != blank %}
              <span class="booty-workouts__trust-item">
                <span class="booty-workouts__trust-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3L5 6V11C5 15.55 8.05 19.74 12 21C15.95 19.74 19 15.55 19 11V6L12 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M9.5 12.5L11.2 14.2L14.8 10.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                {{ section.settings.trust_guarantee | escape }}
              </span>
            {% endif %}
            {% if section.settings.trust_support != blank %}
              <span class="booty-workouts__trust-item">
                <span class="booty-workouts__trust-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M8.8 12.2L11.1 14.4L15.3 10.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                {{ section.settings.trust_support | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.secure_label != blank or section.settings.payment_icons_image != blank %}
            <div class="booty-workouts__secure-checkout">
              {% if section.settings.secure_label != blank %}
                <p class="booty-workouts__secure-label">{{ section.settings.secure_label | escape }}</p>
              {% endif %}
              {% assign payment_icons_alt = section.settings.payment_icons_alt | default: 'Accepted payment methods' | escape %}
              <div class="booty-workouts__payment-strip">
                {% if section.settings.payment_icons_image != blank %}
                  {{
                    section.settings.payment_icons_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'booty-workouts__payment-strip-img',
                      loading: 'lazy',
                      widths: '320,480,640,900,1200',
                      sizes: '(min-width: 768px) 520px, 100vw',
                      alt: payment_icons_alt
                  }}
                {% else %}
                  <img
                    class="booty-workouts__payment-strip-img"
                    src="{{ 'booty-workouts-payment-icons.png' | asset_url }}"
                    alt="{{ payment_icons_alt }}"
                    loading="lazy"
                    width="1124"
                    height="58"
                  >
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% assign review_blocks = section.blocks | where: 'type', 'review' %}
          {% if review_blocks.size > 0 %}
            <div
              class="booty-workouts__reviews{% if review_blocks.size > 1 %} booty-workouts__reviews--slider{% endif %}"
              data-booty-workouts-reviews
            >
              {% for block in review_blocks %}
                {% assign review_rating = block.settings.rating | default: 5 | plus: 0 %}
                <article class="booty-workouts__review{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.avatar != blank %}
                    <span class="booty-workouts__review-avatar">
                      {{
                        block.settings.avatar
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', alt: block.settings.title
                      }}
                    </span>
                  {% endif %}
                  <div class="booty-workouts__review-copy">
                    {% if block.settings.title != blank %}
                      <div class="booty-workouts__review-head">
                        <p class="booty-workouts__review-title">{{ block.settings.title | escape }}</p>
                        <div class="booty-workouts__review-stars" role="img" aria-label="{{ review_rating }} out of 5 stars">
                          {% for i in (1..5) %}
                            <svg class="booty-workouts__review-star{% if i <= review_rating %} booty-workouts__review-star--filled{% endif %}" viewBox="0 0 24 24" aria-hidden="true">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.body != blank %}
                      <div class="booty-workouts__review-body rte">{{ block.settings.body }}</div>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          {% elsif section.settings.review_title != blank or section.settings.review_body != blank %}
            <div class="booty-workouts__reviews">
              <article class="booty-workouts__review">
                {% if section.settings.review_avatar != blank %}
                  <span class="booty-workouts__review-avatar">
                    {{
                      section.settings.review_avatar
                      | image_url: width: 80
                      | image_tag: loading: 'lazy', alt: section.settings.review_title
                    }}
                  </span>
                {% endif %}
                <div class="booty-workouts__review-copy">
                  {% if section.settings.review_title != blank %}
                    <div class="booty-workouts__review-head">
                      <p class="booty-workouts__review-title">{{ section.settings.review_title | escape }}</p>
                      <div class="booty-workouts__review-stars" role="img" aria-label="5 out of 5 stars">
                        {% for i in (1..5) %}
                          <svg class="booty-workouts__review-star booty-workouts__review-star--filled" viewBox="0 0 24 24" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                          </svg>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                  {% if section.settings.review_body != blank %}
                    <div class="booty-workouts__review-body rte">{{ section.settings.review_body }}</div>
                  {% endif %}
                </div>
              </article>
            </div>
          {% endif %}

          {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
          {% if faq_blocks.size > 0 %}
            <div class="booty-workouts__faq" data-booty-workouts-faq>
              {% for block in faq_blocks %}
                <details
                  class="booty-workouts__faq-item"
                  {% if block.settings.open_by_default %}open{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <summary class="booty-workouts__faq-question">{{ block.settings.question | escape }}</summary>
                  {% if block.settings.answer != blank %}
                    <div class="booty-workouts__faq-answer rte">{{ block.settings.answer }}</div>
                  {% endif %}
                </details>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .booty-workouts {
    padding: clamp(2rem, 5vw, 4rem) 20px;
  }

  .booty-workouts__container {
    max-width: 1184px;
    margin: 0 auto;
  }

  .booty-workouts__grid {
    display: grid;
    gap: 28px;
  }

  .booty-workouts__details {
    display: contents;
  }

  .booty-workouts__head {
    order: 1;
  }

  .booty-workouts__media {
    order: 2;
  }

  .booty-workouts__body {
    order: 3;
    display: grid;
    gap: 20px;
  }

  .booty-workouts__head {
    text-align: left;
  }

  .booty-workouts__rating {
    display: block;
    color: #666;
  }

  .booty-workouts__rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .booty-workouts__rating-label,
  .booty-workouts__rating-score,
  .booty-workouts__rating-subline {
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 400;
  }

  .booty-workouts__rating-subline {
    display: block;
    margin-top: 4px;
  }

  .booty-workouts__stars {
    color: #f5b301;
    letter-spacing: 0.06em;
    font-size: 14px;
    line-height: 1;
  }

  .booty-workouts__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 12px;
    text-align: left;
    text-transform: uppercase;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-stretch: 150%;
    letter-spacing: 0.03em;
    line-height: 1.05;
    font-size: clamp(1.75rem, 8vw, 2.8125rem);
    font-weight: 700;
    color: #000;
  }

  .booty-workouts__title-line {
    display: block;
    color: #000;
    font-weight: 700;
  }

  .booty-workouts__title-line--accent {
    font-weight: 900;
  }

  .booty-workouts__title--legacy {
    color: #000;
    font-weight: 700;
  }

  .booty-workouts__title--legacy strong {
    color: #000;
    font-weight: 900;
  }

  .booty-workouts__title p {
    margin: 0;
    color: #000;
  }

  .booty-workouts__starting-price {
    margin: 0;
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.35;
  }

  .booty-workouts__image-wrap {
    position: relative;
    aspect-ratio: 335 / 319;
    border-radius: var(--booty-workouts-image-radius, 30px);
    overflow: hidden;
    background: #f0f0f0;
  }

  .booty-workouts__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }

  .booty-workouts__slide.is-active {
    opacity: 1;
    z-index: 1;
