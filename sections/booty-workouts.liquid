<script>
  (() => {
    const section = document.getElementById('booty-workouts-{{ section.id }}');
    if (!section) return;

    const tiersRoot = section.querySelector('[data-booty-workouts-tiers]');
    if (tiersRoot) {
      tiersRoot.addEventListener('change', (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'radio') return;

        tiersRoot.querySelectorAll('[data-booty-workouts-tier]').forEach((tier) => {
          tier.classList.toggle('is-selected', tier.contains(input) && input.checked);
        });
      });
    }

    const faqRoot = section.querySelector('[data-booty-workouts-faq]');
    if (faqRoot) {
      faqRoot.querySelectorAll('.booty-workouts__faq-item').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          faqRoot.querySelectorAll('.booty-workouts__faq-item').forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });
    }

    const galleryRoot = section.querySelector('[data-booty-workouts-gallery]');
    if (galleryRoot) {
      const slides = Array.from(galleryRoot.querySelectorAll('[data-booty-workouts-slide]'));
      const barsWrap = galleryRoot.querySelector('[data-booty-workouts-bars]');
      if (!barsWrap || slides.length === 0) return;

      const showBars = slides.length > 1;
      barsWrap.hidden = !showBars;

      if (showBars && !barsWrap.querySelector('[data-booty-workouts-bar]')) {
        slides.forEach((slide, index) => {
          const bar = document.createElement('button');
          bar.type = 'button';
          bar.className = 'booty-workouts__bar' + (index === 0 ? ' booty-workouts__bar--active' : '');
          bar.setAttribute('data-booty-workouts-bar', '');
          bar.setAttribute('data-slide-index', String(index));
          bar.setAttribute('role', 'tab');
          bar.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          bar.setAttribute('aria-label', 'Slide ' + (index + 1));
          barsWrap.appendChild(bar);
        });
      }

      const bars = Array.from(barsWrap.querySelectorAll('[data-booty-workouts-bar]'));
      if (!showBars || bars.length < 2) return;

      const goToSlide = (index) => {
        const safeIndex = Math.max(0, Math.min(index, slides.length - 1));
        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === safeIndex);
        });
        bars.forEach((bar, barIndex) => {
          const isActive = barIndex === safeIndex;
          bar.classList.toggle('booty-workouts__bar--active', isActive);
          bar.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      };

      bars.forEach((bar) => {
        bar.addEventListener('click', () => {
          const index = Number.parseInt(bar.getAttribute('data-slide-index') || '0', 10);
          goToSlide(index);
        });
      });
    }

    const bundleCta = section.querySelector('[data-booty-workouts-bundle-cta]');
    if (bundleCta) {
      function tryOpenBundleWizard(maxRetries) {
        maxRetries = typeof maxRetries === 'number' ? maxRetries : 25;
        var retries = 0;
        function tick() {
          if (window.NassBundleBuilder && typeof window.NassBundleBuilder.openWizard === 'function') {
            window.NassBundleBuilder.openWizard();
            return;
          }
          if (retries >= maxRetries) {
            window.location.hash = '#nass-bundle-builder';
            return;
          }
          retries += 1;
          setTimeout(tick, 100);
        }
        tick();
      }

      bundleCta.addEventListener('click', (event) => {
        event.preventDefault();
        tryOpenBundleWizard(25);
      });
    }

    const reviewsRoot = section.querySelector('[data-booty-workouts-reviews]');
    if (reviewsRoot) {
      const reviews = Array.from(reviewsRoot.querySelectorAll('.booty-workouts__review'));
      if (reviews.length > 1) {
        let activeIndex = reviews.findIndex((review) => review.classList.contains('is-active'));
        if (activeIndex < 0) activeIndex = 0;

        const showReview = (index) => {
          reviews.forEach((review, reviewIndex) => {
            review.classList.toggle('is-active', reviewIndex === index);
          });
        };

        window.setInterval(() => {
          activeIndex = (activeIndex + 1) % reviews.length;
          showReview(activeIndex);
        }, 7000);
      }
    }
  })();
</script>

