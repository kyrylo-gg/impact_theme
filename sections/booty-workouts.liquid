  }

  .booty-workouts__review-star--filled {
    fill: #f5b301;
    stroke: #f5b301;
  }

  .booty-workouts__review-body {
    margin-top: 8px;
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.4;
  }

  .booty-workouts__review-body p {
    margin: 0;
  }

  .booty-workouts__faq {
    display: grid;
    gap: 0;
    border-top: 1px solid #f0f0f0;
