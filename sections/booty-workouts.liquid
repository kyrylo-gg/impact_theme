{% liquid
  assign is_pop_booty_template = false
  if request.page_type == 'product' and template.suffix == 'pop_booty' or request.page_type == 'product' and template.suffix == 'pop_booty_new'
    assign is_pop_booty_template = true
  endif

  assign cta_opens_bundle_builder = false
  assign cta_adds_product = false

  if section.settings.cta_action == 'bundle_builder'
    assign cta_opens_bundle_builder = true
  elsif section.settings.cta_action == 'add_product'
    assign cta_adds_product = true
  elsif section.settings.cta_action == 'link'
    assign cta_opens_bundle_builder = false
  elsif request.page_type == 'product' and template.suffix == 'pop_booty'
    assign cta_opens_bundle_builder = true
  endif

  if section.settings.anchor_id != blank
    assign booty_workouts_anchor = section.settings.anchor_id | strip
  else
    assign booty_workouts_anchor = 'booty-workouts-' | append: section.id
  endif

  assign booty_workouts_role = ''
  if is_pop_booty_template
    if booty_workouts_anchor == 'booty-workouts'
      assign booty_workouts_role = 'hero'
    elsif booty_workouts_anchor == 'booty-workouts-repeat'
      assign booty_workouts_role = 'repeat'
    endif
  endif

  assign cta_fallback_variant_id = ''
  if section.settings.cta_product != blank
    assign cta_fallback_variant_id = section.settings.cta_product.selected_or_first_available_variant.id
  endif
%}

<section
  class="section-booty-workouts booty-workouts"
  id="{{ booty_workouts_anchor | escape }}"
  data-section-id="{{ section.id }}"
  {% if booty_workouts_role != blank %}data-booty-workouts-role="{{ booty_workouts_role }}"{% endif %}
  {% if cta_fallback_variant_id != blank %}data-booty-workouts-fallback-variant-id="{{ cta_fallback_variant_id }}"{% endif %}
  style="
    --booty-workouts-image-radius: {{ section.settings.image_radius }}px;
  "
>
  <style>
    #shopify-section-{{ section.id }} .booty-workouts__thumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      margin-top: 12px;
      padding: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .booty-workouts__thumbs::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .booty-workouts__thumbs[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .booty-workouts__thumb {
      display: block;
      flex: 0 0 auto;
      width: 52px;
      height: 52px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 4px;
      background: #f0f0f0;
      overflow: hidden;
      cursor: pointer;
      transition: border-color 200ms ease;
    }

    #shopify-section-{{ section.id }} .booty-workouts__thumb--active {
      border-color: #b8a7d3;
    }

    #shopify-section-{{ section.id }} .booty-workouts__thumb-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .booty-workouts__head {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating {
      display: block;
      color: #666;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-label,
    #shopify-section-{{ section.id }} .booty-workouts__rating-score,
    #shopify-section-{{ section.id }} .booty-workouts__rating-subline {
      color: #666;
      font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
      font-size: 14px;
      line-height: 1.35;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .booty-workouts__rating-subline {
      display: block;
      margin-top: 4px;
    }

    #shopify-section-{{ section.id }} .booty-workouts__stars {
      color: #f5b301;
      letter-spacing: 0.06em;
      font-size: 14px;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      margin-top: 12px;
      text-align: left;
      text-transform: uppercase;
      font-family: 'Anybody', sans-serif;
      font-stretch: 150%;
      letter-spacing: 0.03em;
      line-height: 1.05;
      font-size: clamp(1.75rem, 8vw, 2.8125rem);
      font-weight: 700;
      color: #000;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line {
      display: block;
      color: #000;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line--accent {
      font-weight: 900;
    }

    #shopify-section-{{ section.id }} .booty-workouts__title-line + .booty-workouts__title-line {
      margin-top: 0;
    }

    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .booty-workouts__title {
        font-size: 35px;
      }
    }
  </style>
  <div class="booty-workouts__container">
    <div class="booty-workouts__grid">
      <div class="booty-workouts__media" data-booty-workouts-gallery>
        {%- liquid
          assign gallery_slides = 0
          assign gallery_source = 'placeholder'

          for block in section.blocks
            if block.type == 'gallery_image'
              if block.settings.image != blank or block.settings.video != blank
                assign gallery_slides = gallery_slides | plus: 1
              endif
            endif
          endfor

          if gallery_slides > 0
            assign gallery_source = 'blocks'
          elsif product != blank and product.media.size > 0
            unless section.settings.gallery_use_product_media == false
              assign gallery_slides = product.media.size
              assign gallery_source = 'product'
            endunless
          endif

          if gallery_source == 'placeholder'
            if section.settings.hero_image != blank
              assign gallery_slides = 1
              assign gallery_source = 'hero'
            else
              assign gallery_slides = 1
            endif
          endif
        -%}

        <div class="booty-workouts__image-wrap">
          {% case gallery_source %}
            {% when 'blocks' %}
              {% assign first_gallery_slide = true %}
              {% for block in section.blocks %}
                {% if block.type == 'gallery_image' %}
                  {% if block.settings.image != blank or block.settings.video != blank %}
                  <div
                    class="booty-workouts__slide{% if first_gallery_slide %} is-active{% endif %}"
                    data-booty-workouts-slide
                    {% if block.settings.video != blank and block.settings.video_autoplay_active %}data-booty-workouts-video-autoplay="true"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          class: 'booty-workouts__video',
                          autoplay: false,
                          loop: block.settings.video_loop,
                          muted: true,
                          controls: block.settings.video_controls,
                          playsinline: true,
                          preload: 'metadata'
                      }}
                    {% else %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'booty-workouts__image',
                          loading: 'lazy',
                          widths: '335,582,900,1200',
                          sizes: '(min-width: 768px) 582px, 100vw',
                          alt: block.settings.alt
                      }}
                    {% endif %}
                  </div>
                  {% assign first_gallery_slide = false %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% when 'product' %}
              {% for media in product.media %}
                <div
                  class="booty-workouts__slide{% if forloop.first %} is-active{% endif %}"
                  data-booty-workouts-slide
                >
                  {% if media.media_type == 'image' %}
                    {{
                      media
                      | image_url: width: 1200
                      | image_tag:
                        class: 'booty-workouts__image',
                        loading: 'lazy',
                        widths: '335,582,900,1200',
                        sizes: '(min-width: 768px) 582px, 100vw',
                        alt: media.alt
                    }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'booty-workouts__image',
                        loading: 'lazy',
                        widths: '335,582,900,1200',
                        sizes: '(min-width: 768px) 582px, 100vw',
                        alt: media.alt
                    }}
                  {% endif %}
                </div>
              {% endfor %}
            {% when 'hero' %}
              <div class="booty-workouts__slide is-active" data-booty-workouts-slide>
                {{
                  section.settings.hero_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'booty-workouts__image',
                    loading: 'lazy',
                    widths: '335,582,900,1200',
                    sizes: '(min-width: 768px) 582px, 100vw'
                }}
              </div>
            {% else %}
              <div class="booty-workouts__slide is-active" data-booty-workouts-slide>
                {{ 'product-1' | placeholder_svg_tag: 'booty-workouts__image booty-workouts__image--placeholder' }}
              </div>
          {% endcase %}
        </div>

        <div
          class="booty-workouts__thumbs"
          data-booty-workouts-thumbs
          role="tablist"
          aria-label="Product gallery"
          {% unless gallery_slides > 1 %}hidden{% endunless %}
        >
          {% if gallery_source == 'blocks' %}
            {% assign thumb_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_image' %}
                {% if block.settings.image != blank or block.settings.video != blank %}
                <button
                  type="button"
                  class="booty-workouts__thumb{% if thumb_index == 0 %} booty-workouts__thumb--active{% endif %}"
                  data-booty-workouts-thumb
                  data-slide-index="{{ thumb_index }}"
                  role="tab"
                  aria-selected="{% if thumb_index == 0 %}true{% else %}false{% endif %}"
                  aria-label="Slide {{ thumb_index | plus: 1 }}"
                >
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 160
                      | image_tag:
                        class: 'booty-workouts__thumb-image',
                        loading: 'lazy',
                        widths: '80, 120, 160',
                        sizes: '52px',
                        alt: block.settings.alt
                    }}
                  {% elsif block.settings.video != blank %}
                    {{
                      block.settings.video.preview_image
                      | image_url: width: 160
                      | image_tag:
                        class: 'booty-workouts__thumb-image',
                        loading: 'lazy',
                        widths: '80, 120, 160',
                        sizes: '52px',
                        alt: block.settings.alt
                    }}
                  {% endif %}
                </button>
                {% assign thumb_index = thumb_index | plus: 1 %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% elsif gallery_source == 'product' %}
            {% for media in product.media %}
              <button
                type="button"
                class="booty-workouts__thumb{% if forloop.first %} booty-workouts__thumb--active{% endif %}"
                data-booty-workouts-thumb
                data-slide-index="{{ forloop.index0 }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Slide {{ forloop.index }}"
              >
                {% if media.media_type == 'image' %}
                  {{
                    media
                    | image_url: width: 160
                    | image_tag:
                      class: 'booty-workouts__thumb-image',
                      loading: 'lazy',
                      widths: '80, 120, 160',
                      sizes: '52px',
                      alt: media.alt
                  }}
                {% else %}
                  {{
                    media.preview_image
                    | image_url: width: 160
                    | image_tag:
                      class: 'booty-workouts__thumb-image',
                      loading: 'lazy',
                      widths: '80, 120, 160',
                      sizes: '52px',
                      alt: media.alt
                  }}
                {% endif %}
              </button>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <div class="booty-workouts__details">
        <div class="booty-workouts__head">
          {% if section.settings.rating_value != blank %}
            {%- liquid
              assign rating_score = section.settings.rating_value
              assign rating_subline = ''
              if section.settings.rating_value contains ' by '
                assign rating_split = section.settings.rating_value | split: ' by '
                assign rating_score = rating_split[0] | strip
                assign rating_subline = 'by ' | append: rating_split[1] | strip
              endif
            -%}
            <div class="booty-workouts__rating">
              <div class="booty-workouts__rating-row">
                {% if section.settings.rating_label != blank %}
                  <span class="booty-workouts__rating-label">{{ section.settings.rating_label | escape }}</span>
                {% endif %}
                <span class="booty-workouts__stars" aria-hidden="true">★★★★★</span>
                <span class="booty-workouts__rating-score">{{ rating_score | escape }}</span>
              </div>
              {% if rating_subline != blank %}
                <span class="booty-workouts__rating-subline">{{ rating_subline | escape }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.title_part_1 != blank or section.settings.title_part_2 != blank or section.settings.title_part_3 != blank %}
            <div class="booty-workouts__title">
              {% if section.settings.title_part_1 != blank %}
                <span class="booty-workouts__title-line">{{ section.settings.title_part_1 | escape }}</span>
              {% endif %}
              {% if section.settings.title_part_2 != blank %}
                <span class="booty-workouts__title-line">{{ section.settings.title_part_2 | escape }}</span>
              {% endif %}
              {% if section.settings.title_part_3 != blank %}
                <span class="booty-workouts__title-line booty-workouts__title-line--accent">{{ section.settings.title_part_3 | escape }}</span>
              {% endif %}
            </div>
          {% elsif section.settings.title != blank %}
            <div class="booty-workouts__title booty-workouts__title--legacy rte">{{ section.settings.title }}</div>
          {% endif %}
        </div>

        <div class="booty-workouts__body">
          {% if section.settings.starting_price != blank %}
            <p class="booty-workouts__starting-price">{{ section.settings.starting_price | escape }}</p>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="booty-workouts__description rte">{{ section.settings.description }}</div>
          {% endif %}

          {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
          {% if benefit_blocks.size > 0 %}
            <div class="booty-workouts__offer-card">
              {% if section.settings.offer_banner_title != blank or section.settings.offer_banner_eyebrow != blank %}
                <div class="booty-workouts__offer-banner">
                  <span class="booty-workouts__offer-sparkles booty-workouts__offer-sparkles--left" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none">
                      <path d="M20 4L21.8 14.2L32 16L21.8 17.8L20 28L18.2 17.8L8 16L18.2 14.2L20 4Z" fill="#FFF600"/>
                      <path d="M8 8L8.9 12.1L13 13L8.9 13.9L8 18L7.1 13.9L3 13L7.1 12.1L8 8Z" fill="#FFF600"/>
                      <path d="M32 24L32.9 28.1L37 29L32.9 29.9L32 34L31.1 29.9L27 29L31.1 28.1L32 24Z" fill="#FFF600"/>
                    </svg>
                  </span>
                  <div class="booty-workouts__offer-copy">
                    {% if section.settings.offer_banner_eyebrow != blank %}
                      <p class="booty-workouts__offer-eyebrow">{{ section.settings.offer_banner_eyebrow | escape }}</p>
                    {% endif %}
                    {% if section.settings.offer_banner_title != blank %}
                      <p class="booty-workouts__offer-title">{{ section.settings.offer_banner_title | escape }}</p>
                    {% endif %}
                  </div>
                  <span class="booty-workouts__offer-sparkles booty-workouts__offer-sparkles--right" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none">
                      <path d="M20 4L21.8 14.2L32 16L21.8 17.8L20 28L18.2 17.8L8 16L18.2 14.2L20 4Z" fill="#FFF600"/>
                      <path d="M8 8L8.9 12.1L13 13L8.9 13.9L8 18L7.1 13.9L3 13L7.1 12.1L8 8Z" fill="#FFF600"/>
                      <path d="M32 24L32.9 28.1L37 29L32.9 29.9L32 34L31.1 29.9L27 29L31.1 28.1L32 24Z" fill="#FFF600"/>
                    </svg>
                  </span>
                </div>
              {% endif %}
              <div class="booty-workouts__offer-body">
                <ul class="booty-workouts__benefits" role="list">
                  {% for block in benefit_blocks %}
                    <li class="booty-workouts__benefit" {{ block.shopify_attributes }}>
                      {{ block.settings.label | escape }}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}

          {% assign tier_blocks = section.blocks | where: 'type', 'tier' %}
          {% if tier_blocks.size > 0 %}
            <div class="booty-workouts__tiers" data-booty-workouts-tiers>
              {% for block in tier_blocks %}
                {% assign tier_selected = false %}
                {% if block.settings.preselected %}
                  {% assign tier_selected = true %}
                {% elsif forloop.first %}
                  {% assign tier_selected = true %}
                {% endif %}

                {% assign tier_feature_count = 0 %}
                {% for feature_index in (1..4) %}
                  {% capture feature_key %}feature_{{ feature_index }}{% endcapture %}
                  {% if block.settings[feature_key] != blank %}
                    {% assign tier_feature_count = tier_feature_count | plus: 1 %}
                  {% endif %}
                {% endfor %}

                {% assign tier_has_details = false %}
                {% if tier_feature_count > 0 or block.settings.extra_1_label != blank or block.settings.extra_2_label != blank %}
                  {% assign tier_has_details = true %}
                {% endif %}

                <div
                  class="booty-workouts__tier{% if tier_selected %} is-selected{% endif %}{% if forloop.first and tier_has_details %} is-expanded{% endif %}{% if block.settings.ribbon != blank %} booty-workouts__tier--has-ribbon{% endif %}"
                  data-booty-workouts-tier
                  data-booty-workouts-program-index="{{ forloop.index0 }}"
                  {% if block.settings.product != blank %}data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id }}"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <input
                    type="radio"
                    name="booty-workouts-tier-{{ section.id }}"
                    id="booty-workouts-tier-{{ section.id }}-{{ block.id }}"
                    class="booty-workouts__tier-input visually-hidden"
                    {% if tier_selected %}checked{% endif %}
                  >
                  {% if block.settings.ribbon != blank %}
                    <span class="booty-workouts__tier-ribbon">{{ block.settings.ribbon | escape }}</span>
                  {% endif %}
                  <div class="booty-workouts__tier-surface">
                    <button
                      type="button"
                      class="booty-workouts__tier-header"
                      data-booty-workouts-tier-toggle
                      aria-expanded="{% if forloop.first and tier_has_details %}true{% else %}false{% endif %}"
                      aria-controls="booty-workouts-tier-details-{{ section.id }}-{{ block.id }}"
                    >
                      <span class="booty-workouts__tier-main">
                        {% if block.settings.thumb != blank %}
                          <span class="booty-workouts__tier-thumb">
                            {{
                              block.settings.thumb
                              | image_url: width: 480
                              | image_tag:
                                loading: 'lazy',
                                alt: block.settings.title,
                                width: block.settings.thumb.width,
                                height: block.settings.thumb.height
                            }}
                          </span>
                        {% endif %}
                        <span class="booty-workouts__tier-copy">
                          <span class="booty-workouts__tier-title">{{ block.settings.title | escape }}</span>
                        </span>
                        <span class="booty-workouts__tier-pricing">
                          {% if block.settings.old_price != blank or block.settings.price != blank %}
                            <span class="booty-workouts__tier-prices">
                              {% if block.settings.old_price != blank %}
                                <span class="booty-workouts__tier-old">{{ block.settings.old_price | escape }}</span>
                              {% endif %}
                              {% if block.settings.price != blank %}
                                <span class="booty-workouts__tier-price">{{ block.settings.price | escape }}</span>
                              {% endif %}
                            </span>
                          {% endif %}
                          {% if block.settings.discount != blank %}
                            <span class="booty-workouts__tier-discount">{{ block.settings.discount | escape }}</span>
                          {% endif %}
                        </span>
                      </span>
                    </button>

                    {% if tier_has_details %}
                      <div
                        class="booty-workouts__tier-details"
                        id="booty-workouts-tier-details-{{ section.id }}-{{ block.id }}"
                        data-booty-workouts-tier-details
                      >
                        <div class="booty-workouts__tier-details-inner">
                        {% assign tier_inline_extra = false %}
                        {% if tier_feature_count == 1 and block.settings.extra_1_label != blank and block.settings.extra_2_label == blank %}
                          {% assign tier_inline_extra = true %}
                        {% endif %}

                        {% if tier_feature_count > 0 or tier_inline_extra %}
                          <ul class="booty-workouts__tier-features{% if tier_inline_extra %} booty-workouts__tier-features--inline-extra{% endif %}" role="list">
                            {% for feature_index in (1..4) %}
                              {% capture feature_key %}feature_{{ feature_index }}{% endcapture %}
                              {% if block.settings[feature_key] != blank %}
                                <li class="booty-workouts__tier-feature">
                                  <span class="booty-workouts__tier-feature-icon booty-workouts__tier-feature-icon--check" aria-hidden="true">
                                    <svg viewBox="0 0 20 20" fill="none">
                                      <circle cx="10" cy="10" r="10" fill="currentColor"></circle>
                                      <path d="M6 10.5L8.5 13L14 7.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                  </span>
                                  <span>{{ block.settings[feature_key] | escape }}</span>
                                </li>
                              {% endif %}
                            {% endfor %}
                            {% if tier_inline_extra %}
                              <li class="booty-workouts__tier-feature">
                                <span class="booty-workouts__tier-feature-icon booty-workouts__tier-feature-icon--emoji" aria-hidden="true">
                                  {{ block.settings.extra_1_icon | default: '✅' }}
                                </span>
                                <span>{{ block.settings.extra_1_label | escape }}</span>
                              </li>
                            {% endif %}
                          </ul>
                        {% endif %}

                        {% unless tier_inline_extra %}
                          {% if block.settings.extra_1_label != blank or block.settings.extra_2_label != blank %}
                            <div class="booty-workouts__tier-extras">
                              {% if block.settings.extra_1_label != blank %}
                                <span class="booty-workouts__tier-extra">
                                  <span class="booty-workouts__tier-feature-icon booty-workouts__tier-feature-icon--emoji" aria-hidden="true">
                                    {{ block.settings.extra_1_icon | default: '✅' }}
                                  </span>
                                  <span>{{ block.settings.extra_1_label | escape }}</span>
                                </span>
                              {% endif %}
                              {% if block.settings.extra_2_label != blank %}
                                <span class="booty-workouts__tier-extra">
                                  <span class="booty-workouts__tier-feature-icon booty-workouts__tier-feature-icon--emoji" aria-hidden="true">
                                    {{ block.settings.extra_2_icon | default: '🧘‍♀️' }}
                                  </span>
                                  <span>{{ block.settings.extra_2_label | escape }}</span>
                                </span>
                              {% endif %}
                            </div>
                          {% endif %}
                        {% endunless %}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.cta_label != blank %}
            {% if cta_adds_product %}
              <button
                type="button"
                class="booty-workouts__cta"
                data-booty-workouts-cart-cta
                data-nass-ocu-atc
                {% if cta_fallback_variant_id != blank %}data-variant-id="{{ cta_fallback_variant_id }}"{% endif %}
              >
                <span>{{ section.settings.cta_label | escape }}</span>
                <span class="booty-workouts__cta-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </button>
            {% else %}
              <a
                class="booty-workouts__cta"
                href="{% if cta_opens_bundle_builder %}#nass-bundle-builder{% else %}{{ section.settings.cta_url | default: '#' }}{% endif %}"
                {% if cta_opens_bundle_builder %}data-booty-workouts-bundle-cta{% endif %}
              >
                <span>{{ section.settings.cta_label | escape }}</span>
                <span class="booty-workouts__cta-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </a>
            {% endif %}
          {% endif %}

          <div class="booty-workouts__trust">
            {% if section.settings.trust_guarantee != blank %}
              <span class="booty-workouts__trust-item">
                <span class="booty-workouts__trust-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3L5 6V11C5 15.55 8.05 19.74 12 21C15.95 19.74 19 15.55 19 11V6L12 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M9.5 12.5L11.2 14.2L14.8 10.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                {{ section.settings.trust_guarantee | escape }}
              </span>
            {% endif %}
            {% if section.settings.trust_support != blank %}
              <span class="booty-workouts__trust-item">
                <span class="booty-workouts__trust-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M8.8 12.2L11.1 14.4L15.3 10.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                {{ section.settings.trust_support | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.secure_label != blank or section.settings.payment_icons_image != blank %}
            <div class="booty-workouts__secure-checkout">
              {% if section.settings.secure_label != blank %}
                <p class="booty-workouts__secure-label">{{ section.settings.secure_label | escape }}</p>
              {% endif %}
              {% assign payment_icons_alt = section.settings.payment_icons_alt | default: 'Accepted payment methods' | escape %}
              <div class="booty-workouts__payment-strip">
                {% if section.settings.payment_icons_image != blank %}
                  {{
                    section.settings.payment_icons_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'booty-workouts__payment-strip-img',
                      loading: 'lazy',
                      widths: '320,480,640,900,1200',
                      sizes: '(min-width: 768px) 520px, 100vw',
                      alt: payment_icons_alt
                  }}
                {% else %}
                  <img
                    class="booty-workouts__payment-strip-img"
                    src="{{ 'booty-workouts-payment-icons.png' | asset_url }}"
                    alt="{{ payment_icons_alt }}"
                    loading="lazy"
                    width="1124"
                    height="58"
                  >
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% assign review_blocks = section.blocks | where: 'type', 'review' %}
          {% if review_blocks.size > 0 %}
            <div
              class="booty-workouts__reviews{% if review_blocks.size > 1 %} booty-workouts__reviews--slider{% endif %}"
              data-booty-workouts-reviews
            >
              {% for block in review_blocks %}
                {% assign review_rating = block.settings.rating | default: 5 | plus: 0 %}
                <article class="booty-workouts__review{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.avatar != blank %}
                    <span class="booty-workouts__review-avatar">
                      {{
                        block.settings.avatar
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', alt: block.settings.title
                      }}
                    </span>
                  {% endif %}
                  <div class="booty-workouts__review-copy">
                    {% if block.settings.title != blank %}
                      <div class="booty-workouts__review-head">
                        <p class="booty-workouts__review-title">{{ block.settings.title | escape }}</p>
                        <div class="booty-workouts__review-stars" role="img" aria-label="{{ review_rating }} out of 5 stars">
                          {% for i in (1..5) %}
                            <svg class="booty-workouts__review-star{% if i <= review_rating %} booty-workouts__review-star--filled{% endif %}" viewBox="0 0 24 24" aria-hidden="true">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.body != blank %}
                      <div class="booty-workouts__review-body rte">{{ block.settings.body }}</div>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          {% elsif section.settings.review_title != blank or section.settings.review_body != blank %}
            <div class="booty-workouts__reviews">
              <article class="booty-workouts__review">
                {% if section.settings.review_avatar != blank %}
                  <span class="booty-workouts__review-avatar">
                    {{
                      section.settings.review_avatar
                      | image_url: width: 80
                      | image_tag: loading: 'lazy', alt: section.settings.review_title
                    }}
                  </span>
                {% endif %}
                <div class="booty-workouts__review-copy">
                  {% if section.settings.review_title != blank %}
                    <div class="booty-workouts__review-head">
                      <p class="booty-workouts__review-title">{{ section.settings.review_title | escape }}</p>
                      <div class="booty-workouts__review-stars" role="img" aria-label="5 out of 5 stars">
                        {% for i in (1..5) %}
                          <svg class="booty-workouts__review-star booty-workouts__review-star--filled" viewBox="0 0 24 24" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                          </svg>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                  {% if section.settings.review_body != blank %}
                    <div class="booty-workouts__review-body rte">{{ section.settings.review_body }}</div>
                  {% endif %}
                </div>
              </article>
            </div>
          {% endif %}

          {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
          {% if faq_blocks.size > 0 %}
            <div class="booty-workouts__faq" data-booty-workouts-faq>
              {% for block in faq_blocks %}
                <details
                  class="booty-workouts__faq-item"
                  {% if block.settings.open_by_default %}open{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <summary class="booty-workouts__faq-question">{{ block.settings.question | escape }}</summary>
                  {% if block.settings.answer != blank %}
                    <div class="booty-workouts__faq-answer rte">{{ block.settings.answer }}</div>
                  {% endif %}
                </details>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .booty-workouts {
    padding: clamp(2rem, 5vw, 4rem) 20px;
  }

  .booty-workouts__container {
    max-width: 1184px;
    margin: 0 auto;
  }

  .booty-workouts__grid {
    display: grid;
    gap: 28px;
  }

  .booty-workouts__details {
    display: contents;
  }

  .booty-workouts__head {
    order: 1;
  }

  .booty-workouts__media {
    order: 2;
  }

  .booty-workouts__body {
    order: 3;
    display: grid;
    gap: 20px;
  }

  .booty-workouts__head {
    text-align: left;
  }

  .booty-workouts__rating {
    display: block;
    color: #666;
  }

  .booty-workouts__rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .booty-workouts__rating-label,
  .booty-workouts__rating-score,
  .booty-workouts__rating-subline {
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 400;
  }

  .booty-workouts__rating-subline {
    display: block;
    margin-top: 4px;
  }

  .booty-workouts__stars {
    color: #f5b301;
    letter-spacing: 0.06em;
    font-size: 14px;
    line-height: 1;
  }

  .booty-workouts__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 12px;
    text-align: left;
    text-transform: uppercase;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-stretch: 150%;
    letter-spacing: 0.03em;
    line-height: 1.05;
    font-size: clamp(1.75rem, 8vw, 2.8125rem);
    font-weight: 700;
    color: #000;
  }

  .booty-workouts__title-line {
    display: block;
    color: #000;
    font-weight: 700;
  }

  .booty-workouts__title-line--accent {
    font-weight: 900;
  }

  .booty-workouts__title--legacy {
    color: #000;
    font-weight: 700;
  }

  .booty-workouts__title--legacy strong {
    color: #000;
    font-weight: 900;
  }

  .booty-workouts__title p {
    margin: 0;
    color: #000;
  }

  .booty-workouts__starting-price {
    margin: 0;
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.35;
  }

  .booty-workouts__image-wrap {
    position: relative;
    aspect-ratio: 335 / 319;
    border-radius: var(--booty-workouts-image-radius, 30px);
    overflow: hidden;
    background: #f0f0f0;
    touch-action: pan-y;
  }

  .booty-workouts__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }

  .booty-workouts__slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .booty-workouts__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .booty-workouts__video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #000;
  }

  .booty-workouts__thumbs {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .booty-workouts__thumbs::-webkit-scrollbar {
    display: none;
  }

  .booty-workouts__thumb {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 4px;
    background: #f0f0f0;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 200ms ease;
  }

  .booty-workouts__thumb--active {
    border-color: #b8a7d3;
  }

  .booty-workouts__thumb-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .booty-workouts__description {
    margin: 0;
    padding: 16px 20px 16px 22px;
    border-radius: 16px;
    border-left: 6px solid #b8a7d3;
    background: #f8f8f8;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.45;
  }

  .booty-workouts__description p {
    margin: 0;
  }

  .booty-workouts__offer-card {
    border: 1px solid #e8e8e8;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .booty-workouts__offer-card + .booty-workouts__tiers {
    margin-top: 16px;
  }

  .booty-workouts__offer-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 16px;
    background: linear-gradient(90deg, #d81b4d 0%, #f06a5e 55%, #f7a08f 100%);
    text-align: center;
  }

  .booty-workouts__offer-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .booty-workouts__offer-eyebrow {
    margin: 0;
    color: #fff;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 500;
  }

  .booty-workouts__offer-title {
    margin: 0;
    color: #fff600;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-size: clamp(1rem, 3.8vw, 1.25rem);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .booty-workouts__offer-sparkles {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    line-height: 0;
  }

  .booty-workouts__offer-sparkles svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .booty-workouts__offer-sparkles--right {
    transform: scaleX(-1);
  }

  .booty-workouts__offer-body {
    padding: 18px 20px 20px;
  }

  .booty-workouts__benefits {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .booty-workouts__benefit {
    position: relative;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.35;
    font-weight: 400;
    padding-left: 1.4em;
  }

  .booty-workouts__benefit::before {
    content: '⚡️';
    position: absolute;
    left: 0;
    top: 0;
    color: #000;
  }

  .booty-workouts__tiers {
    display: grid;
    gap: 16px;
  }

  .booty-workouts__tier {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    overflow: visible;
  }

  .booty-workouts__tier-surface {
    display: block;
    padding: 16px;
    border: 1px solid #f0f0f0;
    border-radius: 16px;
    background: #fff;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .booty-workouts__tier.is-selected .booty-workouts__tier-surface {
    border: 3px solid #b8a7d3;
    box-shadow: 0 8px 24px rgba(184, 167, 211, 0.25);
  }

  .booty-workouts__tier:not(.booty-workouts__tier--has-ribbon):not(.is-selected) .booty-workouts__tier-surface {
    border: 1px solid #e0e0e0;
  }

  .booty-workouts__tier--has-ribbon {
    margin-top: 12px;
  }

  .booty-workouts__tier-ribbon {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%) translateY(-100%);
    padding: 6px 16px;
    border: 3px solid #b8a7d3;
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: #b8a7d3;
    color: #fff;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 700;
    white-space: nowrap;
    text-align: center;
  }

  .booty-workouts__tier--has-ribbon:not(.is-selected) .booty-workouts__tier-ribbon {
    border-color: #f0f0f0;
    background: #fafafa;
    color: #666;
  }

  .booty-workouts__tier-header {
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .booty-workouts__tier-main {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .booty-workouts__tier-details {
    overflow: hidden;
    max-height: 0;
    transition: max-height 320ms ease;
  }

  .booty-workouts__tier.is-expanded .booty-workouts__tier-details {
    max-height: none;
  }

  .booty-workouts__tier-details-inner {
    margin-top: 0;
    padding-top: 0;
    border-top: 1px solid transparent;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 260ms ease,
      transform 320ms ease,
      padding-top 320ms ease,
      margin-top 320ms ease,
      border-color 320ms ease;
  }

  .booty-workouts__tier.is-expanded .booty-workouts__tier-details-inner {
    margin-top: 14px;
    padding-top: 14px;
    border-top-color: #f0f0f0;
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .booty-workouts__tier-details,
    .booty-workouts__tier-details-inner {
      transition: none;
    }
  }

  .booty-workouts__tier-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .booty-workouts__tier-features--inline-extra {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
  }

  .booty-workouts__tier-feature,
  .booty-workouts__tier-extra {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
  }

  .booty-workouts__tier-feature-icon {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .booty-workouts__tier-feature-icon--check {
    color: #000;
  }

  .booty-workouts__tier-feature-icon--check svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .booty-workouts__tier-feature-icon--emoji {
    flex-basis: auto;
    width: auto;
    font-size: 16px;
  }

  .booty-workouts__tier-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #f0f0f0;
  }

  .booty-workouts__tier-thumb {
    flex: 0 0 auto;
    width: fit-content;
    height: fit-content;
    border-radius: 12px;
    overflow: hidden;
    background: #f0f0f0;
    line-height: 0;
  }

  .booty-workouts__tier-thumb img {
    width: auto;
    height: auto;
    max-height: 52px;
    display: block;
  }

  .booty-workouts__tier-copy {
    flex: 1;
    min-width: 0;
  }

  .booty-workouts__tier-title {
    display: block;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 800;
  }

  .booty-workouts__tier-pricing {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    margin-left: auto;
  }

  .booty-workouts__tier-prices {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 8px;
  }

  .booty-workouts__tier-old {
    color: #666;
    font-size: 14px;
    text-decoration: line-through;
  }

  .booty-workouts__tier-price {
    color: #000;
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
  }

  .booty-workouts__tier-discount {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff600;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 800;
    white-space: nowrap;
  }

  .booty-workouts__cta {
    width: 100%;
    min-height: 60px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(1rem, 1.7vw, 1.125rem);
    font-weight: 700;
    transition: background-color 160ms ease;
  }

  .booty-workouts__cta:hover {
    background: #1b1b1b;
  }

  .booty-workouts__cta-arrow {
    width: 20px;
    height: 20px;
  }

  .booty-workouts__cta-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .booty-workouts__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 20px;
  }

  .booty-workouts__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
  }

  .booty-workouts__trust-icon {
    width: 16px;
    height: 16px;
    line-height: 0;
  }

  .booty-workouts__trust-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .booty-workouts__secure-checkout {
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
  }

  .booty-workouts__secure-label {
    margin: 0;
    color: #666;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-style: italic;
    font-weight: 400;
  }

  .booty-workouts__payment-strip {
    width: 100%;
    max-width: 520px;
  }

  .booty-workouts__payment-strip-img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .booty-workouts__reviews {
    display: grid;
    gap: 12px;
  }

  .booty-workouts__reviews--slider {
    gap: 0;
  }

  .booty-workouts__reviews--slider .booty-workouts__review {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms ease, visibility 320ms ease;
  }

  .booty-workouts__reviews--slider .booty-workouts__review.is-active {
    opacity: 1;
    visibility: visible;
  }

  .booty-workouts__review {
    display: flex;
    gap: 12px;
    padding: 16px;
    border: 1px solid #f0f0f0;
    border-radius: 16px;
    background: #fff;
  }

  .booty-workouts__review-avatar {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: #f0f0f0;
  }

  .booty-workouts__review-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .booty-workouts__review-copy {
    flex: 1;
    min-width: 0;
  }

  .booty-workouts__review-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .booty-workouts__review-title {
    margin: 0;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 800;
  }

  .booty-workouts__review-stars {
    display: flex;
    flex-shrink: 0;
