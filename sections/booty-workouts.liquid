  .booty-workouts__faq-answer p {
    margin: 0;
  }

  .booty-workouts .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    .booty-workouts {
      overflow-x: clip;
      padding-left: 16px;
      padding-right: 16px;
    }

    .booty-workouts__container,
    .booty-workouts__grid,
    .booty-workouts__media,
    .booty-workouts__body,
    .booty-workouts__image-wrap,
    .booty-workouts__tier-main,
    .booty-workouts__offer-banner,
    .booty-workouts__thumbs {
      min-width: 0;
      max-width: 100%;
    }

    .booty-workouts__title,
    .booty-workouts__title-line,
    .booty-workouts__rating-subline {
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .booty-workouts__tier-ribbon {
      max-width: calc(100% - 24px);
      white-space: normal;
    }
  }

  @media (min-width: 768px) {
    .booty-workouts {
      padding-left: 32px;
      padding-right: 32px;
    }

    .booty-workouts__grid {
      grid-template-columns: minmax(0, 582px) minmax(0, 1fr);
      gap: 40px;
      align-items: start;
    }

    .booty-workouts__details {
      display: block;
    }

    .booty-workouts__head,
    .booty-workouts__media,
    .booty-workouts__body {
      order: unset;
    }

    .booty-workouts__media {
      position: sticky;
      top: 24px;
    }

    .booty-workouts__image-wrap {
      aspect-ratio: 582 / 554;
    }

    .booty-workouts__thumb {
      width: 56px;
      height: 56px;
    }

    .booty-workouts__body {
      margin-top: 0;
    }

    .booty-workouts__starting-price {
      margin-top: 10px;
    }

    .booty-workouts__title {
      font-size: 35px;
    }

    .booty-workouts__cta {
      min-height: 68px;
    }

    .booty-workouts__offer-banner {
      padding: 16px 24px;
      gap: 16px;
    }

    .booty-workouts__offer-eyebrow {
      font-size: 14px;
    }

    .booty-workouts__offer-title {
      font-size: 22px;
    }

    .booty-workouts__offer-sparkles {
      width: 48px;
      height: 48px;
    }

    .booty-workouts__offer-body {
      padding: 22px 24px 24px;
    }

    .booty-workouts__offer-card + .booty-workouts__tiers {
      margin-top: 24px;
    }

    .booty-workouts__tier-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 16px;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('{{ booty_workouts_anchor | escape }}');
    if (!section) return;
    const shouldSyncBundleBuilderPreselect = {{ cta_opens_bundle_builder | json }};

    const tiersRoot = section.querySelector('[data-booty-workouts-tiers]');
    if (tiersRoot) {
      const tiers = Array.from(tiersRoot.querySelectorAll('[data-booty-workouts-tier]'));

      const syncBundleBuilderPreselect = () => {
        if (!shouldSyncBundleBuilderPreselect || typeof window === 'undefined') return;

        const expandedTier = tiers.find((tier) => tier.classList.contains('is-expanded'));
        let programIndex = 0;

        if (expandedTier) {
          programIndex = Number.parseInt(expandedTier.getAttribute('data-booty-workouts-program-index') || '0', 10);
          if (!Number.isFinite(programIndex) || programIndex < 0) programIndex = 0;
        }

        window.__bt_bb_preselect_program_index = programIndex;
        window.__bt_bb_preselect_first = programIndex === 0;
        window.__bt_bb_preselect_second = programIndex === 1;
      };

      const syncCartCtaVariant = () => {
        if (typeof window.nassSyncBootyWorkoutsCartCta === 'function') {
          window.nassSyncBootyWorkoutsCartCta(section);
        }
      };

      const setSelectedTier = (tier) => {
        const input = tier.querySelector('input[type="radio"]');
        if (input) input.checked = true;

        tiers.forEach((item) => {
          item.classList.toggle('is-selected', item === tier);
        });
        syncCartCtaVariant();
      };

      const measureDetailsHeight = (details) => {
        const previousMaxHeight = details.style.maxHeight;
        details.style.maxHeight = 'none';
        const height = details.scrollHeight;
        details.style.maxHeight = previousMaxHeight;
        return height;
      };

      const collapseTier = (tier) => {
        const details = tier.querySelector('[data-booty-workouts-tier-details]');
        const toggle = tier.querySelector('[data-booty-workouts-tier-toggle]');
        tier.classList.remove('is-expanded');

        if (details) {
          if (details.style.maxHeight === 'none' || details.style.maxHeight === '') {
            details.style.maxHeight = measureDetailsHeight(details) + 'px';
          }
          window.requestAnimationFrame(() => {
            details.style.maxHeight = '0px';
          });
        }
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      };

      const expandTier = (tier, { instant = false } = {}) => {
        const details = tier.querySelector('[data-booty-workouts-tier-details]');
        const toggle = tier.querySelector('[data-booty-workouts-tier-toggle]');
        if (!details) return;

        tier.classList.add('is-expanded');

        if (instant) {
          details.style.maxHeight = 'none';
        } else {
          const targetHeight = measureDetailsHeight(details);
          details.style.maxHeight = '0px';
          window.requestAnimationFrame(() => {
            details.style.maxHeight = targetHeight + 'px';
          });
        }

        if (toggle) toggle.setAttribute('aria-expanded', 'true');
      };

      const refreshExpandedHeights = () => {
        tiers.forEach((tier) => {
          if (!tier.classList.contains('is-expanded')) return;
          const details = tier.querySelector('[data-booty-workouts-tier-details]');
          if (!details) return;
          details.style.maxHeight = 'none';
        });
      };

      tiers.forEach((tier) => {
        const details = tier.querySelector('[data-booty-workouts-tier-details]');
        if (!details) return;

        details.addEventListener('transitionend', (event) => {
          if (event.propertyName !== 'max-height') return;
          if (!tier.classList.contains('is-expanded')) return;
          details.style.maxHeight = 'none';
        });
      });

      tiers.forEach((tier) => {
        const toggle = tier.querySelector('[data-booty-workouts-tier-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const hasDetails = !!tier.querySelector('[data-booty-workouts-tier-details]');
          const wasSelected = tier.classList.contains('is-selected');
          const wasExpanded = tier.classList.contains('is-expanded');

          setSelectedTier(tier);
          if (!hasDetails) return;

          if (wasSelected && wasExpanded) {
            collapseTier(tier);
            syncBundleBuilderPreselect();
            return;
          }

          tiers.forEach((item) => {
            if (item !== tier) collapseTier(item);
          });
          expandTier(tier);
          syncBundleBuilderPreselect();
        });
      });

      window.addEventListener('resize', refreshExpandedHeights);

      tiersRoot.addEventListener('change', (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'radio') return;

        const tier = input.closest('[data-booty-workouts-tier]');
        if (!tier) return;

        setSelectedTier(tier);
      });

      const initialTier = tiers.find((tier) => tier.querySelector('input[type="radio"]:checked')) || tiers[0];
      const firstTier = tiers[0];

      if (initialTier) {
        setSelectedTier(initialTier);
      }

      if (firstTier && firstTier.querySelector('[data-booty-workouts-tier-details]')) {
        tiers.forEach((item) => {
          if (item !== firstTier) collapseTier(item);
        });
        expandTier(firstTier, { instant: true });
      }

      syncBundleBuilderPreselect();
    }

    const faqRoot = section.querySelector('[data-booty-workouts-faq]');
    if (faqRoot) {
      faqRoot.querySelectorAll('.booty-workouts__faq-item').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          faqRoot.querySelectorAll('.booty-workouts__faq-item').forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });
    }

    const galleryRoot = section.querySelector('[data-booty-workouts-gallery]');
    if (galleryRoot) {
      const slides = Array.from(galleryRoot.querySelectorAll('[data-booty-workouts-slide]'));
      const thumbsWrap = galleryRoot.querySelector('[data-booty-workouts-thumbs]');
      const imageWrap = galleryRoot.querySelector('.booty-workouts__image-wrap');
      if (!thumbsWrap || slides.length === 0) return;

      const showThumbs = slides.length > 1;
      thumbsWrap.hidden = !showThumbs;

      if (showThumbs && !thumbsWrap.querySelector('[data-booty-workouts-thumb]')) {
        slides.forEach((slide, index) => {
          const thumb = document.createElement('button');
          thumb.type = 'button';
          thumb.className = 'booty-workouts__thumb' + (index === 0 ? ' booty-workouts__thumb--active' : '');
          thumb.setAttribute('data-booty-workouts-thumb', '');
          thumb.setAttribute('data-slide-index', String(index));
          thumb.setAttribute('role', 'tab');
          thumb.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          thumb.setAttribute('aria-label', 'Slide ' + (index + 1));

          const slideImage = slide.querySelector('img');
          if (slideImage) {
            const thumbImage = document.createElement('img');
            thumbImage.className = 'booty-workouts__thumb-image';
            thumbImage.src = slideImage.currentSrc || slideImage.src;
            thumbImage.alt = slideImage.alt || '';
            thumbImage.loading = 'lazy';
            thumb.appendChild(thumbImage);
          }

          thumbsWrap.appendChild(thumb);
        });
      }

      const thumbs = Array.from(thumbsWrap.querySelectorAll('[data-booty-workouts-thumb]'));

      let activeIndex = slides.findIndex((slide) => slide.classList.contains('is-active'));
      if (activeIndex < 0) activeIndex = 0;

      const syncSlideVideos = () => {
        slides.forEach((slide, slideIndex) => {
          const video = slide.querySelector('video');
          if (!video) return;

          if (slideIndex === activeIndex) {
            if (slide.getAttribute('data-booty-workouts-video-autoplay') === 'true') {
              video.play().catch(() => {});
            }
            return;
          }

          video.pause();
          if (!video.loop) video.currentTime = 0;
        });
      };

      const scrollActiveThumbIntoView = () => {
        const activeThumb = thumbs[activeIndex];
        if (!activeThumb || !thumbsWrap) return;

        const thumbLeft = activeThumb.offsetLeft;
        const thumbWidth = activeThumb.offsetWidth;
        const wrapWidth = thumbsWrap.clientWidth;
        const maxScroll = Math.max(0, thumbsWrap.scrollWidth - wrapWidth);
        const targetScroll = thumbLeft - wrapWidth / 2 + thumbWidth / 2;

        thumbsWrap.scrollTo({
          left: Math.max(0, Math.min(targetScroll, maxScroll)),
          behavior: 'smooth',
        });
      };

      const goToSlide = (index, { scrollThumb = false } = {}) => {
        activeIndex = ((index % slides.length) + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === activeIndex);
        });
        thumbs.forEach((thumb, thumbIndex) => {
          const isActive = thumbIndex === activeIndex;
          thumb.classList.toggle('booty-workouts__thumb--active', isActive);
          thumb.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        syncSlideVideos();
        if (scrollThumb) scrollActiveThumbIntoView();
      };

      syncSlideVideos();

      if (slides.length < 2) return;

      const desktopMedia = window.matchMedia('(min-width: 768px)');
      let autoplayTimer = null;

      const pauseAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        pauseAutoplay();
        if (!desktopMedia.matches || slides.length < 2) return;
        autoplayTimer = window.setInterval(() => {
          goToSlide(activeIndex + 1);
        }, 7000);
      };

      const resetAutoplay = () => {
        if (!desktopMedia.matches) return;
        pauseAutoplay();
        startAutoplay();
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = Number.parseInt(thumb.getAttribute('data-slide-index') || '0', 10);
          goToSlide(index, { scrollThumb: true });
          resetAutoplay();
        });
      });

      if (imageWrap) {
        let touchStartX = 0;
        let touchStartY = 0;
        let touchTracking = false;

        imageWrap.addEventListener(
          'touchstart',
          (event) => {
            if (event.touches.length !== 1) return;
            touchStartX = event.touches[0].clientX;
            touchStartY = event.touches[0].clientY;
            touchTracking = true;
            pauseAutoplay();
          },
          { passive: true }
        );

        imageWrap.addEventListener(
          'touchend',
          (event) => {
            if (!touchTracking) return;
            touchTracking = false;
            if (event.changedTouches.length !== 1) {
              resetAutoplay();
              return;
            }

            const deltaX = event.changedTouches[0].clientX - touchStartX;
            const deltaY = event.changedTouches[0].clientY - touchStartY;
            if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY)) {
              resetAutoplay();
              return;
            }

            if (deltaX < 0) goToSlide(activeIndex + 1, { scrollThumb: true });
            else goToSlide(activeIndex - 1, { scrollThumb: true });
            resetAutoplay();
          },
          { passive: true }
        );

        imageWrap.addEventListener(
          'touchcancel',
          () => {
            touchTracking = false;
            resetAutoplay();
          },
          { passive: true }
        );
      }

      if (typeof desktopMedia.addEventListener === 'function') {
        desktopMedia.addEventListener('change', () => {
          if (desktopMedia.matches) startAutoplay();
          else pauseAutoplay();
        });
      } else if (typeof desktopMedia.addListener === 'function') {
        desktopMedia.addListener(() => {
          if (desktopMedia.matches) startAutoplay();
          else pauseAutoplay();
        });
      }

      startAutoplay();
    }

    if (typeof window.nassSyncBootyWorkoutsCartCta === 'function') {
      window.nassSyncBootyWorkoutsCartCta(section);
    }

    const bundleCta = section.querySelector('[data-booty-workouts-bundle-cta]');
    if (bundleCta) {
      function tryOpenBundleWizard(maxRetries) {
        maxRetries = typeof maxRetries === 'number' ? maxRetries : 25;
        var retries = 0;
        function tick() {
          if (window.NassBundleBuilder && typeof window.NassBundleBuilder.openWizard === 'function') {
            window.NassBundleBuilder.openWizard();
            return;
          }
          if (retries >= maxRetries) {
            window.location.hash = '#nass-bundle-builder';
            return;
          }
          retries += 1;
          setTimeout(tick, 100);
        }
        tick();
      }

      bundleCta.addEventListener('click', (event) => {
        event.preventDefault();
        const tiersRoot = section.querySelector('[data-booty-workouts-tiers]');
        if (tiersRoot && shouldSyncBundleBuilderPreselect) {
          const tiers = Array.from(tiersRoot.querySelectorAll('[data-booty-workouts-tier]'));
          const expandedTier = tiers.find((tier) => tier.classList.contains('is-expanded'));
          let programIndex = 0;

          if (expandedTier) {
            programIndex = Number.parseInt(expandedTier.getAttribute('data-booty-workouts-program-index') || '0', 10);
            if (!Number.isFinite(programIndex) || programIndex < 0) programIndex = 0;
          }

          window.__bt_bb_preselect_program_index = programIndex;
          window.__bt_bb_preselect_first = programIndex === 0;
          window.__bt_bb_preselect_second = programIndex === 1;
        }
        tryOpenBundleWizard(25);
      });
    }

    const reviewsRoot = section.querySelector('[data-booty-workouts-reviews]');
    if (reviewsRoot) {
      const reviews = Array.from(reviewsRoot.querySelectorAll('.booty-workouts__review'));
      if (reviews.length > 1) {
        let activeIndex = reviews.findIndex((review) => review.classList.contains('is-active'));
        if (activeIndex < 0) activeIndex = 0;

        const showReview = (index) => {
          reviews.forEach((review, reviewIndex) => {
            review.classList.toggle('is-active', reviewIndex === index);
          });
        };

        window.setInterval(() => {
          activeIndex = (activeIndex + 1) % reviews.length;
          showReview(activeIndex);
        }, 7000);
      }
    }
  })();
</script>

