      "info": "Used only if title lines below are empty."
    },
    { "type": "text", "id": "title_part_1", "label": "Title line 1", "default": "Booty" },
    { "type": "text", "id": "title_part_2", "label": "Title line 2", "default": "Workouts That" },
    { "type": "text", "id": "title_part_3", "label": "Title line 3", "default": "Feel Like Fun" },
    { "type": "text", "id": "starting_price", "label": "Starting from", "default": "Starting from just $59" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Twerk workouts from world-famous Nastya NASS help you tone your body, shape a beautiful booty, and make every workout fun and energizing.</p>"
    },
    { "type": "header", "content": "Benefits offer card" },
    {
      "type": "text",
      "id": "offer_banner_eyebrow",
      "label": "Banner eyebrow",
      "default": "Limited Time"
    },
    {
      "type": "text",
      "id": "offer_banner_title",
      "label": "Banner title",
      "default": "SUMMER START OFFER"
    },
    { "type": "header", "content": "Hero image / gallery" },
    {
