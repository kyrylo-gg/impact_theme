{% comment %}
  BT_AppAccess (Body Transformation)
  Based on lovable spec for AppAccessSection.tsx
{% endcomment %}

{%- liquid
  assign title_1 = section.settings.title_1 | default: 'Instant Access'
  assign title_2 = section.settings.title_2 | default: 'in the App'
  assign subtitle_mobile = section.settings.subtitle_mobile | default: "Start today. Follow the plan.\nStay consistent."
  assign subtitle_desktop = section.settings.subtitle_desktop | default: 'Start today. Follow the plan. Stay consistent.'
  assign footer_text = section.settings.footer_text | default: 'And when you stay consistent, the change becomes visible.'

  assign shopify_video_mobile = section.settings.video_mobile
  assign shopify_video_desktop = section.settings.video_desktop
  assign mp4_url_mobile = section.settings.video_url_mobile
  assign mp4_url_desktop = section.settings.video_url_desktop
  assign shopify_video_legacy = section.settings.video
  assign mp4_url_legacy = section.settings.video_url
  assign overlay_opacity = section.settings.overlay_opacity | default: 0.3
-%}

<section class="bt-wrap bt-app">
  <div class="bt-container bt-app__container">
    <div class="bt-app__banner">
      {%- assign mobile_video_to_use = shopify_video_mobile | default: shopify_video_legacy -%}
      {%- assign mobile_mp4_to_use = mp4_url_mobile | default: mp4_url_legacy -%}
      {%- assign desktop_video_to_use = shopify_video_desktop | default: shopify_video_legacy -%}
      {%- assign desktop_mp4_to_use = mp4_url_desktop | default: mp4_url_legacy -%}

      {%- if mobile_video_to_use != blank -%}
        <video class="bt-app__video bt-app__video--m" autoplay loop muted playsinline preload="auto">
          {%- for source in mobile_video_to_use.sources -%}
            {%- if source.mime_type == 'video/mp4' -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif mobile_mp4_to_use != blank -%}
        <video class="bt-app__video bt-app__video--m" autoplay loop muted playsinline preload="auto">
          <source src="{{ mobile_mp4_to_use }}" type="video/mp4">
        </video>
      {%- endif -%}

      {%- if desktop_video_to_use != blank -%}
        <video class="bt-app__video bt-app__video--d" autoplay loop muted playsinline preload="auto">
          {%- for source in desktop_video_to_use.sources -%}
            {%- if source.mime_type == 'video/mp4' -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif desktop_mp4_to_use != blank -%}
        <video class="bt-app__video bt-app__video--d" autoplay loop muted playsinline preload="auto">
          <source src="{{ desktop_mp4_to_use }}" type="video/mp4">
        </video>
      {%- endif -%}
      <div class="bt-app__overlay" style="opacity: {{ overlay_opacity }};" aria-hidden="true"></div>

      <div class="bt-app__center">
        <div class="bt-app__title">
          <span class="bt-app__w">{{ title_1 | escape }}</span><br>
          <span class="bt-app__y">{{ title_2 | escape }}</span>
        </div>
        <div class="bt-app__divider" aria-hidden="true"></div>
        <p class="bt-app__subtitle bt-app__subtitle--m">{{ subtitle_mobile | escape | newline_to_br }}</p>
        <p class="bt-app__subtitle bt-app__subtitle--d">{{ subtitle_desktop | escape }}</p>
      </div>
    </div>

    <p class="bt-app__footer bt-app__footer--m">{{ footer_text | escape }}</p>
    <p class="bt-app__footer bt-app__footer--d">{{ footer_text | escape }}</p>
  </div>
</section>

{% stylesheet %}
  .bt-wrap { width: 100%; display: flex; justify-content: center; padding: 24px 20px; box-sizing: border-box; }
  @media (min-width: 768px) { .bt-wrap { padding: 40px 0; } }
  .bt-container { width: 100%; max-width: 335px; }
  @media (min-width: 768px) { .bt-container { max-width: 1184px; } }

  .bt-app__banner { width: 100%; background: #000; border-radius: 30px; display: flex; align-items: center; justify-content: center; height: 560px; position: relative; overflow: hidden; }
  @media (min-width: 768px) { .bt-app__banner { height: 511px; } }

  .bt-app__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .bt-app__video--m { display: block; }
  .bt-app__video--d { display: none; }
  @media (min-width: 768px) {
    .bt-app__video--m { display: none; }
    .bt-app__video--d { display: block; }
  }
  .bt-app__overlay { position: absolute; inset: 0; background: #000; }

  .bt-app__center { text-align: center; padding: 0 28px; position: relative; z-index: 1; }
  @media (min-width: 768px) { .bt-app__center { padding: 0; } }

  .bt-app__title { margin: 0; font-family: 'Anybody', sans-serif; font-weight: 600; text-transform: uppercase; font-stretch: 150%; letter-spacing: 0.03em; font-size: 24px; line-height: 1.05; }
  @media (min-width: 768px) { .bt-app__title { font-size: 45px; } }
  .bt-app__w { color: #fff; }
  .bt-app__y { color: #FAFF00; font-weight: 900; }

  .bt-app__divider { width: 48px; height: 3px; background: #FAFF00; margin: 12px auto; }
  @media (min-width: 768px) { .bt-app__divider { margin-top: 16px; margin-bottom: 16px; } }

  .bt-app__subtitle { margin: 0; color: #fff; font-family: Avenir, 'Nunito Sans', system-ui, sans-serif; font-weight: 500; }
  .bt-app__subtitle--m { font-size: 16px; max-width: 279px; margin: 0 auto; display: block; line-height: 1.35; }
  .bt-app__subtitle--d { display: none; }
  @media (min-width: 768px) {
    .bt-app__subtitle--m { display: none; }
    .bt-app__subtitle--d { display: block; font-size: 24px; }
  }

  .bt-app__footer { margin: 32px 0 0; text-align: center; font-family: Avenir, 'Nunito Sans', system-ui, sans-serif; font-weight: 500; color: #8A8A8A; }
  .bt-app__footer--m { font-size: 14px; display: block; }
  .bt-app__footer--d { display: none; font-size: 18px; }
  @media (min-width: 768px) {
    .bt-app__footer { margin-top: 32px; }
    .bt-app__footer--m { display: none; }
    .bt-app__footer--d { display: block; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BT_AppAccess",
  "class": "shopify-section--bt-app-access",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Video background (optional)" },
    { "type": "video", "id": "video_mobile", "label": "Mobile Shopify video (Files)" },
    { "type": "url", "id": "video_url_mobile", "label": "Mobile fallback MP4 URL (optional)" },
    { "type": "video", "id": "video_desktop", "label": "Desktop Shopify video (Files)" },
    { "type": "url", "id": "video_url_desktop", "label": "Desktop fallback MP4 URL (optional)" },
    { "type": "header", "content": "Legacy fallback (optional)" },
    { "type": "video", "id": "video", "label": "Legacy Shopify video (used if mobile/desktop are empty)" },
    { "type": "url", "id": "video_url", "label": "Legacy MP4 URL (used if mobile/desktop are empty)" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 1, "step": 0.1, "default": 0.3 },
    { "type": "text", "id": "title_1", "label": "Title part 1 (white)", "default": "Instant Access" },
    { "type": "text", "id": "title_2", "label": "Title part 2 (yellow)", "default": "in the App" },
    { "type": "textarea", "id": "subtitle_mobile", "label": "Subtitle (mobile)", "default": "Start today. Follow the plan.\nStay consistent." },
    { "type": "text", "id": "subtitle_desktop", "label": "Subtitle (desktop)", "default": "Start today. Follow the plan. Stay consistent." },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "And when you stay consistent, the change becomes visible." }
  ],
  "presets": [{ "name": "BT_AppAccess" }]
}
{% endschema %}

