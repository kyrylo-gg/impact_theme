{%- liquid
  assign hb_mobile_video = section.settings.mobile_video
  if hb_mobile_video == blank
    assign hb_mobile_video = section.settings.video
  endif

  assign hb_poster = section.settings.poster
  if hb_poster == blank and section.settings.video != blank and section.settings.video.preview_image != blank
    assign hb_poster = section.settings.video.preview_image
  endif

  assign hb_heading_tag = 'h2'
  if section.index == 1
    assign hb_heading_tag = 'h1'
  endif
-%}

{{ 'hero-banner-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-banner-video.js' | asset_url }}" defer></script>

<section
  class="hero-banner"
  data-section-id="{{ section.id }}"
  id="hero-banner-video-{{ section.id }}"
>
  <div class="hero-banner__media">
    {%- if hb_poster != blank -%}
      {{
        hb_poster
        | image_url: width: 1600
        | image_tag:
          class: 'hero-banner__poster',
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          widths: '750,1100,1600'
      }}
    {%- endif -%}

    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          class: 'hero-banner__video hero-banner__video--desktop',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          preload: 'metadata',
          playsinline: true,
          image_size: '1600x',
          aria-hidden: 'true'
      }}
    {%- endif -%}

    {%- if hb_mobile_video != blank -%}
      {{
        hb_mobile_video
        | video_tag:
          class: 'hero-banner__video hero-banner__video--mobile',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          preload: 'metadata',
          playsinline: true,
          image_size: '800x',
          aria-hidden: 'true'
      }}
    {%- endif -%}

    <div class="hero-banner__overlay" aria-hidden="true"></div>

    <div class="hero-banner__content">
      <div class="hero-banner__content-inner">
        <div class="hero-banner__panel">
          {%- if section.settings.flash_sale_text != blank -%}
            <div class="hero-banner__flash">
              {{ section.settings.flash_sale_text }}
            </div>
          {%- endif -%}

          <div class="hero-banner__card">
            {%- if section.settings.title != blank -%}
              <{{ hb_heading_tag }} class="hero-banner__title">{{ section.settings.title | escape }}</{{ hb_heading_tag }}>
            {%- endif -%}

            {%- if section.settings.subtitle != blank -%}
              <p class="hero-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
            {%- endif -%}

            <div class="hero-banner__divider" aria-hidden="true"></div>

            {%- if section.settings.description != blank -%}
              <div class="hero-banner__description">{{ section.settings.description }}</div>
            {%- endif -%}
          </div>

          {%- if section.settings.cta_text != blank -%}
            <a
              class="hero-banner__cta hero-banner__cta--desktop"
              href="{{ section.settings.cta_link | default: '#nass-bundle-builder' }}"
              data-analytics="hero_cta"
              aria-label="{{ section.settings.cta_text | escape }}"
            >
              <span>{{ section.settings.cta_text | escape }}</span>
              {% render 'icon-hb-arrow-right' %}
            </a>
          {%- endif -%}

          <div class="hero-banner__trust hero-banner__trust--desktop">
            <div class="hero-banner__rating">
              {% render 'icon-hb-user' %}
              <strong>{{ section.settings.students_count | escape }}</strong>
              {% render 'icon-hb-stars' %}
              <span>{{ section.settings.rating | escape }}</span>
            </div>
            <div class="hero-banner__benefits">
              {%- if section.settings.benefit_1 != blank -%}
                <span>{% render 'icon-hb-lock' %} {{ section.settings.benefit_1 | escape }}</span>
              {%- endif -%}
              {%- if section.settings.benefit_2 != blank -%}
                <span>{% render 'icon-hb-check' %} {{ section.settings.benefit_2 | escape }}</span>
              {%- endif -%}
              {%- if section.settings.benefit_3 != blank -%}
                <span>{% render 'icon-hb-truck' %} {{ section.settings.benefit_3 | escape }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.show_review -%}
            <div class="hero-banner__review hero-banner__review--desktop">
              {%- if section.settings.review_avatar != blank -%}
                {{
                  section.settings.review_avatar
                  | image_url: width: 96
                  | image_tag:
                    class: 'hero-banner__review-avatar',
                    loading: 'lazy',
                    alt: '',
                    width: 48,
                    height: 48
                }}
              {%- endif -%}
              <div>
                <div class="hero-banner__review-name">
                  {{ section.settings.review_name | escape }}
                  {% render 'icon-hb-stars' %}
                </div>
                {%- if section.settings.review_text != blank -%}
                  <p class="hero-banner__review-text">{{ section.settings.review_text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if section.settings.show_marquee and section.settings.marquee_text != blank -%}
      <div class="hero-banner__marquee-wrap">
        {% render 'hero-banner-marquee', text: section.settings.marquee_text %}
      </div>
    {%- endif -%}
  </div>

  <div class="hero-banner__below">
    {%- if section.settings.cta_text != blank -%}
      <a
        class="hero-banner__cta"
        href="{{ section.settings.cta_link | default: '#nass-bundle-builder' }}"
        data-analytics="hero_cta"
        aria-label="{{ section.settings.cta_text | escape }}"
      >
        <span>{{ section.settings.cta_text | escape }}</span>
        {% render 'icon-hb-arrow-right' %}
      </a>
    {%- endif -%}

    <div class="hero-banner__trust">
      <div class="hero-banner__rating">
        {% render 'icon-hb-user' %}
        <strong>{{ section.settings.students_count | escape }}</strong>
        {% render 'icon-hb-stars' %}
        <span>{{ section.settings.rating | escape }}</span>
      </div>
      <div class="hero-banner__benefits">
        {%- if section.settings.benefit_1 != blank -%}
          <span>{% render 'icon-hb-lock' %} {{ section.settings.benefit_1 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.benefit_2 != blank -%}
          <span>{% render 'icon-hb-check' %} {{ section.settings.benefit_2 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.benefit_3 != blank -%}
          <span>{% render 'icon-hb-truck' %} {{ section.settings.benefit_3 | escape }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_review -%}
      <div class="hero-banner__review">
        {%- if section.settings.review_avatar != blank -%}
          {{
            section.settings.review_avatar
            | image_url: width: 96
            | image_tag:
              class: 'hero-banner__review-avatar',
              loading: 'lazy',
              alt: '',
              width: 48,
              height: 48
          }}
        {%- endif -%}
        <div>
          <div class="hero-banner__review-name">
            {{ section.settings.review_name | escape }}
            {% render 'icon-hb-stars' %}
          </div>
          {%- if section.settings.review_text != blank -%}
            <p class="hero-banner__review-text">{{ section.settings.review_text | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Video",
  "tag": "section",
  "class": "shopify-section--hero-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (desktop)"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Video (mobile)"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image (fallback)"
    },
    {
      "type": "header",
      "content": "Flash sale pill"
    },
    {
      "type": "richtext",
      "id": "flash_sale_text",
      "label": "Flash sale text",
      "default": "<p><strong>FLASH SALE:</strong> All 7 NASS Programs for $199 (<strong>81% Off</strong>)</p>"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "STOP HIDING"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "For Stiff Hips, Zero Rhythm, and Feeling Like Your Body Won't Listen to You"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the system that turned <strong>40,000+ women</strong> into confident dancers — now every Nastya Nass program in one bundle, <u>built for the modern woman</u>.</p>"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "START TWERKING LIKE A PRO"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Trust row"
    },
    {
      "type": "text",
      "id": "students_count",
      "label": "Students count",
      "default": "40,000+ Students"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8/5"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Lifetime Access"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "30-Day Money Back Guarantee"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "Review card"
    },
    {
      "type": "checkbox",
      "id": "show_review",
      "label": "Show review card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "review_avatar",
      "label": "Review avatar"
    },
    {
      "type": "text",
      "id": "review_name",
      "label": "Review name",
      "default": "Annie C."
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review text",
      "default": "Best booty-shaking class out there. Clear instructions, I go at my own pace — and I'm already seeing progress!"
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show marquee",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "ALL 7 PROGRAMS · $199"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Video"
    }
  ]
}
{% endschema %}
