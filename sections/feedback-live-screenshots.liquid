{% comment %}
  Feedback — Live screenshots.
  Collage of review/Instagram screenshots. Adaptive layout per Figma Feedback-NASS.
  Breakpoints: 480, 640, 768, 1024 (responsive-design.mdc)
  Mobile: 1 column, row can have 1 or 2 images (proportional + gap).
  Desktop: 2 columns, same row logic in each column.
{% endcomment %}

<section
  class="feedback-screenshots"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="feedback-screenshots__inner">
    <div class="feedback-screenshots__collage">
      <div class="feedback-screenshots__heading">
        {{ section.settings.heading | default: "The twerk program everyone's" | escape }}
        <span class="feedback-screenshots__heading-highlight">{{ section.settings.heading_highlight | default: "excited about" | escape }}</span>
      </div>

      <div class="feedback-screenshots__grid">
      {% assign blocks = section.blocks %}
      {% assign skip_next = false %}
      {% for block in blocks %}
        {% if block.type != 'screenshot' %}{% continue %}{% endif %}
        {% if skip_next %}
          {% assign skip_next = false %}
          {% continue %}
        {% endif %}

        {% assign next_idx = forloop.index %}
        {% assign next_block = blocks[next_idx] %}
        {% assign is_pair = false %}
        {% if block.settings.row_share == 'half' and next_block != blank and next_block.type == 'screenshot' and next_block.settings.row_share == 'half' %}
          {% assign is_pair = true %}
        {% endif %}

        {% if is_pair %}
          <div class="feedback-screenshots__row feedback-screenshots__row--pair">
            {% comment %} First item {% endcomment %}
            {% if block.settings.image != blank %}
              {% assign img = block.settings.image %}
              <div class="feedback-screenshots__item feedback-screenshots__item--{{ block.settings.size | default: 'default' }}" {{ block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">
                  <img
                    src="{{ img | image_url: width: 800 }}"
                    srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 800 }} 800w"
                    sizes="(max-width: 767px) 45vw, 22vw"
                    loading="lazy"
                    width="{{ img.width }}"
                    height="{{ img.height }}"
                    alt=""
                    class="feedback-screenshots__img"
                  >
                  {% if block.settings.highlight %}<span class="feedback-screenshots__highlight" aria-hidden="true"></span>{% endif %}
                </div>
              </div>
            {% else %}
              <div class="feedback-screenshots__item feedback-screenshots__item--placeholder" {{ block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">{{ 'image' | placeholder_svg_tag: 'feedback-screenshots__placeholder' }}</div>
              </div>
            {% endif %}
            {% comment %} Second item {% endcomment %}
            {% if next_block.settings.image != blank %}
              {% assign next_img = next_block.settings.image %}
              <div class="feedback-screenshots__item feedback-screenshots__item--{{ next_block.settings.size | default: 'default' }}" {{ next_block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">
                  <img
                    src="{{ next_img | image_url: width: 800 }}"
                    srcset="{{ next_img | image_url: width: 300 }} 300w, {{ next_img | image_url: width: 500 }} 500w, {{ next_img | image_url: width: 800 }} 800w"
                    sizes="(max-width: 767px) 45vw, 22vw"
                    loading="lazy"
                    width="{{ next_img.width }}"
                    height="{{ next_img.height }}"
                    alt=""
                    class="feedback-screenshots__img"
                  >
                  {% if next_block.settings.highlight %}<span class="feedback-screenshots__highlight" aria-hidden="true"></span>{% endif %}
                </div>
              </div>
            {% else %}
              <div class="feedback-screenshots__item feedback-screenshots__item--placeholder" {{ next_block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">{{ 'image' | placeholder_svg_tag: 'feedback-screenshots__placeholder' }}</div>
              </div>
            {% endif %}
          </div>
          {% assign skip_next = true %}
        {% else %}
          <div class="feedback-screenshots__row">
            {% if block.settings.image != blank %}
              {% assign img = block.settings.image %}
              <div class="feedback-screenshots__item feedback-screenshots__item--{{ block.settings.size | default: 'default' }}" {{ block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">
                  <img
                    src="{{ img | image_url: width: 800 }}"
                    srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 800 }} 800w"
                    sizes="(max-width: 767px) 100vw, 50vw"
                    loading="lazy"
                    width="{{ img.width }}"
                    height="{{ img.height }}"
                    alt=""
                    class="feedback-screenshots__img"
                  >
                  {% if block.settings.highlight %}<span class="feedback-screenshots__highlight" aria-hidden="true"></span>{% endif %}
                </div>
              </div>
            {% else %}
              <div class="feedback-screenshots__item feedback-screenshots__item--placeholder" {{ block.shopify_attributes }}>
                <div class="feedback-screenshots__img-wrap">{{ 'image' | placeholder_svg_tag: 'feedback-screenshots__placeholder' }}</div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
      </div>
    </div>

    {% if section.settings.show_pop_booty_footer %}
      {% assign quote_review_blocks = section.blocks | where: 'type', 'quote_review' %}
      {% if quote_review_blocks.size > 0 %}
        <div class="feedback-screenshots__quote-reviews">
          {% for block in quote_review_blocks %}
            {% assign review_rating = block.settings.rating | default: 5 | plus: 0 %}
            <article class="feedback-screenshots__quote-card" {{ block.shopify_attributes }}>
              {% if block.settings.quote != blank %}
                <p class="feedback-screenshots__quote-text">{{ block.settings.quote | escape }}</p>
              {% endif %}
              <div class="feedback-screenshots__quote-meta">
                <div class="feedback-screenshots__quote-author">
                  {% if block.settings.avatar != blank %}
                    {{
                      block.settings.avatar
                      | image_url: width: 80
                      | image_tag:
                        class: 'feedback-screenshots__quote-avatar',
                        loading: 'lazy',
                        alt: block.settings.name
                    }}
                  {% else %}
                    <span class="feedback-screenshots__quote-avatar feedback-screenshots__quote-avatar--placeholder" aria-hidden="true"></span>
                  {% endif %}
                  {% if block.settings.name != blank %}
                    <span class="feedback-screenshots__quote-name">{{ block.settings.name | escape }}</span>
                  {% endif %}
                </div>
                <div class="feedback-screenshots__quote-stars" role="img" aria-label="{{ review_rating }} out of 5 stars">
                  {% for i in (1..5) %}
                    <svg class="feedback-screenshots__quote-star{% if i <= review_rating %} feedback-screenshots__quote-star--filled{% endif %}" viewBox="0 0 24 24" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% endfor %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.reviews_footer != blank %}
        <p class="feedback-screenshots__reviews-footer">{{ section.settings.reviews_footer | escape }}</p>
      {% endif %}
    {% endif %}

    {% render 'pop-booty-cta-trust', section: section %}
  </div>
</section>

{% stylesheet %}
  .feedback-screenshots {
    --fls-bg: rgba(0, 0, 0, 0.06);
    --fls-primary: var(--nass-primary, #0038FF);
    --fls-highlight: #FAFF00;
    --fls-radius: 30px;
    --fls-inner-radius: 20px;
    --fls-font-display: var(--font-heading--family, 'Anybody'), system-ui, sans-serif;
  }

  .feedback-screenshots {
    margin-top: 1.5rem;
    background: transparent;
  }
  @media (min-width: 1024px) {
    .feedback-screenshots { margin-top: 2rem; }
  }

  /* Gray background only on heading + screenshot collage */
  .feedback-screenshots__collage {
    background: var(--fls-bg);
    border-radius: 24px;
    padding: 2.5rem 0;
  }
  @media (min-width: 640px) {
    .feedback-screenshots__collage { padding: 3rem 0; }
  }
  @media (min-width: 1024px) {
    .feedback-screenshots__collage { padding: 4rem 0; }
  }

  .feedback-screenshots__inner {
    max-width: none;
    width: 100%;
    padding: 0 1rem 2rem;
  }
  @media (min-width: 480px) {
    .feedback-screenshots__inner { padding: 0 1.25rem 2.5rem; }
  }
  @media (min-width: 768px) {
    .feedback-screenshots__inner { padding: 0 1.5rem 3rem; }
  }
  @media (min-width: 1024px) {
    .feedback-screenshots__inner { padding: 0 2rem 3rem; }
  }

  .feedback-screenshots__heading {
    font-family: var(--fls-font-display);
    font-weight: 900;
    font-stretch: 150%;
    letter-spacing: 0.03em;
    line-height: 100%;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-foreground, #000);
    margin: 0 0 18px 0;
    padding: 0 8px;
    font-size: 30px;
  }
  .feedback-screenshots__heading-highlight {
    color: var(--fls-primary);
    display: inline;
  }
  @media (min-width: 768px) {
    .feedback-screenshots__heading {
      font-size: 48px;
    }
  }

  /* Mobile: 1 column, rows with 1 or 2 images */
  .feedback-screenshots__grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 480px) {
    .feedback-screenshots__grid { gap: 1.25rem; }
  }

  /* Single image row */
  .feedback-screenshots__row {
    width: 100%;
  }

  /* Pair row: 2 images side by side, proportional, gap between */
  .feedback-screenshots__row--pair {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }
  @media (min-width: 480px) {
    .feedback-screenshots__row--pair { gap: 1rem; }
  }
  .feedback-screenshots__row--pair .feedback-screenshots__item {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Desktop: 2 columns, same row logic in each */
  @media (min-width: 768px) {
    .feedback-screenshots__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      align-items: start;
    }
    .feedback-screenshots__row {
      break-inside: avoid;
    }
  }
  @media (min-width: 1024px) {
    .feedback-screenshots__grid {
      gap: 1.5rem;
    }
  }

  .feedback-screenshots__item {
    position: relative;
  }

  /* Responsive image containers — size to image, no fixed height */
  .feedback-screenshots__img-wrap {
    position: relative;
    border-radius: var(--fls-inner-radius);
    overflow: hidden;
    background: hsl(0, 0%, 92%);
    line-height: 0;
  }
  .feedback-screenshots__img-wrap .feedback-screenshots__img {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: top;
  }
  .feedback-screenshots__img-wrap .feedback-screenshots__placeholder {
    width: 100%;
    height: auto;
    display: block;
  }

  .feedback-screenshots__placeholder {
    opacity: 0.4;
  }

  .feedback-screenshots__highlight {
    position: absolute;
    inset: -2px;
    border: 2px solid var(--fls-highlight);
    border-radius: var(--fls-inner-radius);
    pointer-events: none;
  }

  .feedback-screenshots__quote-reviews {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .feedback-screenshots__quote-reviews {
      margin-top: 2.5rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
    }
  }

  .feedback-screenshots__quote-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    border: 1px solid #f0f0f0;
    border-radius: 16px;
    background: #fff;
    text-align: left;
  }

  .feedback-screenshots__quote-text {
    margin: 0;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    font-style: italic;
  }

  @media (min-width: 768px) {
    .feedback-screenshots__quote-text {
      font-size: 18px;
    }
  }

  .feedback-screenshots__quote-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .feedback-screenshots__quote-author {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .feedback-screenshots__quote-avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .feedback-screenshots__quote-avatar--placeholder {
    background: #e8e8e8;
  }

  .feedback-screenshots__quote-name {
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 800;
  }

  .feedback-screenshots__quote-stars {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2px;
  }

  .feedback-screenshots__quote-star {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #f5b301;
    stroke-width: 1.5;
  }

  .feedback-screenshots__quote-star--filled {
    fill: #f5b301;
    stroke: #f5b301;
  }

  .feedback-screenshots__reviews-footer {
    margin: 24px 0 0;
    text-align: center;
    color: #000;
    font-family: var(--font-body--family, 'Avenir'), 'Avenir', 'Avenir Next', Arial, sans-serif;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.25;
    font-weight: 800;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feedback Screenshots",
  "class": "feedback-screenshots-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The twerk program everyone's"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "default": "excited about"
    },
    {
      "type": "header",
      "content": "Pop Booty"
    },
    {
      "type": "text",
      "id": "reviews_footer",
      "label": "Reviews footer line",
      "default": "Experienced by over 6,000 girls",
      "info": "Shown below quote review cards when Pop Booty footer is enabled."
    },
    {
      "type": "checkbox",
      "id": "show_pop_booty_footer",
      "label": "Enable Pop Booty footer (quote reviews, CTA & trust badges)",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Booty Programs"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1",
      "default": "30-Day Money-Back Guarantee"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2",
      "default": "World-Famous support"
    }
  ],
  "blocks": [
    {
      "type": "screenshot",
      "name": "Screenshot",
      "limit": 20,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "row_share",
          "label": "Row",
          "default": "full",
          "info": "Full = one image per row. Half = two images share row (pair with next Half).",
          "options": [
            { "value": "full", "label": "Full row" },
            { "value": "half", "label": "Half (pair with next Half)" }
          ]
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "default",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "wide", "label": "Wide" },
            { "value": "tall", "label": "Tall" }
          ]
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Yellow highlight border",
          "default": false
        }
      ]
    },
    {
      "type": "quote_review",
      "name": "Quote review",
      "limit": 6,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feedback Screenshots",
      "blocks": [
        { "type": "screenshot", "settings": { "row_share": "full", "size": "default" } },
        { "type": "screenshot", "settings": { "row_share": "half", "size": "default" } },
        { "type": "screenshot", "settings": { "row_share": "half", "size": "wide", "highlight": true } },
        { "type": "screenshot", "settings": { "row_share": "full", "size": "default" } },
        { "type": "screenshot", "settings": { "row_share": "half", "size": "default" } },
        { "type": "screenshot", "settings": { "row_share": "half", "size": "default", "highlight": true } }
      ]
    }
  ]
}
{% endschema %}
