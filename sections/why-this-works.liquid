<section class="why-this-works" id="why-this-works-{{ section.id }}">
  <div class="why-this-works__container">
    <p class="why-this-works__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="why-this-works__heading">{{ section.settings.heading | escape }}</h2>
    <div class="why-this-works__subheading rte">{{ section.settings.subheading }}</div>

    {% liquid
      assign left_rows = section.blocks | where: 'type', 'row_other'
      assign right_rows = section.blocks | where: 'type', 'row_this'
    %}

    <div class="why-this-works__card">
      <div class="why-this-works__grid">
        <div class="why-this-works__col why-this-works__col--left">
          {% if section.settings.left_image != blank %}
            {{
              section.settings.left_image
              | image_url: width: 900
              | image_tag:
                class: 'why-this-works__box-image',
                loading: 'lazy',
                alt: 'Other programs'
            }}
          {% endif %}
          <ul class="why-this-works__list">
            {% for row in left_rows %}
              <li class="why-this-works__item">
                <span class="why-this-works__icon" aria-hidden="true">❌</span>
                <span>{{ row.settings.text | escape }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="why-this-works__col why-this-works__col--right">
          {% if section.settings.right_image != blank %}
            {{
              section.settings.right_image
              | image_url: width: 900
              | image_tag:
                class: 'why-this-works__box-image',
                loading: 'lazy',
                alt: 'This program'
            }}
          {% endif %}
          <ul class="why-this-works__list">
            {% for row in right_rows %}
              <li class="why-this-works__item">
                <span class="why-this-works__icon" aria-hidden="true">✅</span>
                <span>{{ row.settings.text | escape }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .why-this-works {
    padding: 40px 16px;
  }

  .why-this-works__container {
    max-width: 782px;
    margin: 0 auto;
    text-align: center;
  }

  .why-this-works__eyebrow {
    margin: 0;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 800;
    line-height: 1.2;
  }

  .why-this-works__heading {
    margin: 8px 0 0;
    text-transform: uppercase;
    color: #0038ff;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-size: clamp(24px, 3.4vw, 40px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .why-this-works__subheading {
    margin: 10px 0 0;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 500;
    line-height: 1.4;
  }

  .why-this-works__subheading p {
    margin: 0;
  }

  .why-this-works__card {
    margin-top: 18px;
    border-radius: 30px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #fff;
    box-shadow: 0 50px 28px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .why-this-works__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .why-this-works__col {
    position: relative;
    padding-top: clamp(140px, 42vw, 260px);
  }

  .why-this-works__col--left {
    background: linear-gradient(180deg, rgba(229, 185, 160, 0.3) 0%, #fff 100%);
  }

  .why-this-works__col--right {
    background: linear-gradient(180deg, rgba(163, 229, 160, 0.3) 0%, #fff 100%);
  }

  .why-this-works__box-image {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(160px, 55%, 360px);
    height: auto;
  }

  .why-this-works__list {
    list-style: none;
    margin: 0;
    padding: 10px 10px 14px;
  }

  .why-this-works__item {
    padding: 12px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: clamp(14px, 1.8vw, 18px);
    line-height: 1.35;
    font-weight: 500;
  }

  .why-this-works__icon {
    font-size: clamp(21px, 2.8vw, 28px);
    line-height: 1;
  }

  @media (min-width: 768px) {
    .why-this-works {
      padding: 64px 32px;
    }

    .why-this-works__item {
      padding: 14px 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why This Works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why most programs fail." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why this one works" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>What is missing from every other hip mobility program.</p>"
    },
    { "type": "image_picker", "id": "left_image", "label": "Left column image" },
    { "type": "image_picker", "id": "right_image", "label": "Right column image" }
  ],
  "blocks": [
    {
      "type": "row_other",
      "name": "Left row (X)",
      "limit": 7,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    },
    {
      "type": "row_this",
      "name": "Right row (Check)",
      "limit": 7,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [
    {
      "name": "Why This Works",
      "blocks": [
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_other" },
        { "type": "row_this" },
        { "type": "row_this" },
        { "type": "row_this" },
        { "type": "row_this" },
        { "type": "row_this" },
        { "type": "row_this" },
        { "type": "row_this" }
      ]
    }
  ]
}
{% endschema %}
