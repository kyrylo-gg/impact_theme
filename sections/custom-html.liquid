{% assign hidden_templates = section.settings.hide_on_pages | downcase | split: ',' %}
{% assign current_template = template.suffix | downcase | strip %}
{% assign is_cart_page = template.name | downcase | strip %}

{% assign hide_section = false %}

{%- comment -%} Hide on body-presale page and cart page {%- endcomment -%}
{% if template.name == 'page' and template.suffix == 'body-presale' %}
  {% assign hide_section = true %}
{% elsif section.settings.hide_on_cart and is_cart_page == 'cart' %}
  {% assign hide_section = true %}
{% endif %}

{%- for t in hidden_templates -%}
  {% assign t_clean = t | downcase | strip | replace: 'page.', '' %}
  {% if t_clean != '' and current_template == t_clean %}
    {% assign hide_section = true %}
  {% endif %}
{%- endfor -%}

{% unless hide_section %}
  {% if section.settings.html != blank %}
    <style>
      #shopify-section-{{ section.id }} {
        {% if section.settings.remove_vertical_spacing %}--section-spacing-block: 0px;{% endif %}
        {% if section.settings.remove_horizontal_spacing %}--section-spacing-inline: 0px;{% endif %}
      }

      {% if section.settings.hide_on_mobile %}
        @media (max-width: 1023px) {
          #shopify-section-{{ section.id }} {
            display: none;
          }
        }
      {% endif %}

      {% if section.settings.hide_on_desktop %}
        @media (min-width: 1024px) {
          #shopify-section-{{ section.id }} {
            display: none;
          }
        }
      {% endif %}
    </style>

    {%- render 'section-spacing-collapsing' -%}

    <div {% render 'section-properties' %}>
      {{ section.settings.html }}
    </div>
  {% endif %}
{% endunless %}


{% schema %}
{
  "name": "Custom HTML",
  "class": "shopify-section--custom-html",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "Remove vertical spacing",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_spacing",
      "label": "Remove horizontal spacing",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "html",
      "id": "html",
      "label": "HTML",
      "default": "<p style=\"text-align: center\">Write or copy/paste HTML code</p>"
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "hide_on_pages",
      "label": "Hide for pages",
      "info": "Use comma-separated values to hide this section on specific templates. Example: thank-you-custom, landing-page"
    },
    {
      "type": "checkbox",
      "id": "hide_on_cart",
      "label": "Hide on cart page",
      "default": false,
      "info": "When enabled, this section is hidden on /cart"
    }
  ],
  "presets": [
    {
      "name": "Custom HTML"
    }
  ]
}
{% endschema %}
