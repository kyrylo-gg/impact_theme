<section class="everything-in-pocket" id="everything-in-pocket-{{ section.id }}">
  <div class="everything-in-pocket__container">
    <div class="everything-in-pocket__mobile-head">
      <h2 class="everything-in-pocket__heading">
        <span class="everything-in-pocket__heading-lead">{{ section.settings.heading_lead | escape }}</span>
        <span class="everything-in-pocket__heading-accent"> {{ section.settings.heading_accent | escape }}</span>
      </h2>
      <div class="everything-in-pocket__body rte">{{ section.settings.body }}</div>
    </div>

    <div class="everything-in-pocket__grid">
      <div class="everything-in-pocket__left">
        <div class="everything-in-pocket__beige-card">
          <div class="everything-in-pocket__spotlight" aria-hidden="true"></div>
        </div>
        {% if section.settings.phone_image != blank %}
          {{
            section.settings.phone_image
            | image_url: width: 800
            | image_tag:
              class: 'everything-in-pocket__phone',
              loading: 'lazy',
              alt: 'App preview'
          }}
        {% endif %}
      </div>

      <div class="everything-in-pocket__right">
        <h2 class="everything-in-pocket__heading everything-in-pocket__heading--desktop">
          <span class="everything-in-pocket__heading-lead">{{ section.settings.heading_lead | escape }}</span>
          <span class="everything-in-pocket__heading-accent"> {{ section.settings.heading_accent | escape }}</span>
        </h2>
        <div class="everything-in-pocket__body everything-in-pocket__body--desktop rte">{{ section.settings.body }}</div>

        <div class="everything-in-pocket__features">
          {% for block in section.blocks %}
            <article class="everything-in-pocket__feature" {{ block.shopify_attributes }}>
              {% if section.settings.checkmark_image != blank %}
                {{
                  section.settings.checkmark_image
                  | image_url: width: 80
                  | image_tag:
                    class: 'everything-in-pocket__feature-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% else %}
                <span class="everything-in-pocket__feature-icon everything-in-pocket__feature-icon--fallback">✓</span>
              {% endif %}
              <p class="everything-in-pocket__feature-label">{{ block.settings.label | newline_to_br }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .everything-in-pocket {
    padding: 40px 16px;
  }

  .everything-in-pocket__container {
    max-width: 1184px;
    margin: 0 auto;
  }

  .everything-in-pocket__heading {
    margin: 0;
    text-transform: uppercase;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-size: 24px;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .everything-in-pocket__heading-lead {
    color: #000;
    font-weight: 600;
  }

  .everything-in-pocket__heading-accent {
    color: #0038ff;
    font-weight: 900;
  }

  .everything-in-pocket__body {
    margin-top: 12px;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
  }

  .everything-in-pocket__body p {
    margin: 0;
  }

  .everything-in-pocket__grid {
    margin-top: 16px;
    display: grid;
    gap: 14px;
  }

  .everything-in-pocket__left {
    position: relative;
  }

  .everything-in-pocket__beige-card {
    height: 287px;
    border-radius: 30px;
    background: #f9eada;
    position: relative;
    overflow: hidden;
  }

  .everything-in-pocket__spotlight {
    position: absolute;
    inset: -35%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .everything-in-pocket__phone {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 184px;
    height: auto;
  }

  .everything-in-pocket__heading--desktop,
  .everything-in-pocket__body--desktop {
    display: none;
  }

  .everything-in-pocket__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .everything-in-pocket__feature {
    min-height: 110px;
    border-radius: 30px;
    background: #f5f5f5;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .everything-in-pocket__feature-icon {
    width: 20px;
    height: 20px;
  }

  .everything-in-pocket__feature-icon--fallback {
    border-radius: 999px;
    background: #000;
    color: #faff00;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
  }

  .everything-in-pocket__feature-label {
    margin: 8px 0 0;
    color: #000;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .everything-in-pocket {
      padding: 64px 32px;
    }

    .everything-in-pocket__mobile-head {
      display: none;
    }

    .everything-in-pocket__grid {
      margin-top: 0;
      grid-template-columns: minmax(0, 562fr) minmax(0, 565fr);
      gap: 20px;
      align-items: center;
    }

    .everything-in-pocket__beige-card {
      height: 429px;
    }

    .everything-in-pocket__phone {
      width: 277px;
    }

    .everything-in-pocket__heading--desktop,
    .everything-in-pocket__body--desktop {
      display: block;
    }

    .everything-in-pocket__heading {
      font-size: clamp(32px, 3.2vw, 40px);
    }

    .everything-in-pocket__body {
      font-size: clamp(18px, 2vw, 24px);
    }

    .everything-in-pocket__features {
      margin-top: 14px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 9px;
    }

    .everything-in-pocket__feature {
      min-height: 126px;
      padding: 20px;
    }

    .everything-in-pocket__feature-label {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Everything In Pocket",
  "settings": [
    { "type": "text", "id": "heading_lead", "label": "Heading lead", "default": "Everything" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "in your pocket." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Your full program is always with you, so you can train from any device without missing a step.</p>"
    },
    { "type": "image_picker", "id": "phone_image", "label": "Phone image" },
    { "type": "image_picker", "id": "checkmark_image", "label": "Checkmark badge image (optional)" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature chip",
      "limit": 3,
      "settings": [{ "type": "text", "id": "label", "label": "Label (use new line)" }]
    }
  ],
  "presets": [
    {
      "name": "Everything In Pocket",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
