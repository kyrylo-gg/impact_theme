<section class="hero-banner-2" id="hero-banner-2-{{ section.id }}">
  <div class="hero-banner-2__container">
    <div class="hero-banner-2__card">
      {% if section.settings.video != blank %}
        {% liquid
          assign hb2_mobile = section.settings.mobile_video
          if hb2_mobile == blank
            assign hb2_mobile = section.settings.video
          endif
        %}
        {{
          section.settings.video
          | video_tag:
            class: 'hero-banner-2__video hero-banner-2__video--desktop',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            preload: 'metadata',
            playsinline: true
        }}
        {{
          hb2_mobile
          | video_tag:
            class: 'hero-banner-2__video hero-banner-2__video--mobile',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            preload: 'metadata',
            playsinline: true
        }}
      {% endif %}

      <div class="hero-banner-2__content">
        {% if section.settings.starburst_image != blank %}
          <div class="hero-banner-2__starburst-wrap">
            {{
              section.settings.starburst_image
              | image_url: width: 220
              | image_tag:
                class: 'hero-banner-2__starburst',
                loading: 'lazy',
                alt: section.settings.starburst_alt | default: 'Join NASS B-Day Sale' | escape
            }}
          </div>
        {% elsif section.settings.use_theme_starburst %}
          <div class="hero-banner-2__starburst-wrap">
            <img
              src="{{ 'nass-bday-starburst-badge.png' | asset_url }}"
              alt="{{ section.settings.starburst_alt | default: 'Join NASS B-Day Sale promotional badge' | escape }}"
              class="hero-banner-2__starburst"
              width="110"
              height="110"
              loading="lazy"
            >
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hero-banner-2__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.price_text != blank %}
          <p class="hero-banner-2__price">{{ section.settings.price_text | escape }}</p>
        {% endif %}

        {% if section.settings.cta_text != blank %}
          <a
            class="hero-banner-2__cta"
            href="{{ section.settings.cta_url | default: '#nass-bundle-builder' }}"
          >
            {{ section.settings.cta_text | escape }}
          </a>
        {% endif %}

        {% if section.settings.deadline_text != blank %}
          <p class="hero-banner-2__deadline">{{ section.settings.deadline_text | escape }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Keep entire section below sticky header (header uses z-index: 10). */
  .shopify-section.hero-banner-2-section-wrapper {
    position: relative;
    z-index: 0;
    isolation: isolate;
  }

  .hero-banner-2 {
    position: relative;
    z-index: 0;
    isolation: isolate;
    width: 100%;
    padding: 32px 16px;
  }

  .hero-banner-2__container {
    max-width: 1184px;
    margin: 0 auto;
  }

  .hero-banner-2__card {
    position: relative;
    height: 560px;
    border-radius: 30px;
    overflow: hidden;
  }

  .hero-banner-2__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-banner-2__video--mobile {
    display: none;
  }

  .hero-banner-2__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
  }

  .hero-banner-2__starburst-wrap {
    margin-top: 28px;
    margin-bottom: auto;
    line-height: 0;
  }

  .hero-banner-2__starburst {
    width: 100px;
    height: 100px;
    object-fit: contain;
  }

  .hero-banner-2__heading {
    margin: 0 0 16px;
    max-width: 787px;
    color: #fff;
    text-transform: uppercase;
    font-family: var(--font-heading--family, 'Anybody'), sans-serif;
    font-weight: 900;
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: 0.84px;
  }

  .hero-banner-2__price {
    margin: 0 0 auto;
    color: #fff;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.48px;
  }

  .hero-banner-2__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    border: none;
    border-radius: 9999px;
    padding: 14px 40px;
    min-height: 48px;
    color: #000;
    text-decoration: none;
    text-transform: none;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.2;
    background: #ffff33;
    box-shadow: none;
    transition: filter 0.2s ease;
  }

  .hero-banner-2__cta:hover {
    filter: brightness(0.95);
  }

  .hero-banner-2__cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .hero-banner-2__deadline {
    margin: 0 0 28px;
    color: #fff;
    font-family: var(--font-body--family, 'Avenir Next'), 'Avenir Next', 'Avenir', 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.42px;
  }

  @media (min-width: 768px) {
    .hero-banner-2 {
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .hero-banner-2__starburst-wrap {
      margin-top: 64px;
    }

    .hero-banner-2__starburst {
      width: 110px;
      height: 110px;
    }

    .hero-banner-2__heading {
      font-size: 48px;
      letter-spacing: 1.44px;
    }

    .hero-banner-2__price {
      font-size: 18px;
      letter-spacing: 0.54px;
    }

    .hero-banner-2__cta {
      padding: 16px 56px;
      min-height: 52px;
      font-size: 18px;
    }

    .hero-banner-2__deadline {
      margin-bottom: 48px;
    }
  }

  @media (max-width: 767px) {
    .hero-banner-2__video--desktop {
      display: none;
    }

    .hero-banner-2__video--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner 2",
  "class": "hero-banner-2-section-wrapper",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video"
    },
    {
      "type": "checkbox",
      "id": "use_theme_starburst",
      "label": "Use theme starburst badge image",
      "default": false,
      "info": "Shows nass-bday-starburst-badge.png. Ignored if Starburst badge image is set."
    },
    {
      "type": "image_picker",
      "id": "starburst_image",
      "label": "Starburst badge image",
      "info": "Optional PNG with text baked in. Overrides theme starburst when set."
    },
    {
      "type": "text",
      "id": "starburst_alt",
      "label": "Starburst image alt text",
      "default": "Join NASS B-Day Sale promotional badge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CELEBRATE YOUR BOOTY PERFECTION"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text",
      "default": "ONLY $97 INSTEAD $456"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Order Twerk Pack"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "deadline_text",
      "label": "Deadline text",
      "default": "Offer ends April 19"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner 2"
    }
  ]
}
{% endschema %}
