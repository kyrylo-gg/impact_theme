{% comment %}
  BT_MeetNastya (Body Transformation)
  Photo gallery carousel: 2 images visible on mobile, 3 on desktop.
  Each block has separate mobile and desktop images.
{% endcomment %}

{%- liquid
  assign title_1 = section.settings.title_1 | default: 'Meet'
  assign title_2 = section.settings.title_2 | default: 'Nastya Nass'
  assign stat_1 = section.settings.stat_1 | default: '6M+ on Instagram'
  assign stat_2 = section.settings.stat_2 | default: '200M+ YouTube views'
  assign bio = section.settings.bio | default: 'Nastya is a famous twerk star and a mom of two. She knows how to get back on track with a system that adapts to real life.'
  assign quote = section.settings.quote | default: 'Between kids and a busy schedule, I needed a plan that adapts. This roadmap helped me keep going when life got messy.'

  assign quote_parts = quote | split: '. '
  assign quote_first = quote_parts[0]
  assign quote_rest = quote_parts | slice: 1, quote_parts.size | join: '. '

  assign avatar = section.settings.avatar
  assign verified_badge = section.settings.verified_badge
  assign person_icon = section.settings.person_icon

  assign photo_count = 0
  for block in section.blocks
    if block.settings.image_mobile != blank or block.settings.image_desktop != blank
      assign photo_count = photo_count | plus: 1
    endif
  endfor
-%}

<section class="bt-wrap bt-meet" data-bt-meet id="bt-meet-{{ section.id }}">
  <div class="bt-container bt-meet__container">
    <div class="bt-meet__title">
      <span class="bt-meet__title-w">{{ title_1 | escape }}</span><br>
      <span class="bt-meet__title-b">{{ title_2 | escape }}</span>
    </div>
    <div class="bt-meet__divider" aria-hidden="true"></div>

    <div class="bt-meet__card">
      {%- if photo_count > 0 -%}
        <div class="bt-meet__gallery" data-bt-meet-gallery>
          <div class="bt-meet__track" data-bt-meet-track role="region" aria-label="Nastya Nass photos">
            {%- for block in section.blocks -%}
              {%- if block.settings.image_mobile != blank or block.settings.image_desktop != blank -%}
                <div class="bt-meet__slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.image_mobile != blank -%}
                    <img
                      class="bt-meet__slide-img bt-meet__slide-img--m"
                      src="{{ block.settings.image_mobile | image_url: width: 600 }}"
                      srcset="{{ block.settings.image_mobile | image_url: width: 400 }} 400w, {{ block.settings.image_mobile | image_url: width: 600 }} 600w"
                      sizes="(min-width: 768px) 33vw, 50vw"
                      alt=""
                      loading="lazy"
                      width="{{ block.settings.image_mobile.width }}"
                      height="{{ block.settings.image_mobile.height }}"
                    >
                  {%- elsif block.settings.image_desktop != blank -%}
                    <img
                      class="bt-meet__slide-img bt-meet__slide-img--m"
                      src="{{ block.settings.image_desktop | image_url: width: 600 }}"
                      alt=""
                      loading="lazy"
                      width="{{ block.settings.image_desktop.width }}"
                      height="{{ block.settings.image_desktop.height }}"
                    >
                  {%- endif -%}
                  {%- if block.settings.image_desktop != blank -%}
                    <img
                      class="bt-meet__slide-img bt-meet__slide-img--d"
                      src="{{ block.settings.image_desktop | image_url: width: 800 }}"
                      srcset="{{ block.settings.image_desktop | image_url: width: 500 }} 500w, {{ block.settings.image_desktop | image_url: width: 800 }} 800w"
                      sizes="(min-width: 768px) 33vw, 50vw"
                      alt=""
                      loading="lazy"
                      width="{{ block.settings.image_desktop.width }}"
                      height="{{ block.settings.image_desktop.height }}"
                    >
                  {%- elsif block.settings.image_mobile != blank -%}
                    <img
                      class="bt-meet__slide-img bt-meet__slide-img--d"
                      src="{{ block.settings.image_mobile | image_url: width: 800 }}"
                      alt=""
                      loading="lazy"
                      width="{{ block.settings.image_mobile.width }}"
                      height="{{ block.settings.image_mobile.height }}"
                    >
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if photo_count > 2 -%}
            <div class="bt-meet__dots" data-bt-meet-dots aria-hidden="true"></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="bt-meet__body">
        <div class="bt-meet__row">
          <div class="bt-meet__avatar-wrap">
            <div class="bt-meet__avatar">
              {%- if avatar != blank -%}
                <img class="bt-meet__avatar-img" src="{{ avatar | image_url: width: 300 }}" alt="" loading="lazy">
              {%- endif -%}
            </div>
            {%- if verified_badge != blank -%}
              <img class="bt-meet__badge" src="{{ verified_badge | image_url: width: 80 }}" alt="" aria-hidden="true" loading="lazy">
            {%- endif -%}
          </div>

          <div class="bt-meet__stats">
            <div class="bt-meet__stat">
              {%- if person_icon != blank -%}<img class="bt-meet__icon" src="{{ person_icon | image_url: width: 40 }}" alt="" aria-hidden="true" loading="lazy">{%- endif -%}
              <span>{{ stat_1 | escape }}</span>
            </div>
            <div class="bt-meet__dot" aria-hidden="true"></div>
            <div class="bt-meet__stat">
              {%- if person_icon != blank -%}<img class="bt-meet__icon" src="{{ person_icon | image_url: width: 40 }}" alt="" aria-hidden="true" loading="lazy">{%- endif -%}
              <span>{{ stat_2 | escape }}</span>
            </div>
          </div>
        </div>

        <p class="bt-meet__bio">{{ bio | escape }}</p>

        <div class="bt-meet__quote">
          <p class="bt-meet__quote-text">
            {%- if quote_rest != blank -%}
              “{{ quote_first | escape }}.<br class="bt-meet__quote-br-d">{{ quote_rest | escape }}”
            {%- else -%}
              “{{ quote | escape }}”
            {%- endif -%}
            <br>
            <span class="bt-meet__quote-name">— Nastya</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var root = document.getElementById('bt-meet-{{ section.id }}');
  if (!root) return;

  var track = root.querySelector('[data-bt-meet-track]');
  var dotsWrap = root.querySelector('[data-bt-meet-dots]');
  if (!track) return;

  var slides = Array.prototype.slice.call(track.querySelectorAll('.bt-meet__slide'));
  if (!slides.length) return;

  var mq = window.matchMedia('(min-width: 768px)');
  var dots = [];

  function visibleCount() {
    return mq.matches ? 3 : 2;
  }

  function pageCount() {
    var visible = visibleCount();
    return Math.max(1, slides.length - visible + 1);
  }

  function stepSize() {
    var slide = slides[0];
    if (!slide) return 0;
    var gap = parseFloat(getComputedStyle(track).gap) || 0;
    return slide.getBoundingClientRect().width + gap;
  }

  function buildDots() {
    if (!dotsWrap) return;
    dotsWrap.innerHTML = '';
    dots = [];
    var count = pageCount();
    if (count <= 1) {
      dotsWrap.style.display = 'none';
      return;
    }
    dotsWrap.style.display = '';
    for (var i = 0; i < count; i++) {
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'bt-meet__dot-btn' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Photo page ' + (i + 1));
      dot.addEventListener('click', function(idx) {
        return function() {
          track.scrollTo({ left: idx * stepSize(), behavior: 'smooth' });
        };
      }(i));
      dotsWrap.appendChild(dot);
      dots.push(dot);
    }
  }

  function setActiveDot(index) {
    dots.forEach(function(dot, idx) {
      dot.classList.toggle('is-active', idx === index);
    });
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function() {
      ticking = false;
      var step = stepSize();
      if (!step) return;
      var idx = Math.round(track.scrollLeft / step);
      idx = Math.max(0, Math.min(idx, pageCount() - 1));
      setActiveDot(idx);
    });
  }

  track.addEventListener('scroll', onScroll, { passive: true });

  function onResize() {
    buildDots();
    onScroll();
  }

  if (typeof mq.addEventListener === 'function') {
    mq.addEventListener('change', onResize);
  } else if (typeof mq.addListener === 'function') {
    mq.addListener(onResize);
  }

  buildDots();
})();
</script>

{% stylesheet %}
  .bt-wrap { width: 100%; display: flex; justify-content: center; padding: 24px 16px; box-sizing: border-box; }
  @media (min-width: 768px) { .bt-wrap { padding: 40px 0; } }
  .bt-container { width: 100%; max-width: 335px; }
  @media (min-width: 768px) { .bt-container { max-width: 1063px; } }

  .bt-meet__title { margin: 0; text-align: center; font-family: 'Anybody', sans-serif; font-weight: 600; text-transform: uppercase; font-stretch: 150%; letter-spacing: 0.03em; font-size: 24px; line-height: 1.05; color: #111; }
  @media (min-width: 768px) { .bt-meet__title { font-size: 45px; } }
  .bt-meet__title-b { color: #0038FF; font-weight: 900; }
  .bt-meet__divider { width: 48px; height: 3px; background: #0038FF; margin: 12px auto 0; }
  @media (min-width: 768px) { .bt-meet__divider { margin-top: 16px; } }

  .bt-meet__card { margin-top: 24px; background: #fff; border-radius: 30px; box-shadow: 0 6px 28px rgba(0,0,0,0.15); overflow: hidden; }
  @media (min-width: 768px) { .bt-meet__card { margin-top: 40px; border: 1px solid #F4F4F4; max-width: 782px; margin-left: auto; margin-right: auto; } }

  .bt-meet__gallery { margin: 8px 8px 0; }
  @media (min-width: 768px) { .bt-meet__gallery { margin: 12px 12px 0; } }

  .bt-meet__track {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .bt-meet__track::-webkit-scrollbar { display: none; }

  .bt-meet__slide {
    flex: 0 0 calc((100% - 8px) / 2);
    scroll-snap-align: start;
    border-radius: 22px;
    overflow: hidden;
    background: #111;
  }
  @media (min-width: 768px) {
    .bt-meet__slide {
      flex: 0 0 calc((100% - 16px) / 3);
      border-radius: 26px;
    }
  }

  .bt-meet__slide-img {
    width: 100%;
    height: 275px;
    object-fit: cover;
    display: none;
  }
  .bt-meet__slide-img--m { display: block; }
  @media (min-width: 768px) {
    .bt-meet__slide-img--m { display: none; }
    .bt-meet__slide-img--d { display: block; height: 390px; }
  }

  .bt-meet__dots {
    margin-top: 12px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  @media (min-width: 768px) { .bt-meet__dots { margin-top: 16px; } }

  .bt-meet__dot-btn {
    height: 2px;
    width: 20px;
    padding: 0;
    border: 0;
    background: rgba(138,138,138,0.4);
    border-radius: 999px;
    cursor: pointer;
    transition: width 150ms ease, background 150ms ease;
  }
  @media (min-width: 768px) { .bt-meet__dot-btn { height: 3px; width: 28px; } }
  .bt-meet__dot-btn.is-active { width: 40px; background: #8A8A8A; }
  @media (min-width: 768px) { .bt-meet__dot-btn.is-active { width: 50px; } }

  .bt-meet__body { padding: 0 20px 20px; margin-top: -24px; position: relative; text-align: left; }
  @media (min-width: 768px) { .bt-meet__body { padding: 0 28px 28px; margin-top: -40px; } }

  .bt-meet__row { display: flex; align-items: center; justify-content: flex-start; gap: 12px; }
  @media (min-width: 768px) { .bt-meet__row { gap: 16px; align-items: flex-end; } }

  .bt-meet__avatar-wrap { position: relative; flex-shrink: 0; width: 84px; height: 84px; }
  @media (min-width: 768px) { .bt-meet__avatar-wrap { width: 115px; height: 115px; transform: translateY(-28px); } }

  .bt-meet__avatar { width: 100%; height: 100%; border-radius: 999px; border: 3px solid #fff; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.15); background: #fff; }
  .bt-meet__avatar-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bt-meet__badge { position: absolute; right: -2px; bottom: -2px; width: 20px; height: 20px; z-index: 3; }
  @media (min-width: 768px) { .bt-meet__badge { right: -4px; bottom: -4px; width: 30px; height: 30px; } }

  .bt-meet__stats { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; row-gap: 4px; column-gap: 0; padding-bottom: 4px; transform: translateY(18px); }
  @media (min-width: 768px) { .bt-meet__stats { flex-wrap: nowrap; transform: translateY(-18px); } }
  .bt-meet__stat { display: inline-flex; align-items: center; gap: 8px; font-family: Avenir, 'Nunito Sans', system-ui, sans-serif; font-weight: 500; color: #111; font-size: 16px; }
  @media (min-width: 768px) { .bt-meet__stat { font-size: 21px; } }
  .bt-meet__icon { width: 12px; height: 12px; }
  @media (min-width: 768px) { .bt-meet__icon { width: 17px; height: 17px; } }
  .bt-meet__dot { display: none; width: 4px; height: 4px; background: #111; border-radius: 999px; margin: 0 16px; }
  @media (min-width: 768px) { .bt-meet__dot { display: block; } }

  .bt-meet__bio { margin: 16px 0 0; font-family: Avenir, 'Nunito Sans', system-ui, sans-serif; font-weight: 500; font-size: 14px; color: #8A8A8A; line-height: 1.55; max-width: 640px; }
  @media (min-width: 768px) { .bt-meet__bio { margin-top: 24px; font-size: 18px; } }

  .bt-meet__quote { margin-top: 16px; border-radius: 10px; border: 1px solid rgba(0,0,0,0.06); padding: 12px; }
  @media (min-width: 768px) { .bt-meet__quote { margin-top: 20px; padding: 16px; } }
  .bt-meet__quote-text { margin: 0; font-family: Avenir, 'Nunito Sans', system-ui, sans-serif; font-weight: 500; font-size: 14px; color: #111; font-style: italic; line-height: 1.4; }
  @media (min-width: 768px) { .bt-meet__quote-text { font-size: 18px; } }
  .bt-meet__quote-br-d { display: none; }
  @media (min-width: 768px) { .bt-meet__quote-br-d { display: inline; } }
  .bt-meet__quote-name { font-style: normal; font-weight: 800; }
{% endstylesheet %}

{% schema %}
{
  "name": "BT_MeetNastya",
  "class": "shopify-section--bt-meet-nastya",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Title line 1", "default": "Meet" },
    { "type": "text", "id": "title_2", "label": "Title line 2 (blue)", "default": "Nastya Nass" },
    { "type": "header", "content": "Profile images" },
    { "type": "image_picker", "id": "avatar", "label": "Avatar" },
    { "type": "image_picker", "id": "verified_badge", "label": "Verified badge" },
    { "type": "image_picker", "id": "person_icon", "label": "Person icon" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "stat_1", "label": "Stat 1", "default": "6M+ on Instagram" },
    { "type": "text", "id": "stat_2", "label": "Stat 2", "default": "200M+ YouTube views" },
    { "type": "text", "id": "bio", "label": "Bio", "default": "Nastya is a famous twerk star and a mom of two. She knows how to get back on track with a system that adapts to real life." },
    { "type": "text", "id": "quote", "label": "Quote", "default": "Between kids and a busy schedule, I needed a plan that adapts. This roadmap helped me keep going when life got messy." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Gallery photo",
      "settings": [
        { "type": "image_picker", "id": "image_mobile", "label": "Photo mobile" },
        { "type": "image_picker", "id": "image_desktop", "label": "Photo desktop" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BT_MeetNastya",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
