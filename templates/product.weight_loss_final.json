        "item_9pxiP4": {
          "type": "item",
          "settings": {
            "title": "How soon can I expect to see results?",
            "content": "<p>\"Noticeable changes can be seen in just 4 weeks with a commitment to the recommended training schedule of at least 3 times a week.\"</p>"
          }
        },
        "item_yTgMeY": {
          "type": "item",
          "settings": {
            "title": "Can beginners do these programs?",
            "content": "<p>Absolutely! The program's difficulty progresses gradually, allowing you to adapt and master new moves comfortably.</p>"
          }
        },
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-3": {
          "type": "item",
          "settings": {
            "title": "Can I complete the workouts at my own pace?",
            "content": "<p>Of course! You can complete the workouts at your own pace. This course does not have a strict schedule.</p>"
          }
        },
