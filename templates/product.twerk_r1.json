    "29817d12-4af7-49ab-8a92-c41c03e71d08": {
      "type": "faq",
      "blocks": {
        "item_M9XXMn": {
          "type": "item",
          "settings": {
            "title": "What does lifetime access to the courses mean?",
            "content": "<p>When you enroll in our online fitness courses, you gain lifetime access to all course materials, including videos, resources, and updates. This means you can learn at your own pace and revisit the content whenever you need a refresher or want to enhance your skills. Your access doesn’t expire, allowing you to stay motivated and engaged in your fitness journey for years to come!</p>"
          }
        },
        "item_JTgR4Y": {
          "type": "item",
          "settings": {
            "title": "What is your 30-day money-back guarantee?",
            "content": "<p>We stand behind the quality of our online fitness courses, which is why we offer a 30-day money-back guarantee. If you’re not completely satisfied with your purchase within the first 30 days, simply reach out to our support team for a full refund—no questions asked. Your fitness journey is our priority, and we want you to feel confident in your decision to join us!<br/>Please note: we can cannot refund the course in case you completed more than 50% of the program.</p>"
          }
        },
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-1": {
          "type": "item",
          "settings": {
            "title": "How do I access the program?",
            "content": "<p>We will add the courses to your nasswear.com profile, so all you will need to do is to log into your account!<br/></p>"
          }
        },
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-3": {
          "type": "item",
          "settings": {
            "title": "Can I complete the workouts at my own pace?",
            "content": "<p>Of course! You can complete the workouts at your own pace. This course does not have a strict schedule.</p>"
          }
        },
        "3cf54b69-9b9b-430a-a979-af74f7e91024": {
          "type": "item",
          "settings": {
            "title": "How long are the workouts?",
            "content": "<p>Each workout is 40-60 minutes.</p>"
          }
        },
        "7e2f2941-628e-4960-a9bd-a5824e332a2c": {
          "type": "item",
          "settings": {
            "title": "Am I able to download the workout sessions on my device?",
            "content": "<p>At the moment all the content in Twerk Program is available online only.</p>"
          }
        }
      },
