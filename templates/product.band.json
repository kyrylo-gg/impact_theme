        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-1": {
          "type": "item",
          "settings": {
            "title": "How can I access the programs?",
            "content": "<p>Simply download the app from <a href=\"https://apps.apple.com/us/app/nass-fit/id6499145346\" target=\"_blank\" title=\"https://apps.apple.com/us/app/nass-fit/id6499145346\">App Store</a> or <a href=\"https://play.google.com/store/apps/details?id=com.fitnass.app\" target=\"_blank\" title=\"https://play.google.com/store/apps/details?id=com.fitnass.app\">Play Market </a>to access the program<br/><br/>Once on the welcome screen, select:\"Email+Password\" option, use email associated with your order and create a password to activate your account.<br/><br/>You may also access the program via web version at https://account.nasswear.com</p>"
          }
        },
        "item_9pxiP4": {
          "type": "item",
          "settings": {
            "title": "How soon can I expect to see results?",
            "content": "<p>\"Noticeable changes can be seen in just 4 weeks with a commitment to the recommended training schedule of at least 3 times a week.\"</p>"
