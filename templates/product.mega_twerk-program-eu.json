    "29817d12-4af7-49ab-8a92-c41c03e71d08": {
      "type": "faq",
      "blocks": {
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-1": {
          "type": "item",
          "settings": {
            "title": "How do I access the programs?",
            "content": "<p>We will email your login details after the purchase. In case you have not received an email with login details please contact us so we can resend them!</p>"
          }
        },
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-2": {
          "type": "item",
          "settings": {
            "title": "Do you limit access to your courses after a specific time?",
            "content": "<p>Our programs do not have an expiration date, so you will be able to access the course anytime after the purchase!</p>"
          }
        },
        "template--14907164164170__29817d12-4af7-49ab-8a92-c41c03e71d08-item-3": {
          "type": "item",
          "settings": {
            "title": "Can I complete the workouts at my own pace?",
            "content": "<p>Of course! You can complete the workouts at your own pace. This course does not have a strict schedule.</p>"
          }
        },
        "3cf54b69-9b9b-430a-a979-af74f7e91024": {
          "type": "item",
          "settings": {
            "title": "How long are the workouts?",
            "content": "<p>Each workout is 40-60 minutes.</p>"
          }
        },
        "7e2f2941-628e-4960-a9bd-a5824e332a2c": {
          "type": "item",
          "settings": {
            "title": "Am I able to download the workout sessions on my device?",
            "content": "<p>At the moment all the content in Twerk Program is available online only.</p>"
          }
        }
      },
