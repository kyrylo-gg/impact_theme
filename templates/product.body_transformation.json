        "faq_eJah3t": {
          "type": "faq",
          "settings": {
            "question": "Is this program good for women 35+ / 40+ / 50+?",
            "answer": "Yes. This program is great for women 35+, 40+, and 50+. It ensures safety through gradual progression (starting easy to let the body adapt) and readiness test (you must pass a test to advance), which minimizes the risk of injury."
          }
        },
        "faq_LLx6ba": {
          "type": "faq",
          "settings": {
            "question": "Do I have to do jumping or HIIT?",
            "answer": "No. You don’t have to do jumping or intense HIIT at the start. The program uses a step-by-step interval structure for safe adaptation:\n\nSoft Level: No jumping. Focuses on technique and gentle conditioning.\n\nBasic Level: Slightly higher intensity, but still manageable and jump-free.\n\nHard Level: Introduces jumping and high-intensity HIIT only when your body is fully prepared."
          }
        },
        "faq_keYwNN": {
          "type": "faq",
          "settings": {
            "question": "What if I have low-energy days or PMS?",
            "answer": "Yes. The program is specifically designed for women, accommodating daily energy and hormonal shifts:\n\nFlow training: Gentle, low-impact workouts you can switch to on low-energy days.\n\nHormonal guidance: Educational insights on the menstrual cycle, perimenopause, and menopause.\n\nThis helps you understand your body and adjust your workouts safely and comfortably."
          }
        },
        "faq_EktWxU": {
          "type": "faq",
          "settings": {
            "question": "What if I'm a complete beginner?",
            "answer": "Yes. The program is perfect for complete beginners, following a strict gradual progression from Soft to Hard levels."
          }
        },
        "faq_BgMzTi": {
          "type": "faq",
          "settings": {
            "question": "How many days per week is it?",
            "answer": "The weekly structure is simple - 3 mandatory workouts and optional stretching or meditation for recovery and well-being."
