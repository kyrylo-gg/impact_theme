    <script>
      (function() {
        function initHipsABundleOpen() {
          if (!document.body || !(document.body.classList.contains('product--hips_a') || document.body.classList.contains('product--hips_a_eu') || document.body.classList.contains('product--hips_a_ab') || document.body.classList.contains('product--hips_a_ceo') || document.body.classList.contains('product--hips_b') || document.body.classList.contains('product--hips_c'))) return;

          /* hips_a: normalize CTA anchors to Complete System section */
          document.querySelectorAll('.hips-hero-banner__cta, .body-ready-cta__button').forEach(function(link) {
            link.setAttribute('href', '#complete-system');
          });

          function tryOpenBundleWizard(maxRetries) {
            maxRetries = typeof maxRetries === 'number' ? maxRetries : 20;
            var retries = 0;
            function tick() {
              var bb = (window.NassBundleBuilder && typeof window.NassBundleBuilder.openWizard === 'function')
                ? window.NassBundleBuilder
                : null;
              if (bb) {
                bb.openWizard();
                return;
              }
              if (retries >= maxRetries) {
                window.location.hash = '#nass-bundle-builder';
                return;
              }
              retries += 1;
              window.location.hash = '#nass-bundle-builder';
              setTimeout(tick, 100);
            }
            tick();
          }

          document.addEventListener('click', function(e) {
            var trigger = e.target.closest('.complete-system__cta');
            if (!trigger) return;
            e.preventDefault();
            var shouldPreselectFirst = document.body.classList.contains('product--hips_b');
            window.__bt_bb_preselect_first = shouldPreselectFirst;
            tryOpenBundleWizard(25);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initHipsABundleOpen);
        } else {
          initHipsABundleOpen();
        }
      })();
    </script>
