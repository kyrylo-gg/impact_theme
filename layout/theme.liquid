          }
        }
      </style>
      <script>
        (function() {
          if (!document.body || !/product--pop_booty/.test(document.body.className)) return;

          var anchorTargets = {
            'booty-workouts': '#booty-workouts-cta',
            'booty-workouts-cta': '#booty-workouts-cta',
            'booty-workouts-repeat': '#booty-workouts-repeat-cta',
            'booty-workouts-repeat-cta': '#booty-workouts-repeat-cta'
          };

          var anchorRoleFallback = {
            'booty-workouts': 'hero',
            'booty-workouts-repeat': 'repeat'
          };

          function scrollToBootyAnchor(hash) {
            var selector = anchorTargets[hash];
            if (!selector) return false;

            var target = document.querySelector(selector);
            if (!target) {
              var role = anchorRoleFallback[hash];
              if (!role) return false;
              var section = document.querySelector('[data-booty-workouts-role="' + role + '"]');
              target = section && section.querySelector('.booty-workouts__cta');
            }
            if (!target) return false;

            target.scrollIntoView({ block: 'center', behavior: 'smooth' });
            return true;
          }

          document.addEventListener('click', function(event) {
            var link = event.target.closest('a[href*="#"]');
            if (!link || event.defaultPrevented) return;

            var url;
            try {
              url = new URL(link.href, window.location.origin);
            } catch (error) {
              return;
            }

            if (url.pathname !== window.location.pathname || url.search !== window.location.search) return;

            var hash = url.hash.replace(/^#/, '');
            if (!anchorTargets[hash]) return;
            if (!scrollToBootyAnchor(hash)) return;

            event.preventDefault();
            event.stopImmediatePropagation();

            if (window.history && window.history.replaceState) {
              window.history.replaceState(null, '', '#' + hash);
            }
          }, true);

          window.addEventListener('load', function() {
            var hash = window.location.hash.replace(/^#/, '');
            if (!anchorTargets[hash]) return;
            scrollToBootyAnchor(hash);
          });
        })();
      </script>
