{%- doc -%}
  Renders a product card for the Bundle Builder wizard.
  Used with Liquid-rendered products from collection.

  @param {object} product - The product object
  @param {string} step_id - Step identifier for JS (e.g. programs, shorts)
  @param {boolean} [is_featured] - If true, adds featured product ring (4 Programs Bundle)
  @param {object} [size_chart_page] - Optional Shopify page for size chart
{%- enddoc -%}

{% liquid
  assign step_id = step_id | default: 'products'
  assign img_src = product.featured_image | image_url: width: 500
  assign img_srcset = product.featured_image | image_url: width: 200 | append: ' 200w, ' | append: product.featured_image | image_url: width: 300 | append: ' 300w, ' | append: product.featured_image | image_url: width: 500 | append: ' 500w'
  assign first_variant = product.selected_or_first_available_variant
  assign size_chart_page = size_chart_page | default: product.metafields.info.size_chart
  assign has_size_option = false
-%}
{% for opt in product.options_with_values %}
  {% if opt.name == 'Size' %}
    {% assign has_size_option = true %}
  {% endif %}
{% endfor %}
{% capture images_json %}
  [{% for img in product.images limit: 10 %}"{{ img | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
{% endcapture %}

{% capture variants_json %}
  [
    {% for v in product.variants %}
      {
        "id": {{ v.id }},
        "priceCents": {{ v.price }},
        "currency": {{ cart.currency.iso_code | default: shop.currency | default: 'USD' | json }},
        "title": {{ v.title | json }},
        "available": {{ v.available | json }},
        "options": [{% for opt in v.options %}{{ opt | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
{% endcapture %}

<div
  class="bsp__card"
  data-product-id="{{ product.id }}"
  data-step-id="{{ step_id }}"
  data-variants="{{ variants_json | strip | escape }}"
  data-images="{{ images_json | strip | escape }}"
  data-product-title="{{ product.title | escape }}"
  {% if is_featured %}data-featured="true"{% endif %}
>
  <div class="bsp__card-image" data-action="open-image-viewer">
    <img
      class="bsp__card-img bsp__card-img--loaded"
      src="{{ img_src }}"
      srcset="{{ img_srcset }}"
      sizes="(max-width: 768px) 208px, 240px"
      alt="{{ product.title | escape }}"
      width="500"
      height="667"
      loading="lazy"
      decoding="async"
    />
    <div class="bsp__card-badges" data-bind="badges"></div>
    {% if is_featured %}
      <div class="bsp__card-featured">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Most Popular
      </div>
    {% endif %}
    <button type="button" class="bsp__card-zoom" data-action="open-image-viewer" aria-label="View full size">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </button>
    <div class="bsp__card-title-overlay">
      <h3 class="bsp__card-title">{{ product.title | escape }}</h3>
    </div>
  </div>

  <div class="bsp__card-actions">
    <button type="button" class="bsp__add-btn" data-action="add-product">
      <div class="bsp__add-btn-info">
        <p class="bsp__add-btn-label">Add for</p>
        <div class="bsp__add-btn-prices">
          <span class="bsp__price-original" data-bind="original" hidden></span>
          <span class="bsp__price-final" data-bind="final">{{ first_variant.price | money }}</span>
          <span class="bsp__price-badge" data-bind="badge" hidden></span>
        </div>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
    </button>
    <div class="bsp__card-actions--selected" hidden>
      <button type="button" class="bsp__added-btn" disabled>
        <div class="bsp__add-btn-info">
          <p class="bsp__add-btn-label bsp__add-btn-label--white">Added for</p>
          <div class="bsp__add-btn-prices">
            <span class="bsp__price-original bsp__price-original--white" data-bind="original"></span>
            <span class="bsp__price-final bsp__price-final--white" data-bind="final"></span>
            <span class="bsp__price-badge bsp__price-badge--white" data-bind="badge"></span>
          </div>
        </div>
      </button>
      <button type="button" class="bsp__remove-btn" data-action="remove-product">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
      </button>
    </div>
  </div>
  {% if has_size_option and size_chart_page != blank and pages[size_chart_page] != blank %}
    <div class="bsp__card-size-link">
      <a href="{{ pages[size_chart_page].url }}" class="bsp__size-guide-link" target="_blank" rel="noopener">Size guide</a>
    </div>
  {% endif %}
</div>
