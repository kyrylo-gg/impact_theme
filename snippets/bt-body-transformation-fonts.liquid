{% comment %}
  Body Transformation landing: Anybody (wdth+wght variable) + Nunito Sans after Avenir for Windows/Linux.
  Matches Lovable TZ: @import equivalent via link; font-stretch 150% needs full Anybody axis URL.
{% endcomment %}
{% # theme-check-disable AssetUrlFilters, RemoteAsset %}
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="preload"
  href="https://fonts.googleapis.com/css2?family=Anybody:ital,wdth,wght@0,75..150,100..900;1,75..150,100..900&family=Nunito+Sans:ital,wght@0,500;0,800;1,500&display=swap"
  as="style"
>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Anybody:ital,wdth,wght@0,75..150,100..900;1,75..150,100..900&family=Nunito+Sans:ital,wght@0,500;0,800;1,500&display=swap"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Anybody:ital,wdth,wght@0,75..150,100..900;1,75..150,100..900&family=Nunito+Sans:ital,wght@0,500;0,800;1,500&display=swap"
  >
</noscript>
{% # theme-check-enable AssetUrlFilters, RemoteAsset %}
